<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CONM Student Grades Viewer</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">
    
    <!-- HEADER -->
    <header class="bg-pink-700 text-white shadow-md border-b-4 border-emerald-500">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div>
                <h2 class="text-base font-bold">College of Nursing and School of Midwifery</h2>
                <p class="text-xs text-emerald-200">Student Portal</p>
            </div>
            <div class="flex items-center space-x-3">
                <span class="text-xs bg-pink-800 px-3 py-1.5 rounded-full text-pink-100 font-medium">
                    <%= currentUser.fullName %>
                </span>
                <a href="/change-password" class="text-xs bg-slate-700 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">Change Password</a>
                <form action="/logout" method="POST" class="inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="text-xs bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded font-medium cursor-pointer">Log Out</button>
                </form>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-5xl w-full mx-auto p-4 sm:p-6 space-y-6">

        <!-- YEAR AND SEMESTER SELECTOR FOR VIEWING PAST GRADES -->
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex justify-center items-center">
            <form id="semesterFilterForm" method="GET" action="/portal" class="flex flex-col sm:flex-row items-center gap-3">
                <label class="text-xs font-bold uppercase text-slate-500">View Grades For:</label>
                
                <% 
                    let viewYear = '2';
                    let viewSem = '1';
                    if (currentTerm) {
                        viewYear = Math.ceil(parseInt(currentTerm) / 2).toString();
                        viewSem = (parseInt(currentTerm) % 2 === 0 ? 2 : 1).toString();
                    }
                %>
                
                <div class="flex gap-2">
                    <select id="portal_year_select" class="px-3 py-2 rounded-lg border border-slate-300 text-sm bg-slate-50 font-medium focus:ring-2 focus:ring-pink-500 cursor-pointer">
                        <option value="1" <%= viewYear === '1' ? 'selected' : '' %>>BSN1</option>
                        <option value="2" <%= viewYear === '2' ? 'selected' : '' %>>BSN2</option>
                        <option value="3" <%= viewYear === '3' ? 'selected' : '' %>>BSN3</option>
                        <option value="4" <%= viewYear === '4' ? 'selected' : '' %>>BSN4</option>
                    </select>

                    <select id="portal_sem_select" class="px-3 py-2 rounded-lg border border-slate-300 text-sm bg-slate-50 font-medium focus:ring-2 focus:ring-pink-500 cursor-pointer">
                        <option value="1" <%= viewSem === '1' ? 'selected' : '' %>>1st Semester</option>
                        <option value="2" <%= viewSem === '2' ? 'selected' : '' %>>2nd Semester</option>
                    </select>
                </div>
                
                <input type="hidden" name="term" id="portal_term_hidden" value="<%= currentTerm %>">
            </form>
        </div>

        <!-- GRADES VIEW AREA -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8">
            
            <% 
                const yearNum = studentRecord.year_level || '1';
                const studentSection = studentRecord.section || 'A';
                const yearSectionLabel = `BSN${yearNum} - ${studentSection}`;
            %>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8 text-sm">
                <div class="text-left space-y-4">
                    <p>
                       <span class="font-bold uppercase text-[10px] text-slate-500">Student Name:</span> <br> 
                       <span class="font-bold text-base uppercase"><%= studentRecord.last_name ? `${studentRecord.last_name}, ${studentRecord.first_name} ${studentRecord.middle_name || ''}` : studentRecord.first_name %></span>
                    </p>
                    <p>
                       <span class="font-bold uppercase text-[10px] text-slate-500">Student Number:</span> <br> 
                       <span class="font-mono font-bold text-base"><%= studentRecord.student_id %></span>
                    </p>
                </div>
                
                <div class="text-left sm:text-center space-y-4 border-t sm:border-t-0 sm:border-l border-slate-200 pt-4 sm:pt-0 sm:pl-6">
                    <p>
                       <span class="font-bold uppercase text-[10px] text-slate-500">Program:</span> <br> 
                       <span class="font-medium"><%= studentRecord.program %></span>
                    </p>
                    <p>
                       <span class="font-bold uppercase text-[10px] text-slate-500">Year & Section:</span> <br> 
                       <span class="font-bold text-emerald-900"><%= yearSectionLabel %></span>
                    </p>
                </div>

                <div class="text-left sm:text-right space-y-4 border-t sm:border-t-0 sm:border-l border-slate-200 pt-4 sm:pt-0 sm:pl-6">
                    <p>
                       <span class="font-bold uppercase text-[10px] text-slate-500">Term Status:</span> <br> 
                       <% if (isOfficiallyEnrolled) { %>
                           <span class="inline-block px-3 py-1.5 mt-1 bg-emerald-100 text-emerald-800 font-bold text-[10px] uppercase tracking-wider rounded-full shadow-sm border border-emerald-300">✅ Officially Enrolled</span>
                       <% } else { %>
                           <span class="inline-block px-3 py-1.5 mt-1 bg-slate-100 text-slate-600 font-bold text-[10px] uppercase tracking-wider rounded-full shadow-sm border border-slate-300">Not Enrolled</span>
                       <% } %>
                    </p>
                    <p>
                       <span class="font-bold uppercase text-[10px] text-slate-500">Academic Term:</span> <br> 
                       <span class="font-medium text-slate-700">
                           <%= systemSettings.current_semester === 1 ? 'First Semester' : 'Second Semester' %>, A.Y. <%= systemSettings.current_ay %>
                       </span>
                    </p>
                </div>
            </div>

            <!-- Grades Table -->
            <% if (grades.length === 0) { %>
                <div class="text-center py-12 text-slate-400 border-t border-slate-200">
                    <p class="text-sm">No subjects enrolled or grades recorded for this selected semester.</p>
                </div>
            <% } else { %>
                <div class="overflow-hidden border border-slate-400 rounded-lg">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-slate-100 border-b border-slate-400">
                                <th class="p-2 sm:p-3 font-bold uppercase text-[10px] tracking-wider border-r border-slate-400">Course Code</th>
                                <th class="p-2 sm:p-3 font-bold uppercase text-[10px] tracking-wider border-r border-slate-400">Descriptive Title</th>
                                <th class="p-2 sm:p-3 font-bold uppercase text-[10px] tracking-wider border-r border-slate-400 text-center">Units</th>
                                <th class="p-2 sm:p-3 font-bold uppercase text-[10px] tracking-wider border-r border-slate-400 text-center">Final Grade</th>
                                <th class="p-2 sm:p-3 font-bold uppercase text-[10px] tracking-wider text-center">Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% grades.forEach(g => { %>
                                <tr class="border-b border-slate-300 last:border-0">
                                    <td class="p-2 sm:p-3 font-mono font-bold border-r border-slate-400 whitespace-nowrap"><%= g.course_code %></td>
                                    <td class="p-2 sm:p-3 font-medium border-r border-slate-400"><%= g.descriptive_title %></td>
                                    <td class="p-2 sm:p-3 text-center border-r border-slate-400"><%= g.total_units %></td>
                                    <td class="p-2 sm:p-3 text-center font-bold border-r border-slate-400"><%= g.final_grade || '---' %></td>
                                    <td class="p-2 sm:p-3 text-center text-xs font-bold uppercase <%= g.remarks === 'PASSED' ? 'text-emerald-600' : (g.remarks === 'FAILED' ? 'text-red-600' : '') %>">
                                        <%= g.remarks || '---' %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>

        </div>
    </main>

    <script nonce="<%= cspNonce %>">
        document.addEventListener('DOMContentLoaded', () => {
            const portalYear = document.getElementById('portal_year_select');
            const portalSem = document.getElementById('portal_sem_select');
            const termHidden = document.getElementById('portal_term_hidden');
            const filterForm = document.getElementById('semesterFilterForm');

            if (portalYear && portalSem && termHidden && filterForm) {
                const submitFilter = () => {
                    const y = parseInt(portalYear.value, 10);
                    const s = parseInt(portalSem.value, 10);
                    termHidden.value = (y - 1) * 2 + s;
                    filterForm.submit();
                };

                portalYear.addEventListener('change', submitFilter);
                portalSem.addEventListener('change', submitFilter);
            }
        });
    </script>
</body>
</html>