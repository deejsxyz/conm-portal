<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CONM Student Portal - Certificate of Grades</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Styles applied only when printing */
        @media print {
            body { background-color: white !important; }
            .no-print { display: none !important; }
            .print-border { border: 1px solid #000 !important; }
            .print-text-black { color: #000 !important; }
            
            /* Force the browser to print the green text colors and background graphics */
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
        }
        
        /* Official dark green color matching the reference */
        .text-official-green {
            color: #1b5e20 !important; /* Forest Green */
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">
    
    <!-- HEADER (Hidden during Print) -->
    <header class="bg-pink-700 text-white shadow-md border-b-4 border-emerald-500 no-print">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div>
                <h2 class="text-base font-bold">City University of Pasay - Student Portal</h2>
                <p class="text-xs text-pink-200">College of Nursing and School of Midwifery (CONM)</p>
            </div>
            <div class="flex items-center space-x-3">
                <span class="text-xs bg-pink-800 px-3 py-1.5 rounded-full text-pink-100 font-medium">
                    <%= currentUser.fullName %> (STUDENT)
                </span>
                <a href="/change-password" class="text-xs bg-slate-700 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">Change Password</a>
                <a href="/logout" class="text-xs bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded font-medium">Log Out</a>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-5xl w-full mx-auto p-4 sm:p-6 space-y-6">

        <!-- TERM SELECTOR & PRINT BUTTON (Hidden during Print) -->
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex flex-col sm:flex-row justify-between items-center gap-4 no-print">
            <form method="GET" action="/portal" class="flex items-center gap-3">
                <label class="text-xs font-bold uppercase text-slate-500">View Grades for Term:</label>
                <select name="term" onchange="this.form.submit()" class="px-3 py-2 rounded-lg border border-slate-300 text-sm bg-slate-50 font-medium focus:ring-2 focus:ring-pink-500">
                    <option value="1" <%= currentTerm === '1' ? 'selected' : '' %>>1st Year - 1st Sem</option>
                    <option value="2" <%= currentTerm === '2' ? 'selected' : '' %>>1st Year - 2nd Sem</option>
                    <option value="3" <%= currentTerm === '3' ? 'selected' : '' %>>2nd Year - 1st Sem</option>
                    <option value="4" <%= currentTerm === '4' ? 'selected' : '' %>>2nd Year - 2nd Sem</option>
                    <option value="5" <%= currentTerm === '5' ? 'selected' : '' %>>3rd Year - 1st Sem</option>
                    <option value="6" <%= currentTerm === '6' ? 'selected' : '' %>>3rd Year - 2nd Sem</option>
                    <option value="7" <%= currentTerm === '7' ? 'selected' : '' %>>4th Year - 1st Sem</option>
                    <option value="8" <%= currentTerm === '8' ? 'selected' : '' %>>4th Year - 2nd Sem</option>
                </select>
            </form>
            <button onclick="window.print()" class="px-5 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-lg text-sm font-bold shadow transition-colors flex items-center gap-2">
                🖨️ Print Certificate of Grades (COG)
            </button>
        </div>

        <!-- COG OFFICIAL DOCUMENT AREA -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8 print:shadow-none print:border-none print:p-0">
            
            <!-- OFFICIAL LETTERHEAD -->
            <div class="flex justify-between items-center mb-6 pb-4">
                
                <!-- Left: CUP Logo -->
                <div class="flex-shrink-0 flex items-center justify-center" style="width: 1in; height: 1in;">
                    <img src="https://upload.wikimedia.org/wikipedia/en/2/25/City_University_of_Pasay_logo.png" alt="CUP Logo" class="max-w-full max-h-full object-contain" onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\'text-[10px] text-center text-slate-300 border border-slate-200 p-2\'>[CUP LOGO]</div>';">
                </div>

                <!-- Center: Official Text -->
                <div class="text-center flex-grow px-2 text-official-green">
                    <h1 class="font-bold uppercase tracking-wide mb-0" style="font-family: 'Algerian', serif; font-size: 16pt; text-shadow: 1px 1px 2px rgba(0,0,0,0.1);">
                        City University of Pasay
                    </h1>
                    <h2 class="uppercase mb-0" style="font-family: 'Tahoma', sans-serif; font-size: 11pt;">
                        (Pamantasan ng Lungsod ng Pasay)
                    </h2>
                    <p class="mb-1" style="font-family: 'Tahoma', sans-serif; font-size: 11pt;">
                        Pasadeña St., Pasay City
                    </p>
                    <h3 class="font-bold mt-2 mb-1" style="font-family: 'Script MT Bold', cursive; font-size: 17pt;">
                        College of Nursing and School of Midwifery
                    </h3>
                    <p style="font-family: 'Tahoma', sans-serif; font-size: 8pt;">
                        4th Floor, Tramo Wing, Pasay City General Hospital, Burgos St., Pasay City
                    </p>
                </div>

                <!-- Right: CONM Logo -->
                <div class="flex-shrink-0 flex items-center justify-center" style="width: 1in; height: 1in;">
                    <img src="https://via.placeholder.com/150/ffffff/1b5e20?text=CONM+Logo" alt="CONM Logo" class="max-w-full max-h-full object-contain" onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\'text-[10px] text-center text-slate-300 border border-slate-200 p-2\'>[CONM LOGO]</div>';">
                </div>
            </div>

            <!-- Title: Certificate of Grades -->
            <div class="text-center mb-6">
                <h3 class="text-lg font-bold tracking-widest uppercase border-t-2 border-b-2 border-slate-800 print:border-black py-2 inline-block px-12">
                    Certificate of Grades
                </h3>
            </div>

            <!-- Student Information Block -->
            <div class="grid grid-cols-2 gap-4 mb-6 text-sm print-text-black">
                <div>
                    <p><span class="font-bold uppercase text-[10px] text-slate-500 print:text-black">Student Name:</span> <br> 
                       <span class="font-bold text-base uppercase"><%= studentRecord.last_name %>, <%= studentRecord.first_name %> <%= studentRecord.middle_name %></span>
                    </p>
                </div>
                <div class="text-right">
                    <p><span class="font-bold uppercase text-[10px] text-slate-500 print:text-black">Student Number:</span> <br> 
                       <span class="font-mono font-bold text-base"><%= studentRecord.student_id %></span>
                    </p>
                </div>
                <div>
                    <p><span class="font-bold uppercase text-[10px] text-slate-500 print:text-black">Program:</span> <br> 
                       <span class="font-medium"><%= studentRecord.program %></span>
                    </p>
                </div>
                <div class="text-right">
                    <p><span class="font-bold uppercase text-[10px] text-slate-500 print:text-black">Year Level:</span> <br> 
                       <span class="font-medium">Level <%= studentRecord.year_level %></span>
                    </p>
                </div>
            </div>

            <!-- Grades Table -->
            <% if (grades.length === 0) { %>
                <div class="text-center py-12 text-slate-400 border-t border-slate-200 print:border-black">
                    <p class="text-sm">No subjects enrolled or grades recorded for this term.</p>
                </div>
            <% } else { %>
                <div class="overflow-hidden border border-slate-400 print:border-black rounded-lg print:rounded-none">
                    <table class="w-full text-left border-collapse text-sm print-text-black">
                        <thead>
                            <tr class="bg-slate-100 print:bg-transparent border-b border-slate-400 print:border-black">
                                <th class="p-2 sm:p-3 font-bold uppercase text-[10px] tracking-wider border-r border-slate-400 print:border-black">Course Code</th>
                                <th class="p-2 sm:p-3 font-bold uppercase text-[10px] tracking-wider border-r border-slate-400 print:border-black">Descriptive Title</th>
                                <th class="p-2 sm:p-3 font-bold uppercase text-[10px] tracking-wider border-r border-slate-400 print:border-black text-center">Units</th>
                                <th class="p-2 sm:p-3 font-bold uppercase text-[10px] tracking-wider border-r border-slate-400 print:border-black text-center">Final Grade</th>
                                <th class="p-2 sm:p-3 font-bold uppercase text-[10px] tracking-wider text-center">Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% grades.forEach(g => { %>
                                <tr class="border-b border-slate-300 print:border-black last:border-0">
                                    <td class="p-2 sm:p-3 font-mono font-bold border-r border-slate-400 print:border-black whitespace-nowrap"><%= g.course_code %></td>
                                    <td class="p-2 sm:p-3 font-medium border-r border-slate-400 print:border-black"><%= g.descriptive_title %></td>
                                    <td class="p-2 sm:p-3 text-center border-r border-slate-400 print:border-black"><%= g.total_units %></td>
                                    <td class="p-2 sm:p-3 text-center font-bold border-r border-slate-400 print:border-black"><%= g.final_grade || '---' %></td>
                                    <td class="p-2 sm:p-3 text-center text-xs font-bold uppercase <%= g.remarks === 'PASSED' ? 'text-emerald-600 print:text-black' : (g.remarks === 'FAILED' ? 'text-red-600 print:text-black' : '') %>">
                                        <%= g.remarks || '---' %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>

            <!-- AUTHENTICATION NOTE (Automatically included in Print) -->
            <div class="mt-12 p-4 sm:p-5 border border-slate-300 print:border-solid print:border-black bg-slate-50 print:bg-transparent rounded-lg print:rounded-none text-center">
                <p class="text-[11px] sm:text-xs font-medium leading-relaxed text-slate-700 print-text-black">
                    <strong class="uppercase tracking-wider font-bold">Note:</strong> This document does not require a signature. To verify the authenticity of this Certification, you may contact the College of Nursing and School of Midwifery (CONM) directly at the 4th Floor Tramo Wing, Pasay City General Hospital, P. Burgos St, Pasay City, Metro Manila.
                </p>
            </div>
            
            <!-- Timestamp (Visible only on the printed page) -->
            <div class="mt-6 text-right text-[10px] text-slate-400 print:text-black print:block hidden font-mono">
                System Generated: <script>document.write(new Date().toLocaleString());</script>
            </div>

        </div>
    </main>
</body>
</html>