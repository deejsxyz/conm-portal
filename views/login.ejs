<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Login - CONM Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-emerald-950 via-emerald-900 to-pink-950 min-h-screen flex flex-col items-center justify-between p-4 font-sans">
    
    <div></div>

    <!-- Login Box Card -->
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-8 border-t-4 border-pink-600 space-y-6">
        <div class="text-center space-y-1">
            <h1 class="text-md font-bold text-emerald-950">City University of Pasay</h1>
            <p class="text-sm font-bold uppercase tracking-wider text-pink-600">College of Nursing & School of Midwifery</p>
            <p class="text-[11px] text-slate-400">CONM ACADEMIC INFORMATION SYSTEM</p>
        </div>

        <% if (error) { %>
            <div class="p-3 bg-red-100 border border-red-400 text-red-700 text-xs font-semibold rounded-lg text-center">
                <%= error %>
            </div>
        <% } %>

        <form action="/login" method="POST" class="space-y-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div>
                <label class="block text-[10px] font-bold text-slate-600 uppercase tracking-wider mb-1">Username</label>
                <input type="text" name="username" required autocomplete="username" placeholder="Enter username" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 text-sm font-mono bg-slate-50">
            </div>

            <div>
                <label class="block text-[10px] font-bold text-slate-600 uppercase tracking-wider mb-1">Password</label>
                <input type="password" name="password" required autocomplete="current-password" placeholder="Enter password" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 text-sm bg-slate-50">
                <div class="flex justify-end mt-2">
                    <a href="#" onclick="alert('Contact the College Registrar to Reset your Password'); return false;" class="text-[10px] font-bold text-pink-600 hover:text-pink-800 transition-colors uppercase tracking-wider">
                        Forgot Password?
                    </a>
                </div>
            </div>

            <button type="submit" class="w-full py-3 rounded-lg bg-emerald-800 hover:bg-emerald-900 text-white font-bold text-xs uppercase tracking-wider shadow-md transition-colors">
                Sign In
            </button>
        </form>

        <!-- Data Privacy Act (RA 10173) Notice -->
        <div class="pt-3 border-t border-slate-100 text-[10px] text-slate-400 leading-relaxed text-center">
            🔒 <strong>Data Privacy Notice (RA 10173):</strong> By signing in, you acknowledge that student records and academic grades are confidential personal information. All grade modifications and access events are logged for security and academic audit purposes.
        </div>
    </div>

    <!-- PROFESSIONAL POP-UP MODAL FOR LOCKED FACULTY PORTAL -->
    <% if (locals.popupMessage) { %>
        <div id="lockedModal" class="fixed inset-0 bg-slate-950/70 backdrop-blur-sm flex items-center justify-center p-4 z-50">
            <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full p-6 border-t-4 border-amber-500 text-center space-y-4">
                <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center mx-auto text-2xl">
                    🔒
                </div>
                <div class="space-y-1.5">
                    <h3 class="text-base font-bold text-slate-900">Encoding of Grades Not Yet Open</h3>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        <%= popupMessage %>
                    </p>
                </div>
                <button type="button" onclick="document.getElementById('lockedModal').remove()" class="w-full py-2.5 bg-emerald-800 hover:bg-emerald-900 text-white rounded-xl font-bold text-xs uppercase tracking-wider shadow transition-colors">
                    Understood
                </button>
            </div>
        </div>
    <% } %>

    <footer class="text-center pb-2">
        <p class="text-xs text-emerald-200/70 font-medium">© CONM Academic Information System</p>
    </footer>

</body>
</html>