<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CONM | LOGIN</title>
    <script src="https://cdn.tailwindcss.com" nonce="<%= cspNonce %>"></script>
<link rel="icon" type="image/png" href="/static/favicon.png">
<link rel="apple-touch-icon" href="/static/apple-touch-icon.png">
</head>
<body class="bg-gradient-to-br from-emerald-950 via-emerald-900 to-pink-950 min-h-screen flex flex-col items-center justify-between p-4 font-sans relative">
    
    <div></div>

    <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-6 lg:gap-8 w-full max-w-5xl z-10">

        <!-- School logo (left) -->
        <div class="flex justify-center items-center">
            <img src="/static/logo-login.png" alt="College of Nursing and School of Midwifery logo" class="w-32 md:w-72 lg:w-96 h-auto drop-shadow-2xl pointer-events-none select-none" draggable="false" style="-webkit-user-drag: none;">
        </div>

        <!-- Login box (right) -->
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full md:w-[28rem] md:shrink-0 p-8 border-t-4 border-pink-600 space-y-6">
        <div class="text-center space-y-1">
            <h1 class="text-md font-bold text-emerald-950">City University of Pasay</h1>
            <p class="text-sm font-bold uppercase tracking-wider text-pink-600">College of Nursing & School of Midwifery</p>
            <p class="text-[11px] text-slate-400">CONM ACADEMIC INFORMATION SYSTEM</p>
        </div>

        <% if (error) { %>
            <div class="p-3 bg-red-100 border border-red-400 text-red-700 text-xs font-semibold rounded-lg text-center">
                <%= error %>
            </div>
        <% } %>

        <form action="/login" method="POST" class="space-y-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div>
                <span class="text-[10px] uppercase text-slate-400 block font-bold"> USERNAME</span>
                <input type="text" name="username" aria-label="Username" required autocomplete="username" placeholder="USERNAME" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 text-sm font-mono bg-slate-50">
            </div>

            <div>
                <span class="text-[10px] uppercase text-slate-400 block font-bold"> PASSWORD</span>

                <div class="relative">
                    <input type="password" id="loginPassword" name="password" aria-label="Password" required autocomplete="current-password" placeholder="PASSWORD" class="w-full pl-4 pr-11 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 text-sm font-mono bg-slate-50">
                    <button type="button" id="togglePasswordBtn" aria-label="Show password" aria-pressed="false" title="Show / hide password" class="absolute inset-y-0 right-0 px-3 flex items-center text-slate-400 hover:text-emerald-800 cursor-pointer">
                        <svg id="eyeOpenIcon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <svg id="eyeClosedIcon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                        </svg>
                    </button>
                </div>
                <div class="flex justify-end mt-2">
                    <a href="#" id="forgotPassBtn" class="text-[10px] font-bold text-pink-600 hover:text-pink-800 transition-colors uppercase tracking-wider">
                        FORGOT PASSWORD?
                    </a>
                </div>
            </div>

            <button type="submit" class="w-full py-3 rounded-lg bg-emerald-800 hover:bg-emerald-900 text-white font-bold text-xs uppercase tracking-wider shadow-md transition-colors cursor-pointer">
                LOGIN
            </button>
        </form>

        <div class="pt-3 border-t border-slate-100 text-[10px] text-slate-400 leading-relaxed text-center">
            🔒 <strong>Data Privacy Notice (RA 10173):</strong> By signing in, you acknowledge that student records and academic grades are confidential personal information. Grade changes, password resets, account lockouts and access to immunization records are logged for security and academic audit purposes.
        </div>
        </div>

    </div>

    <% if (locals.popupMessage) { %>
        <div id="lockedModalOverlay" class="fixed inset-0 bg-slate-950/80 flex items-center justify-center p-4 z-50">
            <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full p-6 border-t-4 border-amber-500 text-center space-y-4 relative z-50">
                <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center mx-auto text-2xl">
                    🔒
                </div>
                <div class="space-y-1.5">
                    <h3 class="text-base font-bold text-slate-900">Encoding of Grades Not Yet Open</h3>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        <%= popupMessage %>
                    </p>
                </div>
                <button type="button" id="closeLockedModalBtn" class="w-full py-2.5 bg-emerald-800 hover:bg-emerald-900 text-white rounded-xl font-bold text-xs uppercase tracking-wider shadow transition-colors cursor-pointer">
                    UNDERSTOOD
                </button>
            </div>
        </div>
    <% } %>

    <footer class="text-center pb-2 z-10">
        <p class="text-xs text-emerald-200/70 font-medium">College of Nursing & School of Midwifery Academic Information System</p>
    </footer>

    <script nonce="<%= cspNonce %>">
        document.addEventListener('DOMContentLoaded', () => {
            const pwInput = document.getElementById('loginPassword');
            const pwToggle = document.getElementById('togglePasswordBtn');
            const eyeOpen = document.getElementById('eyeOpenIcon');
            const eyeClosed = document.getElementById('eyeClosedIcon');
            if (pwInput && pwToggle && eyeOpen && eyeClosed) {
                pwToggle.addEventListener('click', () => {
                    const showing = pwInput.type === 'text';
                    pwInput.type = showing ? 'password' : 'text';
                    eyeOpen.classList.toggle('hidden', !showing);
                    eyeClosed.classList.toggle('hidden', showing);
                    pwToggle.setAttribute('aria-pressed', showing ? 'false' : 'true');
                    pwToggle.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
                    pwInput.focus();
                });
            }
            const closeBtn = document.getElementById('closeLockedModalBtn');
            const overlay = document.getElementById('lockedModalOverlay');
            if (closeBtn && overlay) {
                closeBtn.addEventListener('click', () => {
                    overlay.remove();
                    if (window.history && window.history.replaceState) {
                        window.history.replaceState({}, document.title, window.location.pathname);
                    }
                });
            }

            const forgotBtn = document.getElementById('forgotPassBtn');
            if (forgotBtn) {
                forgotBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    alert('Contact the College Registrar to Reset your Password');
                });
            }
        });
    </script>
</body>
</html>
