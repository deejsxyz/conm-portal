<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Login - CONM Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-emerald-950 via-emerald-900 to-pink-950 min-h-screen flex flex-col items-center justify-between p-4 font-sans">
    
    <!-- Empty spacer for vertical centering -->
    <div></div>

    <!-- Login Box Card -->
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-8 border-t-4 border-pink-600 space-y-6">
        <div class="text-center space-y-1">
            <h1 class="text-xl font-bold text-emerald-950">City University of Pasay</h1>
            <p class="text-xs font-bold uppercase tracking-wider text-pink-600">College of Nursing & School of Midwifery</p>
            <p class="text-[11px] text-slate-400">CONM ACADEMIC INFORMATION SYSTEM</p>
        </div>

        <% if (error) { %>
            <div class="p-3 bg-red-100 border border-red-400 text-red-700 text-xs font-semibold rounded-lg text-center">
                <%= error %>
            </div>
        <% } %>

        <form action="/login" method="POST" class="space-y-4">
            <div>
                <label class="block text-[10px] font-bold text-slate-600 uppercase tracking-wider mb-1">Student Number</label>
                <input type="text" name="username" required placeholder="xxxx-xxxxxxx" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 text-sm font-mono bg-slate-50">
            </div>

            <div>
                <label class="block text-[10px] font-bold text-slate-600 uppercase tracking-wider mb-1">Password</label>
                <input type="password" name="password" required placeholder="••••••••" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 text-sm bg-slate-50">
            </div>

            <button type="submit" class="w-full py-3 rounded-lg bg-emerald-800 hover:bg-emerald-900 text-white font-bold text-xs uppercase tracking-wider shadow-md transition-colors">
                Sign In
            </button>
        </form>
    </div>

    <!-- Footer Copyright -->
    <footer class="text-center pb-2">
        <p class="text-xs text-emerald-200/70 font-medium">© CONM Academic Information System</p>
    </footer>

</body>
</html>