<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CONM System Admin</title>
    <script src="https://cdn.tailwindcss.com" nonce="<%= cspNonce %>"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">
    <header class="bg-emerald-950 text-white shadow-md border-b-4 border-pink-500">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div>
                <h2 class="text-base font-bold">College of Nursing and School of Midwifery</h2>
                <p class="text-xs text-pink-300">System Administrator</p>
            </div>
            <div class="flex items-center space-x-3">
                <span class="text-xs bg-emerald-800 px-3 py-1.5 rounded-full text-emerald-100 font-medium">
                    <%= currentUser.fullName || currentUser.username %>
                </span>
                <a href="/registrar" class="text-xs bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1.5 rounded font-medium">Registrar Portal</a>
                <a href="/faculty/edit-grades" class="text-xs bg-emerald-700 hover:bg-emerald-600 text-white px-3 py-1.5 rounded font-medium">Grade Portal</a>
                <a href="/registrar/security-log" class="text-xs bg-red-600 hover:bg-red-700 text-white px-3 py-1.5 rounded font-medium">Security Log</a>
                <a href="/change-password" class="text-xs bg-slate-700 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">Change Password</a>
                <form action="/logout" method="POST" class="inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="text-xs bg-pink-600 hover:bg-pink-700 text-white px-3 py-1.5 rounded font-medium cursor-pointer">Log Out</button>
                </form>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-6xl w-full mx-auto p-4 sm:p-6 space-y-8">

        <% if (locals.message) { %>
            <div class="p-4 bg-emerald-100 border border-emerald-400 text-emerald-800 text-xs font-bold rounded-xl shadow-sm text-center">
                ✅ <%= message %>
            </div>
        <% } %>

        <% if (locals.error) { %>
            <div class="p-4 bg-red-100 border border-red-400 text-red-700 text-xs font-bold rounded-xl shadow-sm text-center">
                ⚠️ <%= error %>
            </div>
        <% } %>

        <!-- TOGGLE BUTTONS FOR ADMIN SECTIONS -->
        <div class="flex flex-wrap gap-4">
            <button type="button" data-target-section="staffRegSection" class="admin-nav-btn px-6 py-3 bg-emerald-700 hover:bg-emerald-800 text-white rounded-xl text-sm font-bold shadow-md transition-colors flex items-center gap-2 cursor-pointer">
                👨‍🏫 Register Staff
            </button>
            <button type="button" data-target-section="staffManageSection" class="admin-nav-btn px-6 py-3 bg-teal-600 hover:bg-teal-700 text-white rounded-xl text-sm font-bold shadow-md transition-colors flex items-center gap-2 cursor-pointer">
                👥 Manage Staff
            </button>
            <button type="button" data-target-section="studentRegSection" class="admin-nav-btn px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-sm font-bold shadow-md transition-colors flex items-center gap-2 cursor-pointer">
                👤 Register Student
            </button>
            <button type="button" data-target-section="studentManageSection" class="admin-nav-btn px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-bold shadow-md transition-colors flex items-center gap-2 cursor-pointer">
                ✏️ Manage Students
            </button>
        </div>

        <div class="space-y-4">
            <!-- ==================== MANAGE STUDENTS SECTION ==================== -->
            <div id="studentManageSection" class="<%= locals.searchStudentId ? '' : 'hidden' %> space-y-5">
                
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 space-y-5">
                    
                    <!-- NEW SUB-TABS (Manage, Archive, Delete) -->
                    <div class="flex flex-wrap gap-2 border-b border-slate-200 pb-3">
                        <button type="button" data-target="stu_manage_mode" class="stu-act-btn px-5 py-2 bg-indigo-700 text-white rounded-lg text-xs font-bold shadow-sm transition-colors cursor-pointer">
                            ✏️ Manage Account
                        </button>
                        <button type="button" data-target="stu_archive_mode" class="stu-act-btn px-5 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg text-xs font-bold shadow-sm transition-colors cursor-pointer">
                            📦 Bulk Archive
                        </button>
                        <button type="button" data-target="stu_restore_mode" class="stu-act-btn px-5 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg text-xs font-bold shadow-sm transition-colors cursor-pointer">
                            ♻️ Bulk Restore
                        </button>
                        <button type="button" data-target="stu_delete_mode" class="stu-act-btn px-5 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg text-xs font-bold shadow-sm transition-colors cursor-pointer">
                            🗑️ Bulk Delete
                        </button>
                    </div>

                    <!-- 1. MANAGE ACCOUNT MODE -->
                    <div id="stu_manage_mode" class="stu-mode-panel space-y-5">
                        <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
                            <div>
                                <h4 class="font-bold text-emerald-900 text-sm uppercase tracking-wider">Search & Edit Student Account</h4>
                                <p class="text-xs text-slate-500">Search by ID to edit student details or reset passwords.</p>
                            </div>
                            <form method="GET" action="/admin" class="flex items-center gap-2 w-full sm:w-auto">
                                <input type="text" name="search_student_id" value="<%= locals.searchStudentId || '' %>" placeholder="Enter Student ID" class="w-full sm:w-64 px-3 py-2 rounded-lg border border-slate-300 text-xs font-mono focus:ring-2 focus:ring-emerald-500">
                                <button type="submit" class="px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-bold shadow cursor-pointer">Search ID</button>
                                <% if (locals.searchStudentId) { %>
                                    <a href="/admin" class="px-3 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg text-xs font-bold">Clear</a>
                                <% } %>
                            </form>
                        </div>

                        <% if (locals.searchStudentId) { %>
                            <% if (searchedStudents.length === 0) { %>
                                <div class="p-4 text-center text-xs text-slate-500 bg-slate-50 rounded-lg border border-slate-200">
                                    No student found with ID "<%= searchStudentId %>".
                                </div>
                            <% } else { %>
                                <div class="space-y-4">
                                    <% searchedStudents.forEach(stu => { 
                                        const actionWord = stu.is_archived ? 'Restore' : 'Archive';
                                    %>
                                        <div class="bg-slate-50 rounded-lg border border-slate-200 p-4 space-y-3">
                                            <div class="flex flex-wrap justify-between items-center gap-2 border-b border-slate-200 pb-3">
                                                <div class="flex items-center gap-2.5">
                                                    <span class="font-mono font-bold text-sm text-emerald-900"><%= stu.student_id %></span>
                                                    <span class="text-xs font-bold text-slate-700 hidden sm:inline">
                                                        — <%= [stu.first_name, stu.middle_name, stu.last_name].filter(Boolean).join(' ') %>
                                                    </span>
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-100 text-indigo-800">
                                                        BSN<%= stu.year_level %> - <%= stu.section || 'A' %>
                                                    </span>
                                                    <% if (stu.is_archived) { %>
                                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-100 text-red-800">Archived</span>
                                                    <% } else if (stu.must_change_password) { %>
                                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">Pending Password Change</span>
                                                    <% } else { %>
                                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">Active / Verified</span>
                                                    <% } %>
                                                </div>

                                                <div class="flex items-center gap-2">
                                                    <a href="/registrar?student_id=<%= encodeURIComponent(stu.student_id) %>" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded text-xs font-bold shadow-sm cursor-pointer">
                                                        Manage in Registrar
                                                    </a>
                                                    <form action="/admin/delete-user" method="POST" class="inline confirm-form" data-confirm-msg="<%= actionWord %> student <%= stu.student_id %>? Academic records and grades are preserved.">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <input type="hidden" name="username" value="<%= stu.student_id %>">
                                                        <input type="hidden" name="action" value="<%= stu.is_archived ? 'restore' : 'archive' %>">
                                                        <button type="submit" class="px-3 py-1.5 <%= stu.is_archived ? 'bg-emerald-600 hover:bg-emerald-700' : 'bg-slate-600 hover:bg-slate-700' %> text-white rounded text-xs font-bold shadow-sm cursor-pointer">
                                                            <%= actionWord %> Student
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>

                                            <form action="/admin/edit-student" method="POST" class="grid grid-cols-1 sm:grid-cols-7 gap-2 items-end pt-1">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="student_id" value="<%= stu.student_id %>">
                                                <div>
                                                    <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">First Name</label>
                                                    <input type="text" name="first_name" required value="<%= stu.first_name || '' %>" class="w-full px-2.5 py-1.5 rounded border border-slate-300 bg-white text-xs">
                                                </div>
                                                <div>
                                                    <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Middle Name</label>
                                                    <input type="text" name="middle_name" value="<%= stu.middle_name || '' %>" class="w-full px-2.5 py-1.5 rounded border border-slate-300 bg-white text-xs">
                                                </div>
                                                <div>
                                                    <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Last Name</label>
                                                    <input type="text" name="last_name" required value="<%= stu.last_name || '' %>" class="w-full px-2.5 py-1.5 rounded border border-slate-300 bg-white text-xs">
                                                </div>
                                                <div>
                                                    <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Year Level</label>
                                                    <select name="year_level" class="w-full px-2.5 py-1.5 rounded border border-slate-300 bg-white text-xs font-bold">
                                                        <option value="1" <%= Number(stu.year_level) === 1 ? 'selected' : '' %>>BSN1</option>
                                                        <option value="2" <%= Number(stu.year_level) === 2 ? 'selected' : '' %>>BSN2</option>
                                                        <option value="3" <%= Number(stu.year_level) === 3 ? 'selected' : '' %>>BSN3</option>
                                                        <option value="4" <%= Number(stu.year_level) === 4 ? 'selected' : '' %>>BSN4</option>
                                                    </select>
                                                </div>
                                                <div>
                                                    <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Section</label>
                                                    <select name="section" class="w-full px-2.5 py-1.5 rounded border border-slate-300 bg-white text-xs font-bold">
                                                        <option value="A" <%= (stu.section || 'A') === 'A' ? 'selected' : '' %>>A</option>
                                                        <option value="B" <%= stu.section === 'B' ? 'selected' : '' %>>B</option>
                                                        <option value="C" <%= stu.section === 'C' ? 'selected' : '' %>>C</option>
                                                    </select>
                                                </div>
                                                <div>
                                                    <label class="block text-[10px] uppercase font-bold text-amber-600 mb-1">Reset Password?</label>
                                                    <div class="flex">
                                                        <input type="text" name="temp_password" id="temp_pass_<%= stu.student_id %>" placeholder="Leave blank" class="w-full px-2.5 py-1.5 rounded-l border border-amber-300 bg-amber-50 text-[11px] font-mono focus:ring-1 focus:ring-amber-500">
                                                        <button type="button" data-target="temp_pass_<%= stu.student_id %>" class="gen-pass-btn px-2 bg-amber-200 hover:bg-amber-300 border border-l-0 border-amber-300 rounded-r text-xs font-bold text-amber-800 transition-colors cursor-pointer" title="Generate New Password">↻</button>
                                                    </div>
                                                </div>
                                                <div class="flex gap-2">
                                                    <a href="/admin" class="flex-1 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded font-bold text-xs shadow-sm flex items-center justify-center">Cancel</a>
                                                    <button type="submit" class="flex-[2] py-1.5 bg-slate-700 hover:bg-slate-800 text-white rounded font-bold text-xs shadow-sm cursor-pointer">Save</button>
                                                </div>
                                            </form>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>
                        <% } else { %>
                            <div class="p-8 text-center text-xs text-slate-400 italic bg-slate-50 rounded-lg border border-slate-200">
                                Enter a Student ID above to edit their details.
                            </div>
                        <% } %>
                    </div>

                    <!-- 2. ARCHIVE MODE -->
                    <div id="stu_archive_mode" class="stu-mode-panel hidden space-y-4">
                        <div class="flex flex-wrap items-center justify-between gap-3 bg-amber-50 p-4 border border-amber-200 rounded-xl">
                            <div>
                                <h4 class="font-bold text-amber-900 text-sm uppercase tracking-wider">📦 Bulk Archive Active Students</h4>
                                <p class="text-xs text-amber-700">Archiving removes accounts from active class lists, but preserves all their grades, records, and logs safely.</p>
                            </div>
                            <div class="flex items-center gap-3">
                                <label class="flex items-center gap-1.5 cursor-pointer text-xs font-bold text-amber-900 bg-amber-100/50 px-2.5 py-1.5 rounded-lg border border-amber-300 shadow-sm transition hover:bg-amber-200">
                                    <input type="checkbox" id="archiveShowAllToggle" class="w-4 h-4 rounded text-amber-600 focus:ring-amber-500 cursor-pointer">
                                    Show All
                                </label>
                                <div class="w-px h-6 bg-amber-300 hidden sm:block"></div>
                                <select id="archiveYearFilter" class="px-3 py-2 rounded-lg border border-amber-300 text-xs font-bold text-amber-900 bg-white cursor-pointer transition-opacity">
                                    <option value="" style="font-style:italic;">-- Year --</option>
                                    <option value="1">BSN1</option>
                                    <option value="2">BSN2</option>
                                    <option value="3">BSN3</option>
                                    <option value="4">BSN4</option>
                                </select>
                                <select id="archiveSecFilter" class="px-3 py-2 rounded-lg border border-amber-300 text-xs font-bold text-amber-900 bg-white cursor-pointer transition-opacity">
                                    <option value="" style="font-style:italic;">-- Sec --</option>
                                    <option value="A">A</option>
                                    <option value="B">B</option>
                                    <option value="C">C</option>
                                </select>
                            </div>
                        </div>

                        <form id="bulkArchiveSubmitForm" action="/admin/bulk-archive-users" method="POST" class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden" data-confirm-msg="CONFIRMATION REQUIRED: Are you sure you want to archive the selected accounts? They will be removed from active class lists, but their details, grades, and enrollment data will be safely retained.">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="bg-slate-100 px-4 py-3 flex justify-between items-center border-b border-slate-300">
                                <button type="button" id="archiveSelectAll" class="px-3 py-1.5 bg-white hover:bg-slate-200 border border-slate-300 text-slate-700 rounded text-[11px] font-bold shadow-sm transition-colors cursor-pointer">Select All / None</button>
                                <button type="submit" class="px-4 py-1.5 bg-amber-600 hover:bg-amber-700 text-white rounded text-[11px] font-bold shadow-sm transition-colors cursor-pointer">📦 Archive Selected Accounts</button>
                            </div>
                            <div class="max-h-96 overflow-y-auto">
                                <table class="w-full text-left text-xs">
                                    <tbody id="archiveTbody" class="divide-y divide-slate-200">
                                        <!-- Rendered by JS -->
                                    </tbody>
                                </table>
                            </div>
                        </form>
                    </div>

                    <!-- 3. RESTORE MODE -->
                    <div id="stu_restore_mode" class="stu-mode-panel hidden space-y-4">
                        <div class="flex flex-wrap items-center justify-between gap-3 bg-emerald-50 p-4 border border-emerald-200 rounded-xl">
                            <div>
                                <h4 class="font-bold text-emerald-900 text-sm uppercase tracking-wider">♻️ Bulk Restore Archived Students</h4>
                                <p class="text-xs text-emerald-700">Restoring returns accounts to the active class lists. Grades and records were never removed, and students can log in again with their existing passwords.</p>
                            </div>
                            <div class="flex items-center gap-3">
                                <label class="flex items-center gap-1.5 cursor-pointer text-xs font-bold text-emerald-900 bg-emerald-100/50 px-2.5 py-1.5 rounded-lg border border-emerald-300 shadow-sm transition hover:bg-emerald-200">
                                    <input type="checkbox" id="restoreShowAllToggle" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 cursor-pointer">
                                    Show All
                                </label>
                                <div class="w-px h-6 bg-emerald-300 hidden sm:block"></div>
                                <select id="restoreYearFilter" class="px-3 py-2 rounded-lg border border-emerald-300 text-xs font-bold text-emerald-900 bg-white cursor-pointer transition-opacity">
                                    <option value="" style="font-style:italic;">-- Year --</option>
                                    <option value="1">BSN1</option>
                                    <option value="2">BSN2</option>
                                    <option value="3">BSN3</option>
                                    <option value="4">BSN4</option>
                                </select>
                                <select id="restoreSecFilter" class="px-3 py-2 rounded-lg border border-emerald-300 text-xs font-bold text-emerald-900 bg-white cursor-pointer transition-opacity">
                                    <option value="" style="font-style:italic;">-- Sec --</option>
                                    <option value="A">A</option>
                                    <option value="B">B</option>
                                    <option value="C">C</option>
                                </select>
                            </div>
                        </div>

                        <form id="bulkRestoreSubmitForm" action="/admin/bulk-restore-users" method="POST" class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden" data-confirm-msg="Restore the selected archived accounts? They will return to the active class lists and can log in again.">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="bg-slate-100 px-4 py-3 flex justify-between items-center border-b border-slate-300">
                                <button type="button" id="restoreSelectAll" class="px-3 py-1.5 bg-white hover:bg-slate-200 border border-slate-300 text-slate-700 rounded text-[11px] font-bold shadow-sm transition-colors cursor-pointer">Select All / None</button>
                                <button type="submit" class="px-4 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-[11px] font-bold shadow-sm transition-colors cursor-pointer">♻️ Restore Selected Accounts</button>
                            </div>
                            <div class="max-h-96 overflow-y-auto">
                                <table class="w-full text-left text-xs">
                                    <tbody id="restoreTbody" class="divide-y divide-slate-200">
                                        <!-- Rendered by JS -->
                                    </tbody>
                                </table>
                            </div>
                        </form>
                    </div>

                    <!-- 4. DELETE MODE -->
                    <div id="stu_delete_mode" class="stu-mode-panel hidden space-y-4">
                        <div class="flex flex-wrap items-center justify-between gap-3 bg-red-50 p-4 border border-red-200 rounded-xl">
                            <div>
                                <h4 class="font-bold text-red-900 text-sm uppercase tracking-wider">🗑️ Bulk Permanently Delete Students</h4>
                                <p class="text-xs font-bold text-red-600 uppercase tracking-wider">Danger Zone: PERSONAL DATA, GRADES, AND VACCINE RECORDS WILL BE WIPED COMPLETELY. Audit logs are kept.</p>
                            </div>
                            <div class="flex items-center gap-3">
                                <label class="flex items-center gap-1.5 cursor-pointer text-xs font-bold text-red-900 bg-red-100/50 px-2.5 py-1.5 rounded-lg border border-red-300 shadow-sm transition hover:bg-red-200">
                                    <input type="checkbox" id="deleteShowAllToggle" class="w-4 h-4 rounded text-red-600 focus:ring-red-500 cursor-pointer">
                                    Show All
                                </label>
                                <div class="w-px h-6 bg-red-300 hidden sm:block"></div>
                                <select id="deleteYearFilter" class="px-3 py-2 rounded-lg border border-red-300 text-xs font-bold text-red-900 bg-white cursor-pointer transition-opacity">
                                    <option value="" style="font-style:italic;">-- Year --</option>
                                    <option value="1">BSN1</option>
                                    <option value="2">BSN2</option>
                                    <option value="3">BSN3</option>
                                    <option value="4">BSN4</option>
                                </select>
                                <select id="deleteSecFilter" class="px-3 py-2 rounded-lg border border-red-300 text-xs font-bold text-red-900 bg-white cursor-pointer transition-opacity">
                                    <option value="" style="font-style:italic;">-- Sec --</option>
                                    <option value="A">A</option>
                                    <option value="B">B</option>
                                    <option value="C">C</option>
                                </select>
                            </div>
                        </div>

                        <form id="bulkDeleteSubmitForm" action="/admin/bulk-delete-users" method="POST" class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden" data-confirm-msg="CRITICAL WARNING: Are you sure you want to PERMANENTLY DELETE the selected accounts? ALL personal details, grades, and vaccine records will be WIPED COMPLETELY. Audit logs are retained. This action CANNOT be undone.">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="bg-slate-100 px-4 py-3 flex justify-between items-center border-b border-slate-300">
                                <button type="button" id="deleteSelectAll" class="px-3 py-1.5 bg-white hover:bg-slate-200 border border-slate-300 text-slate-700 rounded text-[11px] font-bold shadow-sm transition-colors cursor-pointer">Select All / None</button>
                                <div class="flex items-center gap-2">
                                    <input type="text" name="confirm_text" autocomplete="off" placeholder="Type DELETE to confirm" class="px-2.5 py-1.5 rounded border border-red-300 text-[11px] font-mono w-44 bg-white">
                                    <button type="submit" class="px-4 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded text-[11px] font-bold shadow-sm transition-colors cursor-pointer">🗑️ Permanently Delete Selected</button>
                                </div>
                            </div>
                            <div class="max-h-96 overflow-y-auto">
                                <table class="w-full text-left text-xs">
                                    <tbody id="deleteTbody" class="divide-y divide-slate-200">
                                        <!-- Rendered by JS -->
                                    </tbody>
                                </table>
                            </div>
                        </form>
                    </div>

                </div>
            </div>

            <!-- ==================== REGISTER STUDENT SECTION ==================== -->
            <div id="studentRegSection" class="hidden bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-900 mb-1">Register New Student Account</h3>
                <p class="text-xs text-slate-500 mb-4">Create a student user account along with their official student profile record (BSN1–BSN4 & Section A/B/C).</p>
                
                <form action="/admin/add-student" method="POST" class="grid grid-cols-1 sm:grid-cols-8 gap-3 items-end">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Student ID</label>
                        <input type="text" name="student_id" required placeholder="e.g. 2024-00150" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-mono">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">First Name</label>
                        <input type="text" name="first_name" required placeholder="e.g. Juan" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Middle Name</label>
                        <input type="text" name="middle_name" placeholder="e.g. Reyes" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Last Name</label>
                        <input type="text" name="last_name" required placeholder="e.g. Dela Cruz" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Year Level</label>
                        <select name="year_level" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-bold">
                            <option value="1">BSN1</option>
                            <option value="2" selected>BSN2</option>
                            <option value="3">BSN3</option>
                            <option value="4">BSN4</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Section</label>
                        <select name="section" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-bold">
                            <option value="A" selected>A</option>
                            <option value="B">B</option>
                            <option value="C">C</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Temp Password</label>
                        <input type="text" id="studentTempPassword" name="temp_password" required class="w-full px-3 py-2 rounded-lg border border-emerald-400 bg-emerald-50 text-xs font-mono font-bold text-emerald-900">
                    </div>
                    <div class="flex gap-2">
                        <button type="button" data-target-section="studentManageSection" class="cancel-toggle-btn flex-1 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg font-bold text-xs shadow transition-colors cursor-pointer">Cancel</button>
                        <button type="submit" class="flex-[2] py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg font-bold text-xs shadow transition-colors cursor-pointer">
                            + Add
                        </button>
                    </div>
                </form>
            </div>

            <!-- ==================== MANAGE STAFF SECTION ==================== -->
            <div id="staffManageSection" class="<%= locals.selectedStaff ? '' : 'hidden' %> bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-5">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
                    <div>
                        <h4 class="font-bold text-emerald-900 text-sm uppercase tracking-wider">Registered Staff Members (<%= locals.staffList ? staffList.length : 0 %>)</h4>
                        <p class="text-xs text-slate-500">Select a staff member from the dropdown list to view, edit, reset password, or archive.</p>
                    </div>

                    <form method="GET" action="/admin" class="w-full sm:w-80">
                        <select name="staff_user" id="staffSelectDropdown" class="w-full px-3 py-2.5 rounded-lg border border-slate-300 bg-slate-50 text-xs font-semibold text-slate-700 focus:ring-2 focus:ring-emerald-500 cursor-pointer">
                            <option value="">-- Select Staff Member --</option>
                            <% if (locals.staffList) { staffList.forEach(staff => { 
                                const fullName = [staff.first_name, staff.middle_name, staff.last_name].filter(Boolean).join(' ') || staff.username;
                            %>
                                <option value="<%= staff.username %>" <%= (locals.selectedStaff && selectedStaff.username === staff.username) ? 'selected' : '' %>>
                                    [<%= staff.role.toUpperCase() %>] <%= fullName %> (<%= staff.username %>)
                                </option>
                            <% }) } %>
                        </select>
                    </form>
                </div>

                <% if (locals.selectedStaff) { %>
                    <div class="bg-emerald-50/70 rounded-xl border border-emerald-200 p-5 space-y-4">
                        <div class="flex flex-wrap justify-between items-center gap-2">
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-bold uppercase text-emerald-900">Editing Account:</span>
                                <span class="font-mono text-xs font-bold bg-emerald-900 text-white px-2.5 py-0.5 rounded"><%= selectedStaff.username %></span>
                                <% if (selectedStaff.must_change_password) { %>
                                    <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-amber-100 text-amber-800">Pending First-Login Password Change</span>
                                <% } else { %>
                                    <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-100 text-emerald-800">Active / Verified</span>
                                <% } %>
                            </div>

                            <div class="flex items-center gap-2">
                                <form action="/admin/delete-user" method="POST" class="inline confirm-form" data-confirm-msg="Archive staff account <%= selectedStaff.username %>?">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="username" value="<%= selectedStaff.username %>">
                                    <button type="submit" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-bold shadow-sm cursor-pointer">
                                        Archive Staff
                                    </button>
                                </form>
                            </div>
                        </div>

                        <form action="/admin/edit-faculty" method="POST" class="grid grid-cols-1 sm:grid-cols-6 gap-3 items-end pt-2 border-t border-emerald-200/60">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="original_username" value="<%= selectedStaff.username %>">
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-emerald-900 mb-1">Username / ID</label>
                                <input type="text" name="username" required value="<%= selectedStaff.username %>" class="w-full px-2.5 py-1.5 rounded border border-emerald-300 bg-white text-xs font-mono font-bold text-emerald-950">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-emerald-900 mb-1">First Name</label>
                                <input type="text" name="first_name" required value="<%= selectedStaff.first_name || '' %>" class="w-full px-2.5 py-1.5 rounded border border-emerald-300 bg-white text-xs">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-emerald-900 mb-1">Middle Name</label>
                                <input type="text" name="middle_name" value="<%= selectedStaff.middle_name || '' %>" class="w-full px-2.5 py-1.5 rounded border border-emerald-300 bg-white text-xs">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-emerald-900 mb-1">Last Name</label>
                                <input type="text" name="last_name" required value="<%= selectedStaff.last_name || '' %>" class="w-full px-2.5 py-1.5 rounded border border-emerald-300 bg-white text-xs">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-amber-600 mb-1">Reset Password?</label>
                                <div class="flex">
                                    <input type="text" name="temp_password" id="temp_pass_staff_<%= selectedStaff.username %>" placeholder="Leave blank" class="w-full px-2.5 py-1.5 rounded-l border border-amber-300 bg-amber-50 text-[11px] font-mono focus:ring-1 focus:ring-amber-500">
                                    <button type="button" data-target="temp_pass_staff_<%= selectedStaff.username %>" class="gen-pass-btn px-2 bg-amber-200 hover:bg-amber-300 border border-l-0 border-amber-300 rounded-r text-xs font-bold text-amber-800 transition-colors cursor-pointer" title="Generate New Password">↻</button>
                                </div>
                            </div>
                            <div class="flex gap-2">
                                <a href="/admin" class="flex-1 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg font-bold text-xs shadow-sm flex items-center justify-center">Cancel</a>
                                <button type="submit" class="flex-[2] py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg font-bold text-xs shadow-sm cursor-pointer">
                                    💾 Save
                                </button>
                            </div>
                        </form>
                    </div>
                <% } %>

                <!-- Archived staff: restore here -->
                <div class="mt-5 pt-4 border-t border-slate-200">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">Archived Staff Accounts</h4>
                    <% if (!locals.archivedStaffList || archivedStaffList.length === 0) { %>
                        <p class="text-xs text-slate-400 italic">No archived staff accounts.</p>
                    <% } else { %>
                        <p class="text-[11px] text-slate-500 mb-2">Restoring an account lets the person log in again with their existing password. Faculty subject assignments were removed when archived, so re-assign them after restoring.</p>
                        <div class="border border-slate-200 rounded-lg divide-y divide-slate-200">
                            <% archivedStaffList.forEach(st => { %>
                                <div class="flex flex-wrap items-center justify-between gap-2 px-3 py-2 text-xs">
                                    <div>
                                        <span class="font-mono font-bold text-slate-800"><%= st.username %></span>
                                        <span class="ml-2 uppercase font-bold text-slate-500 text-[10px]"><%= st.role %></span>
                                        <span class="ml-2 text-slate-600"><%= [st.last_name, [st.first_name, st.middle_name].filter(Boolean).join(' ')].filter(Boolean).join(', ') %></span>
                                    </div>
                                    <form action="/admin/delete-user" method="POST" class="inline confirm-form" data-confirm-msg="Restore staff account <%= st.username %>?">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="username" value="<%= st.username %>">
                                        <input type="hidden" name="action" value="restore">
                                        <button type="submit" class="px-3 py-1 bg-emerald-700 hover:bg-emerald-800 text-white rounded text-[11px] font-bold cursor-pointer">Restore</button>
                                    </form>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- ==================== REGISTER STAFF SECTION ==================== -->
            <div id="staffRegSection" class="hidden bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-900 mb-1">Register New Staff Member</h3>
                <p class="text-xs text-slate-500 mb-4">Create accounts for Faculty or CONM Registrars.</p>
                
                <form action="/admin/add-staff" method="POST" class="grid grid-cols-1 sm:grid-cols-7 gap-3 items-end">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Username</label>
                        <input type="text" name="username" required placeholder="e.g. prof.dizon" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-mono">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Role</label>
                        <select name="role" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-medium cursor-pointer">
                            <option value="registrar">Registrar</option>
                            <option value="faculty">Faculty</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">First Name</label>
                        <input type="text" name="first_name" required placeholder="e.g. Roberto" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Middle Name</label>
                        <input type="text" name="middle_name" placeholder="e.g. Gomez" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Last Name</label>
                        <input type="text" name="last_name" required placeholder="e.g. Dizon" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Temp Password</label>
                        <input type="text" id="staffTempPassword" name="temp_password" required class="w-full px-3 py-2 rounded-lg border border-emerald-400 bg-emerald-50 text-xs font-mono font-bold text-emerald-900">
                    </div>
                    <div class="flex gap-2">
                        <button type="button" data-target-section="staffManageSection" class="cancel-toggle-btn flex-1 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg font-bold text-xs shadow transition-colors cursor-pointer">Cancel</button>
                        <button type="submit" class="flex-[2] py-2 bg-pink-600 hover:bg-pink-700 text-white rounded-lg font-bold text-xs shadow transition-colors cursor-pointer">
                            + Add Staff
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </main>

    <!-- XSS-SAFE JSON SCRIPT BLOCKS WITH NONCE -->
    <script id="all-active-students-data" type="application/json" nonce="<%= cspNonce %>">
        <%- JSON.stringify(locals.allActiveStudents || []).replace(/</g, '\\u003c') %>
    </script>

    <script id="all-archived-students-data" type="application/json" nonce="<%= cspNonce %>">
        <%- JSON.stringify(locals.allArchivedStudents || []).replace(/</g, '\\u003c') %>
    </script>

    <script nonce="<%= cspNonce %>">
        // Safe HTML output
        function escapeHtml(str) {
            return String(str ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function toggleSection(sectionId) {
            const sections = ['staffRegSection', 'staffManageSection', 'studentRegSection', 'studentManageSection'];
            sections.forEach(id => {
                const section = document.getElementById(id);
                if (section) {
                    if (id === sectionId) {
                        section.classList.remove('hidden');
                    } else {
                        section.classList.add('hidden');
                    }
                }
            });
            sessionStorage.setItem('activeAdminSection', sectionId);
        }

        function secureRandInt(max) {
            const arr = new Uint32Array(1);
            window.crypto.getRandomValues(arr);
            return arr[0] % max;
        }

        function generateRandomPassword() {
            const upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
            const lower = 'abcdefghijklmnopqrstuvwxyz';
            const num = '0123456789';
            const special = '!@#$%^&*';
            const all = upper + lower + num + special;
            
            let pass = [
                upper[secureRandInt(upper.length)],
                lower[secureRandInt(lower.length)],
                num[secureRandInt(num.length)],
                special[secureRandInt(special.length)]
            ];
            for (let i = 0; i < 6; i++) {
                pass.push(all[secureRandInt(all.length)]);
            }
            for (let i = pass.length - 1; i > 0; i--) {
                const j = secureRandInt(i + 1);
                [pass[i], pass[j]] = [pass[j], pass[i]];
            }
            return pass.join('');
        }
        
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.admin-nav-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    toggleSection(btn.getAttribute('data-target-section'));
                });
            });

            document.querySelectorAll('.cancel-toggle-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    toggleSection(btn.getAttribute('data-target-section'));
                });
            });

            // Standard individual form confirmations
            document.querySelectorAll('.confirm-form').forEach(form => {
                form.addEventListener('submit', (e) => {
                    const msg = form.getAttribute('data-confirm-msg');
                    if (msg && !confirm(msg)) {
                        e.preventDefault();
                    }
                });
            });

            // Secure Bulk Action Handlers (Bypasses CSP limits and validates empty selections)
            ['archive', 'restore', 'delete'].forEach(mode => {
                const formIds = { archive: 'bulkArchiveSubmitForm', restore: 'bulkRestoreSubmitForm', delete: 'bulkDeleteSubmitForm' };
                const form = document.getElementById(formIds[mode]);
                if (form) {
                    form.addEventListener('submit', (e) => {
                        const selectedBoxes = form.querySelectorAll(`.${mode}-checkbox:checked`);
                        if (selectedBoxes.length === 0) {
                            e.preventDefault();
                            alert(`Please select at least one account to ${mode}.`);
                            return;
                        }
                        if (mode === 'delete') {
                            const typed = form.querySelector('input[name="confirm_text"]');
                            if (!typed || typed.value.trim() !== 'DELETE') {
                                e.preventDefault();
                                alert('To permanently delete accounts, type DELETE (in capital letters) in the confirmation box.');
                                return;
                            }
                        }
                        const msg = form.getAttribute('data-confirm-msg');
                        if (msg && !confirm(msg)) {
                            e.preventDefault();
                        }
                    });
                }
            });

            document.querySelectorAll('.gen-pass-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const targetId = btn.getAttribute('data-target');
                    const targetInput = document.getElementById(targetId);
                    if (targetInput) targetInput.value = generateRandomPassword();
                });
            });

            const staffDropdown = document.getElementById('staffSelectDropdown');
            if (staffDropdown) {
                staffDropdown.addEventListener('change', (e) => {
                    e.target.form.submit();
                });
            }

            const staffPass = document.getElementById('staffTempPassword');
            const studentPass = document.getElementById('studentTempPassword');
            if (staffPass && !staffPass.value) staffPass.value = generateRandomPassword();
            if (studentPass && !studentPass.value) studentPass.value = generateRandomPassword();
            
            // Manage Student Sub-Tabs Logic (Manage / Archive / Delete)
            const stuActBtns = document.querySelectorAll('.stu-act-btn');
            const stuModePanels = document.querySelectorAll('.stu-mode-panel');
            
            if (stuActBtns.length > 0) {
                stuActBtns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        stuActBtns.forEach(b => {
                            b.classList.remove('bg-indigo-700', 'text-white');
                            b.classList.add('bg-slate-200', 'text-slate-700');
                        });
                        btn.classList.remove('bg-slate-200', 'text-slate-700');
                        btn.classList.add('bg-indigo-700', 'text-white');

                        const target = btn.getAttribute('data-target');
                        stuModePanels.forEach(p => p.classList.add('hidden'));
                        const panel = document.getElementById(target);
                        if (panel) panel.classList.remove('hidden');

                        sessionStorage.setItem('activeStudentSubTab', target);
                    });
                });

                const savedSubTab = sessionStorage.getItem('activeStudentSubTab') || 'stu_manage_mode';
                const defaultBtn = document.querySelector(`.stu-act-btn[data-target="${savedSubTab}"]`);
                if (defaultBtn) defaultBtn.click();
            }

            // Client-Side Bulk Table Rendering for Archive and Delete Tabs
            const allActiveStudents = JSON.parse(document.getElementById('all-active-students-data').textContent);
            const allArchivedStudents = JSON.parse(document.getElementById('all-archived-students-data').textContent);

            function renderBulkList(mode) {
                const yearSel = document.getElementById(`${mode}YearFilter`);
                const secSel = document.getElementById(`${mode}SecFilter`);
                const showAllToggle = document.getElementById(`${mode}ShowAllToggle`);
                const tbody = document.getElementById(`${mode}Tbody`);
                
                if (!yearSel || !secSel || !tbody) return;

                const year = yearSel.value;
                const sec = secSel.value;
                const showAll = showAllToggle && showAllToggle.checked;

                if (!showAll && (!year || !sec)) {
                    tbody.innerHTML = '<tr><td colspan="4" class="p-5 text-center text-slate-500 italic">Please select Year Level and Section to load student accounts, or check "Show All".</td></tr>';
                    return;
                }

                // Restore and permanent delete both work on ARCHIVED students; archive works on active ones.
                const source = (mode === 'restore' || mode === 'delete') ? allArchivedStudents : allActiveStudents;
                const filtered = showAll ? source : source.filter(s => String(s.year_level) === year && s.section === sec);
                
                let html = '';
                if (filtered.length === 0) {
                    html = '<tr><td colspan="4" class="p-5 text-center text-slate-500 font-bold">' + (mode === 'archive' ? 'No active students found.' : 'No archived students found.') + '</td></tr>';
                } else {
                    filtered.forEach(s => {
                        const fullName = escapeHtml(`${s.last_name}, ${s.first_name} ${s.middle_name || ''}`.trim());
                        html += `
                            <tr class="border-b border-slate-200 hover:bg-slate-50">
                                <td class="py-2 px-4 text-center w-12"><input type="checkbox" name="userIds" value="${escapeHtml(s.student_id)}" class="${mode}-checkbox w-4 h-4 cursor-pointer text-indigo-600 rounded border-slate-300"></td>
                                <td class="py-2 px-4 font-mono font-bold text-slate-700 w-32">${escapeHtml(s.student_id)}</td>
                                <td class="py-2 px-4 uppercase font-bold text-slate-800">${fullName}</td>
                                <td class="py-2 px-4 uppercase font-bold text-slate-500 text-right text-[10px]">BSN${escapeHtml(s.year_level)} - ${escapeHtml(s.section)}</td>
                            </tr>
                        `;
                    });
                }
                tbody.innerHTML = html;

                // Visually and functionally disable dropdowns if Show All is checked
                if (showAll) {
                    yearSel.disabled = true;
                    secSel.disabled = true;
                    yearSel.classList.add('opacity-50', 'cursor-not-allowed');
                    secSel.classList.add('opacity-50', 'cursor-not-allowed');
                } else {
                    yearSel.disabled = false;
                    secSel.disabled = false;
                    yearSel.classList.remove('opacity-50', 'cursor-not-allowed');
                    secSel.classList.remove('opacity-50', 'cursor-not-allowed');
                }
            }

            ['archive', 'restore', 'delete'].forEach(mode => {
                const yF = document.getElementById(`${mode}YearFilter`);
                const sF = document.getElementById(`${mode}SecFilter`);
                const sA = document.getElementById(`${mode}ShowAllToggle`);
                if (yF && sF) {
                    yF.addEventListener('change', () => renderBulkList(mode));
                    sF.addEventListener('change', () => renderBulkList(mode));
                    if(sA) sA.addEventListener('change', () => renderBulkList(mode));
                    renderBulkList(mode); // Initial render check
                }
                
                // Select All / None Button Binding
                const selectAllBtn = document.getElementById(`${mode}SelectAll`);
                if (selectAllBtn) {
                    selectAllBtn.addEventListener('click', () => {
                        const checkboxes = document.querySelectorAll(`.${mode}-checkbox`);
                        if (checkboxes.length === 0) return;
                        const allChecked = Array.from(checkboxes).every(cb => cb.checked);
                        checkboxes.forEach(cb => cb.checked = !allChecked);
                    });
                }
            });

            // Master Main Section Toggles 
            const staffManagedOpen = "<%= locals.selectedStaff ? 'true' : 'false' %>" === "true";
            const studentManagedOpen = "<%= locals.searchStudentId || (locals.searchedStudents && locals.searchedStudents.length > 0) ? 'true' : 'false' %>" === "true";
            
            if (staffManagedOpen) {
                sessionStorage.setItem('activeAdminSection', 'staffManageSection');
            } else if (studentManagedOpen) {
                sessionStorage.setItem('activeAdminSection', 'studentManageSection');
            } else {
                const savedSection = sessionStorage.getItem('activeAdminSection') || 'studentManageSection';
                toggleSection(savedSection);
            }
        });
    </script>
<%- include('partials/watermark') %>
</body>
</html>