<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CONM Admin Portal - User Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">
    <header class="bg-emerald-950 text-white shadow-md border-b-4 border-pink-500">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div>
                <h2 class="text-base font-bold">City University of Pasay - System Administrator</h2>
                <p class="text-xs text-pink-300">College of Nursing and School of Midwifery (CONM)</p>
            </div>
            <div class="flex items-center space-x-3">
                <span class="text-xs bg-emerald-800 px-3 py-1.5 rounded-full text-emerald-100 font-medium">
                    <%= currentUser.fullName || currentUser.username %> (<%= currentUser.role.toUpperCase() %>)
                </span>
                <a href="/faculty/edit-grades" class="text-xs bg-emerald-700 hover:bg-emerald-600 text-white px-3 py-1.5 rounded font-medium">Open Grade Editor</a>
                <a href="/change-password" class="text-xs bg-slate-700 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">Change Password</a>
                <a href="/logout" class="text-xs bg-pink-600 hover:bg-pink-700 text-white px-3 py-1.5 rounded font-medium">Log Out</a>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-6xl w-full mx-auto p-4 sm:p-6 space-y-8">

        <% if (message) { %>
            <div class="p-4 bg-emerald-100 border border-emerald-400 text-emerald-800 text-xs font-bold rounded-xl shadow-sm">
                ✅ <%= message %>
            </div>
        <% } %>

        <% if (error) { %>
            <div class="p-4 bg-red-100 border border-red-400 text-red-700 text-xs font-bold rounded-xl shadow-sm">
                ⚠️ <%= error %>
            </div>
        <% } %>

        <!-- ==================== FACULTY MANAGEMENT SECTION ==================== -->
        <div class="space-y-4">
            <!-- Register New Faculty -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-900 mb-1">Register New Faculty Member</h3>
                <p class="text-xs text-slate-500 mb-4">Enter the faculty member's full name and login credentials. They will be prompted to update their password on first login.</p>
                
                <form action="/admin/add-faculty" method="POST" class="grid grid-cols-1 sm:grid-cols-6 gap-3 items-end">
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Username / Employee ID</label>
                        <input type="text" name="username" required placeholder="e.g. prof.dizon" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-mono">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">First Name</label>
                        <input type="text" name="first_name" required placeholder="e.g. Roberto" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Middle Name</label>
                        <input type="text" name="middle_name" placeholder="e.g. Gomez" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Last Name</label>
                        <input type="text" name="last_name" required placeholder="e.g. Dizon" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Temp Password</label>
                        <input type="text" name="temp_password" required value="conm2026" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-mono">
                    </div>
                    <div>
                        <button type="submit" class="w-full py-2 bg-pink-600 hover:bg-pink-700 text-white rounded-lg font-bold text-xs shadow transition-colors">
                            + Add Faculty
                        </button>
                    </div>
                </form>
            </div>

            <!-- Faculty Dropdown Selector & Edit Panel -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-5">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
                    <div>
                        <h4 class="font-bold text-emerald-900 text-sm uppercase tracking-wider">Registered Faculty Members (<%= facultyList.length %>)</h4>
                        <p class="text-xs text-slate-500">Select a faculty member from the dropdown list to view, edit, reset password, or delete.</p>
                    </div>

                    <form method="GET" action="/admin" class="w-full sm:w-80">
                        <% if (searchStudentId) { %>
                            <input type="hidden" name="search_student_id" value="<%= searchStudentId %>">
                        <% } %>
                        <select name="faculty_user" onchange="this.form.submit()" class="w-full px-3 py-2.5 rounded-lg border border-slate-300 bg-slate-50 text-xs font-semibold text-slate-700 focus:ring-2 focus:ring-emerald-500">
                            <option value="">-- Select Faculty Member (<%= facultyList.length %> Registered) --</option>
                            <% facultyList.forEach(fac => { 
                                const fullName = [fac.first_name, fac.middle_name, fac.last_name].filter(Boolean).join(' ') || fac.username;
                            %>
                                <option value="<%= fac.username %>" <%= (selectedFaculty && selectedFaculty.username === fac.username) ? 'selected' : '' %>>
                                    <%= fullName %> (<%= fac.username %>)
                                </option>
                            <% }) %>
                        </select>
                    </form>
                </div>

                <% if (selectedFaculty) { %>
                    <div class="bg-emerald-50/70 rounded-xl border border-emerald-200 p-5 space-y-4">
                        <div class="flex flex-wrap justify-between items-center gap-2">
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-bold uppercase text-emerald-900">Editing Faculty Account:</span>
                                <span class="font-mono text-xs font-bold bg-emerald-900 text-white px-2.5 py-0.5 rounded"><%= selectedFaculty.username %></span>
                                <% if (selectedFaculty.must_change_password) { %>
                                    <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-amber-100 text-amber-800">Pending First-Login Password Change</span>
                                <% } else { %>
                                    <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-100 text-emerald-800">Active / Verified</span>
                                <% } %>
                            </div>

                            <div class="flex items-center gap-2">
                                <form action="/admin/reset-user-password" method="POST" class="inline" onsubmit="return confirm('Reset password for <%= selectedFaculty.username %> to default (conm2026)?');">
                                    <input type="hidden" name="username" value="<%= selectedFaculty.username %>">
                                    <input type="hidden" name="role" value="faculty">
                                    <button type="submit" class="px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white rounded-lg text-xs font-bold shadow-sm">
                                        Reset Password
                                    </button>
                                </form>

                                <form action="/admin/delete-user" method="POST" class="inline" onsubmit="return confirm('Permanently delete faculty account <%= selectedFaculty.username %>?');">
                                    <input type="hidden" name="username" value="<%= selectedFaculty.username %>">
                                    <input type="hidden" name="role" value="faculty">
                                    <button type="submit" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-bold shadow-sm">
                                        Delete Faculty
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Edit Faculty Form -->
                        <form action="/admin/edit-faculty" method="POST" class="grid grid-cols-1 sm:grid-cols-5 gap-3 items-end pt-2 border-t border-emerald-200/60">
                            <input type="hidden" name="original_username" value="<%= selectedFaculty.username %>">
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-emerald-900 mb-1">Username / ID</label>
                                <input type="text" name="username" required value="<%= selectedFaculty.username %>" class="w-full px-3 py-2 rounded-lg border border-emerald-300 bg-white text-xs font-mono font-bold text-emerald-950">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-emerald-900 mb-1">First Name</label>
                                <input type="text" name="first_name" required value="<%= selectedFaculty.first_name || '' %>" class="w-full px-3 py-2 rounded-lg border border-emerald-300 bg-white text-xs">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-emerald-900 mb-1">Middle Name</label>
                                <input type="text" name="middle_name" value="<%= selectedFaculty.middle_name || '' %>" class="w-full px-3 py-2 rounded-lg border border-emerald-300 bg-white text-xs">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-emerald-900 mb-1">Last Name</label>
                                <input type="text" name="last_name" required value="<%= selectedFaculty.last_name || '' %>" class="w-full px-3 py-2 rounded-lg border border-emerald-300 bg-white text-xs">
                            </div>
                            <div>
                                <button type="submit" class="w-full py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg font-bold text-xs shadow transition-colors">
                                    💾 Save Faculty Changes
                                </button>
                            </div>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>

        <hr class="border-slate-200">

        <!-- ==================== STUDENT MANAGEMENT SECTION ==================== -->
        <div class="space-y-5">
            <!-- Register New Student Account -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-900 mb-1">Register New Student Account</h3>
                <p class="text-xs text-slate-500 mb-4">Create a student user account along with their official student profile record.</p>
                
                <form action="/admin/add-student" method="POST" class="grid grid-cols-1 sm:grid-cols-7 gap-3 items-end">
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Student ID</label>
                        <input type="text" name="student_id" required placeholder="e.g. 2024-00150" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-mono">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">First Name</label>
                        <input type="text" name="first_name" required placeholder="e.g. Juan" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Middle Name</label>
                        <input type="text" name="middle_name" placeholder="e.g. Reyes" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Last Name</label>
                        <input type="text" name="last_name" required placeholder="e.g. Dela Cruz" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Year Level</label>
                        <select name="year_level" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-medium">
                            <option value="1">1st Year</option>
                            <option value="2" selected>2nd Year</option>
                            <option value="3">3rd Year</option>
                            <option value="4">4th Year</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Temp Password</label>
                        <input type="text" name="temp_password" required value="password123" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-mono">
                    </div>
                    <div>
                        <button type="submit" class="w-full py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg font-bold text-xs shadow transition-colors">
                            + Add Student
                        </button>
                    </div>
                </form>
            </div>

            <!-- Search Bar for Student ID -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 flex flex-col sm:flex-row justify-between items-center gap-4">
                <div>
                    <h4 class="font-bold text-emerald-900 text-sm uppercase tracking-wider">Search Registered Student Accounts by ID</h4>
                    <p class="text-xs text-slate-500">To keep the page fast, students are grouped into the 4 Year Level tables below and only displayed when searched by ID number.</p>
                </div>

                <form method="GET" action="/admin" class="flex items-center gap-2 w-full sm:w-auto">
                    <% if (selectedFaculty) { %>
                        <input type="hidden" name="faculty_user" value="<%= selectedFaculty.username %>">
                    <% } %>
                    <input type="text" name="search_student_id" value="<%= searchStudentId %>" placeholder="Enter Student ID (e.g. 2024-7020)" class="w-full sm:w-64 px-3 py-2 rounded-lg border border-slate-300 text-xs font-mono focus:ring-2 focus:ring-emerald-500">
                    <button type="submit" class="px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-bold shadow">
                        Search ID
                    </button>
                    <% if (searchStudentId) { %>
                        <a href="/admin<%= selectedFaculty ? '?faculty_user=' + encodeURIComponent(selectedFaculty.username) : '' %>" class="px-3 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg text-xs font-bold">
                            Clear
                        </a>
                    <% } %>
                </form>
            </div>

            <!-- 4 YEAR LEVEL STUDENT TABLES (1st Year, 2nd Year, 3rd Year, 4th Year) -->
            <div class="grid grid-cols-1 gap-4">
                <% 
                    const yearLabels = {
                        1: '1st Year Nursing Students (Level 1)',
                        2: '2nd Year Nursing Students (Level 2)',
                        3: '3rd Year Nursing Students (Level 3)',
                        4: '4th Year Nursing Students (Level 4)'
                    };
                %>

                <% [1, 2, 3, 4].forEach(level => { 
                    const levelMatches = searchedStudents.filter(s => Number(s.year_level) === level);
                %>
                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                        <div class="bg-slate-50 px-5 py-3 border-b border-slate-200 flex justify-between items-center">
                            <h4 class="font-bold text-emerald-950 text-xs uppercase tracking-wider">
                                <%= yearLabels[level] %>
                            </h4>
                            <span class="text-xs font-bold bg-emerald-100 text-emerald-800 px-2.5 py-0.5 rounded-full">
                                Total Registered: <%= yearCounts[level] || 0 %>
                            </span>
                        </div>

                        <% if (!searchStudentId) { %>
                            <div class="py-4 px-5 text-xs text-slate-400 italic">
                                Use the Search Student ID bar above to look up a Level <%= level %> student account.
                            </div>
                        <% } else if (levelMatches.length === 0) { %>
                            <div class="py-4 px-5 text-xs text-slate-400">
                                No matching student ID "<span class="font-mono font-semibold text-slate-600"><%= searchStudentId %></span>" in Level <%= level %>.
                            </div>
                        <% } else { %>
                            <div class="divide-y divide-slate-100 p-4 space-y-3">
                                <% levelMatches.forEach(stu => { %>
                                    <div class="bg-slate-50 rounded-lg border border-slate-200 p-4 space-y-3">
                                        <div class="flex flex-wrap justify-between items-center gap-2">
                                            <div class="flex items-center gap-2">
                                                <span class="font-mono font-bold text-sm text-emerald-900"><%= stu.student_id %></span>
                                                <span class="text-xs font-bold text-slate-700">
                                                    — <%= [stu.first_name, stu.middle_name, stu.last_name].filter(Boolean).join(' ') %>
                                                </span>
                                                <% if (stu.must_change_password) { %>
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">Pending Password Change</span>
                                                <% } else { %>
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">Active / Verified</span>
                                                <% } %>
                                            </div>

                                            <div class="flex items-center gap-2">
                                                <a href="/faculty/edit-grades?student_id=<%= stu.student_id %>" class="px-3 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded text-xs font-bold shadow-sm">
                                                    View/Edit Grades
                                                </a>

                                                <form action="/admin/reset-user-password" method="POST" class="inline" onsubmit="return confirm('Reset password for student <%= stu.student_id %> to default (password123)?');">
                                                    <input type="hidden" name="username" value="<%= stu.student_id %>">
                                                    <input type="hidden" name="role" value="student">
                                                    <button type="submit" class="px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white rounded text-xs font-bold shadow-sm">
                                                        Reset Password
                                                    </button>
                                                </form>

                                                <form action="/admin/delete-user" method="POST" class="inline" onsubmit="return confirm('Permanently delete student <%= stu.student_id %> and all their grades?');">
                                                    <input type="hidden" name="username" value="<%= stu.student_id %>">
                                                    <input type="hidden" name="role" value="student">
                                                    <button type="submit" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded text-xs font-bold shadow-sm">
                                                        Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </div>

                                        <!-- Quick Edit Student Form -->
                                        <form action="/admin/edit-student" method="POST" class="grid grid-cols-1 sm:grid-cols-5 gap-2 items-end pt-2 border-t border-slate-200">
                                            <input type="hidden" name="student_id" value="<%= stu.student_id %>">
                                            <div>
                                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">First Name</label>
                                                <input type="text" name="first_name" required value="<%= stu.first_name || '' %>" class="w-full px-2.5 py-1.5 rounded border border-slate-300 bg-white text-xs">
                                            </div>
                                            <div>
                                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Middle Name</label>
                                                <input type="text" name="middle_name" value="<%= stu.middle_name || '' %>" class="w-full px-2.5 py-1.5 rounded border border-slate-300 bg-white text-xs">
                                            </div>
                                            <div>
                                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Last Name</label>
                                                <input type="text" name="last_name" required value="<%= stu.last_name || '' %>" class="w-full px-2.5 py-1.5 rounded border border-slate-300 bg-white text-xs">
                                            </div>
                                            <div>
                                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Year Level</label>
                                                <select name="year_level" class="w-full px-2.5 py-1.5 rounded border border-slate-300 bg-white text-xs font-medium">
                                                    <option value="1" <%= Number(stu.year_level) === 1 ? 'selected' : '' %>>1st Year</option>
                                                    <option value="2" <%= Number(stu.year_level) === 2 ? 'selected' : '' %>>2nd Year</option>
                                                    <option value="3" <%= Number(stu.year_level) === 3 ? 'selected' : '' %>>3rd Year</option>
                                                    <option value="4" <%= Number(stu.year_level) === 4 ? 'selected' : '' %>>4th Year</option>
                                                </select>
                                            </div>
                                            <div>
                                                <button type="submit" class="w-full py-1.5 bg-slate-700 hover:bg-slate-800 text-white rounded font-bold text-xs shadow-sm">
                                                    Save Student Info
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        </div>

    </main>
</body>
</html>