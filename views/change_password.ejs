<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Change Default Password - CONM Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-emerald-900 via-emerald-800 to-pink-900 min-h-screen flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-8 border-t-4 border-pink-600">
        <div class="text-center mb-6">
            <h1 class="text-xl font-bold text-emerald-900">Security Update Required</h1>
            <p class="text-xs text-slate-500 mt-1">You are logging in with a default temporary password. Please update your password to proceed.</p>
        </div>

        <% if (error) { %>
            <div class="mb-4 p-3 bg-red-100 border border-red-400 text-red-700 text-xs rounded"><%= error %></div>
        <% } %>

        <form action="/change-password" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">New Password</label>
                <input type="password" name="new_password" required placeholder="e.g. Nursing@2026" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 text-sm">
                <p class="text-[11px] text-slate-400 mt-1">Must be at least 8 characters long, including uppercase, lowercase, numbers, and special characters.</p>
            </div>
            <button type="submit" class="w-full py-3 rounded-lg bg-pink-600 hover:bg-pink-700 text-white font-semibold text-sm shadow-md transition-colors">
                Update Password & Continue
            </button>
        </form>
    </div>
</body>
</html>