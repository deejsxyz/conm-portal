                        <button type="button" role="tab" data-tab-parent="facultyPanel" data-tab-target="facultyRegSection" aria-selected="false" aria-controls="facultyRegSection" class="sub-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-colors cursor-pointer text-slate-600 hover:text-slate-900">➕ Register Faculty</button>
