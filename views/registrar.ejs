                            <select name="faculty_user" id="facultySelectDropdown" class="w-full px-3 py-2.5 rounded-lg border border-slate-300 bg-slate-50 text-xs font-semibold text-slate-700 focus:ring-2 focus:ring-indigo-500 cursor-pointer">
                                <option value="">-- Select Faculty Member --</option>
                                <% facultyList.forEach(fac => { 
                                    const formalName = [fac.last_name, [fac.first_name, fac.middle_name].filter(Boolean).join(' ')].filter(Boolean).join(', ');
                                %>
                                    <option value="<%= fac.username %>" <%= (locals.selectedFaculty && selectedFaculty.username === fac.username) ? 'selected' : '' %>>
                                        <%= formalName %> (<%= fac.username %>)
                                    </option>
                                <% }) %>
                            </select>
                        </form>
                    </div>

                    <% if (locals.selectedFaculty) { %>
                        <% 
                            const editingFormalName = [selectedFaculty.last_name, [selectedFaculty.first_name, selectedFaculty.middle_name].filter(Boolean).join(' ')].filter(Boolean).join(', ');
                        %>
                        <div class="bg-indigo-50/70 rounded-xl border border-indigo-200 p-5 space-y-4">
                            <div class="flex flex-wrap justify-between items-center gap-2">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-bold uppercase text-indigo-900">Editing Faculty:</span>
                                    <span class="font-bold text-xs bg-indigo-900 text-white px-2.5 py-0.5 rounded"><%= editingFormalName %></span>
                                </div>

                                <form action="/registrar/delete-faculty" method="POST" class="inline confirm-form" data-confirm-msg="Archive faculty account <%= editingFormalName %>?">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="username" value="<%= selectedFaculty.username %>">
                                    <button type="submit" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-bold shadow-sm cursor-pointer">
                                        Archive Faculty
                                    </button>
                                </form>
                            </div>

                            <form action="/registrar/edit-faculty" method="POST" class="space-y-4 pt-2 border-t border-indigo-200/60">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="original_username" value="<%= selectedFaculty.username %>">
                                
                                <div class="grid grid-cols-1 sm:grid-cols-5 gap-3">
                                    <div>
                                        <label class="block text-[10px] uppercase font-bold text-indigo-900 mb-1">Username / ID</label>
                                        <input type="text" name="username" required value="<%= selectedFaculty.username %>" class="w-full px-2.5 py-1.5 rounded border border-indigo-300 bg-white text-xs font-mono font-bold text-indigo-950">
                                    </div>
                                    <div>
                                        <label class="block text-[10px] uppercase font-bold text-indigo-900 mb-1">First Name</label>
                                        <input type="text" name="first_name" required value="<%= selectedFaculty.first_name || '' %>" class="w-full px-2.5 py-1.5 rounded border border-indigo-300 bg-white text-xs">
                                    </div>
                                    <div>
                                        <label class="block text-[10px] uppercase font-bold text-indigo-900 mb-1">Middle Name</label>
                                        <input type="text" name="middle_name" value="<%= selectedFaculty.middle_name || '' %>" class="w-full px-2.5 py-1.5 rounded border border-indigo-300 bg-white text-xs">
                                    </div>
                                    <div>
                                        <label class="block text-[10px] uppercase font-bold text-indigo-900 mb-1">Last Name</label>
                                        <input type="text" name="last_name" required value="<%= selectedFaculty.last_name || '' %>" class="w-full px-2.5 py-1.5 rounded border border-indigo-300 bg-white text-xs">
                                    </div>
                                    <div>
                                        <label class="block text-[10px] uppercase font-bold text-amber-600 mb-1">Reset Password?</label>
                                        <div class="flex">
                                            <input type="text" name="temp_password" placeholder="Leave blank" class="w-full px-2.5 py-1.5 rounded border border-amber-300 bg-amber-50 text-[11px] font-mono">
                                        </div>
                                    </div>
                                </div>

                                <div class="pt-2">
                                    <label class="block text-[11px] uppercase font-bold text-indigo-900 mb-2">Assigned Subjects Taught</label>
                                    <div id="editFacultyDropdownsContainer" class="space-y-2"></div>
                                    <button type="button" id="addEditFacultySlotBtn" class="mt-3 px-4 py-2 bg-indigo-200 hover:bg-indigo-300 text-indigo-800 rounded-lg text-xs font-bold transition-colors cursor-pointer">
                                        Add Subject Slot
                                    </button>
                                </div>

                                <div class="flex justify-end gap-2 pt-2 border-t border-indigo-200/60">
                                    <a href="/registrar" class="px-5 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded font-bold text-xs shadow-sm flex items-center">Cancel</a>
                                    <button type="submit" class="px-6 py-2 bg-indigo-700 hover:bg-indigo-800 text-white rounded font-bold text-xs shadow-sm cursor-pointer">
                                        💾 Save Faculty Profile
                                    </button>
                                </div>
                            </form>
                        </div>
                    <% } %>
                </div>

                <div id="facultyRegSection" class="hidden bg-white rounded-xl shadow-sm border border-slate-200 p-5 space-y-4">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-900 mb-1">Register New Faculty Account & Assign Subjects</h3>
                    <form action="/registrar/add-faculty" method="POST" class="space-y-4 text-sm">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="grid grid-cols-1 sm:grid-cols-5 gap-3">
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Username</label>
                                <input type="text" name="username" required placeholder="e.g. prof.dizon" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-mono">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Temp Password</label>
                                <input type="text" id="regFacultyTempPassword" name="temp_password" required class="w-full px-3 py-2 rounded-lg border border-indigo-400 bg-indigo-50 text-xs font-mono font-bold text-indigo-900">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">First Name</label>
                                <input type="text" name="first_name" required placeholder="First Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Middle Name</label>
                                <input type="text" name="middle_name" placeholder="Middle Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Last Name</label>
                                <input type="text" name="last_name" required placeholder="Last Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                            </div>
                        </div>

                        <div class="pt-2 border-t border-slate-100">
                            <label class="block text-[11px] uppercase font-bold text-indigo-900 mb-2">Assign Subjects Taught (Up to 5 Default + Add More)</label>
                            <div id="facultySubjectDropdownsContainer" class="space-y-2"></div>
                            <button type="button" id="addFacultySlotBtn" class="mt-3 px-4 py-2 bg-pink-100 hover:bg-pink-200 text-pink-700 rounded-lg text-xs font-bold transition-colors cursor-pointer">
                                Add Subject Slot
                            </button>
                        </div>

                        <div class="flex gap-3 pt-3 border-t border-slate-100">
                            <button type="button" data-close-panel="facultyPanel" class="cancel-toggle-btn w-1/4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg font-bold text-xs shadow transition-colors cursor-pointer">Cancel</button>
                            <button type="submit" class="w-3/4 py-2 bg-pink-600 hover:bg-pink-700 text-white rounded-lg font-bold text-xs shadow transition-colors cursor-pointer">
                                + Register Faculty & Save Assigned Subjects
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- BATCH UPLOAD CSV FORM -->
            <div id="batchUploadSection" class="hidden bg-white rounded-xl shadow-sm border border-emerald-200 p-6 space-y-4">
                <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-900 mb-1">Batch Upload & Enroll Students</h3>
                <p class="text-xs text-slate-500 mb-2">Export your Google Form responses as a <strong>.csv</strong> file (max 300 rows per upload). Include <code class="text-pink-600 font-bold">section</code> (A, B, or C) and an optional <code class="text-pink-600 font-bold">instructor</code> column.</p>
                
                <div class="p-4 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-700">
                    <strong class="text-emerald-900 uppercase tracking-wider">Required Form/CSV Column Headers:</strong><br>
                    <code class="block mt-1 font-mono text-pink-600 font-bold bg-white p-2 border border-slate-200 rounded">student_id, first_name, middle_name, last_name, year_level, section, semester, academic_year, subjects, instructor</code>
                </div>

                <form action="/registrar/batch-upload" method="POST" enctype="multipart/form-data" class="flex flex-col sm:flex-row items-center gap-4">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="file" name="file" accept=".csv" required class="w-full sm:w-auto px-4 py-2 border border-slate-300 rounded-lg text-sm bg-slate-50 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-bold file:bg-emerald-100 file:text-emerald-700 hover:file:bg-emerald-200">
                    
                    <button type="submit" class="w-full sm:w-auto px-6 py-3 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-bold shadow-md transition-colors cursor-pointer">
                        Upload & Process CSV
                    </button>
                </form>

                <% if (locals.hasBatchCredentials) { %>
                    <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-lg flex flex-col sm:flex-row items-center justify-between gap-3">
                        <span class="text-xs font-bold text-emerald-900">✅ New student passwords generated! (One-time download for security)</span>
                        <a href="/registrar/export-batch-credentials" class="px-5 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-bold shadow transition-colors whitespace-nowrap">
                            📥 Download Passwords CSV
                        </a>
                    </div>
                <% } %>
            </div>

            <div id="lockedAccountsPanel" class="hidden bg-white rounded-xl shadow-sm border border-red-200 p-6 space-y-4">
                <h3 class="text-sm font-bold uppercase tracking-wider text-red-800 mb-1">Locked Accounts</h3>
                <p class="text-xs text-slate-500">Accounts are locked after repeated failed sign-ins. Confirm the person's identity in person (or by official means) before resetting. Leave the password blank to generate one; it is shown once.</p>
                <% if (lockedList.length === 0) { %>
                    <div class="text-center py-6 text-xs text-slate-400 italic border border-dashed border-slate-200 rounded-lg">No locked accounts.</div>
                <% } else { %>
                    <div class="overflow-x-auto border border-slate-200 rounded-lg">
                        <table class="w-full text-left text-xs">
                            <thead>
                                <tr class="bg-slate-100 text-slate-600 uppercase text-[10px] tracking-wider">
                                    <th class="p-2.5">Username</th>
                                    <th class="p-2.5">Name</th>
                                    <th class="p-2.5">Role</th>
                                    <th class="p-2.5">Locked At</th>
                                    <th class="p-2.5">Reset &amp; Unlock</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-200">
                                <% lockedList.forEach(acc => { %>
                                    <tr>
                                        <td class="p-2.5 font-mono font-bold"><%= acc.username %></td>
                                        <td class="p-2.5"><%= [acc.last_name, [acc.first_name, acc.middle_name].filter(Boolean).join(' ')].filter(Boolean).join(', ') || '---' %></td>
                                        <td class="p-2.5 uppercase font-bold text-slate-500"><%= acc.role %></td>
                                        <td class="p-2.5 text-slate-500"><%= acc.locked_at ? new Date(acc.locked_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) : '---' %></td>
                                        <td class="p-2.5">
                                            <form action="/registrar/unlock-account" method="POST" class="flex flex-col lg:flex-row lg:items-center gap-2">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="username" value="<%= acc.username %>">
                                                <input type="text" name="temp_password" placeholder="New temp password (optional)" autocomplete="off" class="px-2 py-1.5 rounded border border-slate-300 text-xs font-mono w-full lg:w-52">
                                                <label class="flex items-center gap-1.5 text-[11px] text-slate-600 whitespace-nowrap">
                                                    <input type="checkbox" name="verified" value="yes" required> Identity verified
                                                </label>
                                                <button type="submit" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded text-[11px] font-bold cursor-pointer whitespace-nowrap">Reset &amp; Unlock</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

    </main>

    <!-- XSS-SAFE JSON SCRIPT BLOCKS WITH NONCE -->
    <script id="courses-data" type="application/json" nonce="<%= cspNonce %>">
        <%- JSON.stringify(locals.allCoursesRaw || []).replace(/</g, '\\u003c') %>
    </script>
    <script id="faculty-list-data" type="application/json" nonce="<%= cspNonce %>">
        <%- JSON.stringify(locals.facultyList || []).replace(/</g, '\\u003c') %>
    </script>
    <script id="faculty-assigned-data" type="application/json" nonce="<%= cspNonce %>">
        <%- JSON.stringify(locals.facultyAssignedCourses || []).replace(/</g, '\\u003c') %>
    </script>
    <script nonce="<%= cspNonce %>">
        const allCoursesData = JSON.parse(document.getElementById('courses-data').textContent);
        const facultyListData = JSON.parse(document.getElementById('faculty-list-data').textContent);
        const facultyAssignedData = JSON.parse(document.getElementById('faculty-assigned-data').textContent);
        
        function escapeHtml(str) {
            return String(str ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        const PANEL_IDS = ['studentPanel', 'facultyPanel', 'batchUploadSection', 'lockedAccountsPanel'];
        const SUB_PANELS = {
            studentPanel: ['studentManageSection', 'studentRegSection'],
            facultyPanel: ['facultyManageSection', 'facultyRegSection']
        };
        const NAV_OPEN_CLASSES = ['ring-2', 'ring-offset-2', 'ring-slate-700'];
        const TAB_ACTIVE = ['bg-white', 'text-indigo-900', 'shadow'];
        const TAB_INACTIVE = ['text-slate-600', 'hover:text-slate-900'];

        function syncToggleButtons() {
            document.querySelectorAll('.nav-toggle-btn').forEach(btn => {
                const panel = document.getElementById(btn.getAttribute('data-target-section'));
                if (!panel) return;
                const open = !panel.classList.contains('hidden');
                btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                NAV_OPEN_CLASSES.forEach(c => btn.classList.toggle(c, open));
                const arrow = btn.querySelector('.toggle-arrow');
                if (arrow) arrow.textContent = open ? '▲' : '▼';
            });
        }

        function showTab(parentId, subId) {
            const subs = SUB_PANELS[parentId];
            if (!subs) return;
            const target = subs.includes(subId) ? subId : subs[0];
            subs.forEach(id => {
                const el = document.getElementById(id);
                if (el) el.classList.toggle('hidden', id !== target);
            });
            document.querySelectorAll('[data-tab-parent="' + parentId + '"]').forEach(tab => {
                const active = tab.getAttribute('data-tab-target') === target;
                tab.setAttribute('aria-selected', active ? 'true' : 'false');
                TAB_ACTIVE.forEach(c => tab.classList.toggle(c, active));
                TAB_INACTIVE.forEach(c => tab.classList.toggle(c, !active));
            });
        }

        function showSection(sectionId, subId) {
            PANEL_IDS.forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                if (id === sectionId) el.classList.remove('hidden');
                else el.classList.add('hidden');
            });
            if (subId && SUB_PANELS[sectionId]) showTab(sectionId, subId);
            syncToggleButtons();
        }

        function toggleSection(sectionId) {
            const el = document.getElementById(sectionId);
            if (!el) return;
            if (el.classList.contains('hidden')) {
                showSection(sectionId);
            } else {
                el.classList.add('hidden');
                syncToggleButtons();
            }
        }

        function rememberPanel(id, sub) {
            try { sessionStorage.setItem('reopenRegistrarPanel', JSON.stringify({ id: id, sub: sub || null, t: Date.now() })); } catch (e) {}
        }

        function updateSubjectChecklist() {
            const yearSelect = document.getElementById('reg_year_select');
            const semSelect = document.getElementById('reg_sem_select');
            const container = document.getElementById('subjectChecklist');
            const hiddenTerm = document.getElementById('reg_term_hidden');
            
            if (!yearSelect || !semSelect || !yearSelect.value || !semSelect.value) return;

            const year = parseInt(yearSelect.value);
            const sem = parseInt(semSelect.value);
            const selectedTerm = (year - 1) * 2 + sem;
            
            if (hiddenTerm) hiddenTerm.value = selectedTerm;

            const termNames = {
                "1": "BSN1 - 1st Sem", "2": "BSN1 - 2nd Sem", 
                "3": "BSN2 - 1st Sem", "4": "BSN2 - 2nd Sem", 
                "5": "BSN3 - 1st Sem", "6": "BSN3 - 2nd Sem",
                "7": "BSN4 - 1st Sem", "8": "BSN4 - 2nd Sem"
            };

            let facultyOptionsHtml = '<option value="" style="font-style: italic;">-- Select Instructor (Optional) --</option>';
            facultyListData.forEach(fac => {
                const facName = [fac.last_name, [fac.first_name, fac.middle_name].filter(Boolean).join(' ')].filter(Boolean).join(', ');
                facultyOptionsHtml += `<option value="${escapeHtml(fac.username)}">${escapeHtml(facName)}</option>`;
            });

            let html = '<div class="max-h-[400px] overflow-y-auto pr-2 space-y-4">';
            for (let i = 1; i <= 8; i++) {
                const termCourses = allCoursesData.filter(c => String(c.term_id) === String(i));
                if (termCourses.length === 0) continue;

                const isCurrentTermGroup = String(i) === String(selectedTerm);
                html += `<div class="bg-white p-3 rounded-lg border ${isCurrentTermGroup ? 'border-indigo-400 bg-indigo-50/40' : 'border-slate-200'} shadow-sm">`;
                html += `<h4 class="text-[11px] font-bold uppercase tracking-wider ${isCurrentTermGroup ? 'text-indigo-800' : 'text-slate-500'} mb-2 border-b ${isCurrentTermGroup ? 'border-indigo-200' : 'border-slate-100'} pb-1">${escapeHtml(termNames[i])} ${isCurrentTermGroup ? '(Standard Set)' : ''}</h4>`;
                html += `<div class="space-y-2">`;
                
                termCourses.forEach(c => {
                    const isAutoChecked = isCurrentTermGroup ? 'checked' : '';
                    html += `
                        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-2 rounded hover:bg-slate-100 gap-2 border border-slate-100">
                            <label class="flex items-center space-x-2 cursor-pointer flex-grow">
                                <input type="checkbox" name="course_codes" value="${escapeHtml(c.course_code)}" ${isAutoChecked} class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
                                <span class="text-[11px] font-semibold text-slate-700">[${escapeHtml(c.course_code)}] ${escapeHtml(c.descriptive_title)}</span>
                            </label>
                            <div class="w-full sm:w-64">
                                <select name="instructor__${escapeHtml(c.course_code)}" class="w-full px-2 py-1 rounded border border-slate-300 bg-white text-[11px] font-medium text-slate-700 cursor-pointer">
                                    ${facultyOptionsHtml}
                                </select>
                            </div>
                        </div>
                    `;
                });
                html += `</div></div>`;
            }
            html += '</div>';
            container.innerHTML = html;
        }

        function addExtraEnrollmentDropdown() {
            const container = document.getElementById('extraEnrollmentSubjectsContainer');
            if (!container) return;

            const div = document.createElement('div');
            div.className = 'flex flex-col sm:flex-row gap-2 mt-2 p-3 rounded-lg bg-indigo-50/50 border border-indigo-200 items-start sm:items-center';
            
            let optionsHtml = '<option value="">--Select Subject--</option>';
            allCoursesData.forEach(c => {
                optionsHtml += `<option value="${escapeHtml(c.course_code)}">[${escapeHtml(c.course_code)}] ${escapeHtml(c.descriptive_title)}</option>`;
            });

            let facHtml = '<option value="" style="font-style: italic;">--Select Instructor (Optional)--</option>';
            facultyListData.forEach(fac => {
                const facName = [fac.last_name, [fac.first_name, fac.middle_name].filter(Boolean).join(' ')].filter(Boolean).join(', ');
                facHtml += `<option value="${escapeHtml(fac.username)}">${escapeHtml(facName)}</option>`;
            });

            div.innerHTML = `
                <div class="flex-grow w-full">
                    <select name="course_codes" required class="w-full px-2 py-1.5 rounded border border-slate-300 text-xs font-medium text-slate-700 bg-white cursor-pointer">
                        ${optionsHtml}
                    </select>
                </div>
                <div class="w-full sm:w-64">
                    <select class="w-full px-2 py-1.5 rounded border border-slate-300 text-xs font-medium text-slate-700 bg-white cursor-pointer">
                        ${facHtml}
                    </select>
                </div>
                <button type="button" class="remove-extra-row-btn px-2.5 py-1.5 bg-red-100 text-red-700 font-bold rounded hover:bg-red-200 text-xs cursor-pointer">X</button>
            `;
            
            const removeRowBtn = div.querySelector('.remove-extra-row-btn');
            if (removeRowBtn) removeRowBtn.addEventListener('click', () => div.remove());

            const courseSelect = div.querySelector('select[name="course_codes"]');
            const instSelect = div.querySelectorAll('select')[1];
            courseSelect.addEventListener('change', function() {
                if (this.value) {
                    instSelect.name = 'instructor__' + this.value;
                } else {
                    instSelect.name = '';
                }
            });
            
            container.appendChild(div);
        }

        function addFacultySubjectDropdown(containerId, selectedValue = '') {
            const container = document.getElementById(containerId);
            if (!container) return;

            const div = document.createElement('div');
            div.className = 'flex items-center gap-2';

            let optionsHtml = '<option value="" style="font-style: italic;">--Select Subject--</option>';
            allCoursesData.forEach(c => {
                const selected = c.course_code === selectedValue ? 'selected' : '';
                optionsHtml += `<option value="${escapeHtml(c.course_code)}" ${selected}>[${escapeHtml(c.course_code)}] ${escapeHtml(c.descriptive_title)}</option>`;
            });

            div.innerHTML = `
                <select name="course_codes" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-white text-xs font-medium focus:ring-2 focus:ring-indigo-500 cursor-pointer">
                    ${optionsHtml}
                </select>
                <button type="button" class="remove-slot-btn px-3 py-2 bg-red-100 hover:bg-red-200 text-red-700 rounded-lg text-xs font-bold transition-colors cursor-pointer">X</button>
            `;
            container.appendChild(div);
        }

        function initFacultySubjectDropdowns() {
            const regContainer = document.getElementById('facultySubjectDropdownsContainer');
            if (regContainer) {
                regContainer.innerHTML = '';
                for (let i = 0; i < 5; i++) {
                    addFacultySubjectDropdown('facultySubjectDropdownsContainer');
                }
            }

            const editContainer = document.getElementById('editFacultyDropdownsContainer');
            if (editContainer && facultyAssignedData) {
                editContainer.innerHTML = '';
                if (facultyAssignedData.length > 0) {
                    facultyAssignedData.forEach(code => {
                        addFacultySubjectDropdown('editFacultyDropdownsContainer', code);
                    });
                } else {
                    for (let i = 0; i < 5; i++) {
                        addFacultySubjectDropdown('editFacultyDropdownsContainer');
                    }
                }
            }
        }

        const searchInput = document.getElementById('studentSearchInput');
        if (searchInput) {
            searchInput.addEventListener('click', function() {
                this.value = '';
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Auto-hide flash alerts after 2 seconds
            setTimeout(() => {
                document.querySelectorAll('.flash-alert').forEach(el => {
                    el.style.transition = 'opacity 0.5s ease-out';
                    el.style.opacity = '0';
                    setTimeout(() => el.remove(), 500);
                });
            }, 2000);

            // NEW LOGS DROPDOWN LOGIC
            const logsBtn = document.getElementById('logsDropdownBtn');
            const logsMenu = document.getElementById('logsDropdownMenu');
            if (logsBtn && logsMenu) {
                logsBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    logsMenu.classList.toggle('hidden');
                });
                document.addEventListener('click', (e) => {
                    if (!logsBtn.contains(e.target) && !logsMenu.contains(e.target)) {
                        logsMenu.classList.add('hidden');
                    }
                });
            }

            document.querySelectorAll('.nav-toggle-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    toggleSection(btn.getAttribute('data-target-section'));
                });
            });

            document.querySelectorAll('.cancel-toggle-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    toggleSection(btn.getAttribute('data-close-panel'));
                });
            });

            document.querySelectorAll('.sub-tab-btn').forEach(tab => {
                tab.addEventListener('click', () => {
                    showTab(tab.getAttribute('data-tab-parent'), tab.getAttribute('data-tab-target'));
                });
            });

            document.querySelectorAll('.confirm-form').forEach(form => {
                form.addEventListener('submit', (e) => {
                    const msg = form.getAttribute('data-confirm-msg');
                    if (msg && !confirm(msg)) {
                        e.preventDefault();
                    }
                });
            });

            const PASSING_GRADES = ['1.00', '1.25', '1.50', '1.75', '2.00', '2.25', '2.50', '2.75', '3.00'];
            document.querySelectorAll('.grade-select-box').forEach(sel => {
                sel.addEventListener('change', () => {
                    const out = document.getElementById('remark_' + sel.getAttribute('data-index'));
                    if (!out) return;
                    const g = sel.value;
                    if (PASSING_GRADES.includes(g)) out.value = 'PASSED';
                    else if (g === '4.00') out.value = 'CONDITIONAL';
                    else if (g === '5.00') out.value = 'FAILED';
                    else if (g === 'X') out.value = 'DROPPED';
                    else if (g === 'INC') out.value = 'INCOMPLETE';
                    else if (g === 'W') out.value = 'WITHDRAWN';
                    else if (g === 'NG') out.value = 'NO GRADE';
                    else out.value = '';
                });
            });

            const addExtraBtn = document.getElementById('addExtraSubjectBtn');
            if (addExtraBtn) addExtraBtn.addEventListener('click', addExtraEnrollmentDropdown);

            document.querySelectorAll('.delete-grade-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    if (confirm(btn.getAttribute('data-confirm-msg'))) {
                        const delForm = document.getElementById(btn.getAttribute('data-delete-form'));
                        if (delForm) delForm.submit();
                    }
                });
            });

            document.addEventListener('click', (e) => {
                const slotBtn = e.target && e.target.closest ? e.target.closest('.remove-slot-btn') : null;
                if (slotBtn && slotBtn.parentElement) slotBtn.parentElement.remove();
            });

            const lookupApiBtn = document.getElementById('lookupStudentApiBtn');
            const studentIdInput = document.getElementById('regStudentIdInput');
            const firstNameInput = document.getElementById('regFirstNameInput');
            const middleNameInput = document.getElementById('regMiddleNameInput');
            const lastNameInput = document.getElementById('regLastNameInput');
            const yearLevelSelect = document.getElementById('reg_year_select');
            const sectionSelect = document.getElementById('reg_section_select');
            const msgContainer = document.getElementById('lookupMessageContainer');
            const immContainer = document.getElementById('registerImmunizationContainer');
            const immGrid = document.getElementById('registerImmunizationGrid');

            async function performAsyncLookup() {
                const idVal = studentIdInput ? studentIdInput.value.trim() : '';
                if (!idVal) return;

                try {
                    const response = await fetch(`/registrar/api/lookup-student?student_id=${encodeURIComponent(idVal)}`);
                    const data = await response.json();

                    msgContainer.classList.remove('hidden');
                    if (data && data.exists) {
                        firstNameInput.value = data.student.first_name || '';
                        middleNameInput.value = data.student.middle_name || '';
                        lastNameInput.value = data.student.last_name || '';
                        yearLevelSelect.value = data.student.year_level || '1';
                        sectionSelect.value = data.student.section || 'A';
                        updateSubjectChecklist();

                        msgContainer.className = 'mb-3 p-3 text-xs font-bold rounded-lg text-center bg-emerald-100 text-emerald-800 border border-emerald-300';
                        msgContainer.textContent = `✅ Student found: ${data.student.last_name}, ${data.student.first_name}. Details loaded below. You may enroll.`;

                        if (data.immunization && data.immunization.length > 0) {
                            immContainer.classList.remove('hidden');
                            let immHtml = '';
                            data.immunization.forEach(v => {
                                immHtml += `
                                    <div class="bg-white border border-slate-200 rounded-lg p-3 space-y-2 text-xs flex flex-col justify-between">
                                        <div class="space-y-1">
                                            <div class="flex justify-between items-center font-bold">
                                                <span>${escapeHtml(v.name)}</span>
                                                <span class="px-2 py-0.5 border rounded-full text-[9px] uppercase ${escapeHtml(v.status_cls)}">${escapeHtml(v.status)}</span>
                                            </div>
                                            <p class="text-slate-600 text-[11px]">Progress: <strong>Dose ${v.dose_number} of ${v.doses_required}</strong></p>
                                        </div>
                                    </div>
                                `;
                            });
                            immGrid.innerHTML = immHtml;
                        } else {
                            immContainer.classList.add('hidden');
                        }
                    } else {
                        msgContainer.className = 'mb-3 p-3 text-xs font-bold rounded-lg text-center bg-amber-100 text-amber-800 border border-amber-300';
                        msgContainer.textContent = '⚠️ No student record. Please register/enroll.';
                        immContainer.classList.add('hidden');
                    }
                } catch (err) {
                    console.error('Lookup fetch error:', err);
                }
            }

            if (lookupApiBtn && studentIdInput) {
                lookupApiBtn.addEventListener('click', performAsyncLookup);
                studentIdInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        performAsyncLookup();
                    }
                });
            }

            const regYear = document.getElementById('reg_year_select');
            const regSem = document.getElementById('reg_sem_select');
            if (regYear) regYear.addEventListener('change', updateSubjectChecklist);
            if (regSem) regSem.addEventListener('change', updateSubjectChecklist);

            const facDropdown = document.getElementById('facultySelectDropdown');
            if (facDropdown) {
                facDropdown.addEventListener('change', (e) => {
                    e.target.form.submit();
                });
            }

            const facPass = document.getElementById('regFacultyTempPassword');
            const stuPass = document.getElementById('regStudentTempPassword');
            if (facPass && !facPass.value) facPass.value = generateRandomPassword();
            if (stuPass && !stuPass.disabled && !stuPass.value) stuPass.value = generateRandomPassword();
            
            updateSubjectChecklist();
            initFacultySubjectDropdowns();
            
            const facultyManagedOpen = "<%= locals.selectedFaculty ? 'true' : 'false' %>" === "true";
            const studentManagedOpen = "<%= locals.selectedStudent ? 'true' : 'false' %>" === "true";
            
            PANEL_IDS.forEach(id => {
                const panel = document.getElementById(id);
                if (!panel) return;
                const subs = SUB_PANELS[id] || [];
                const subOf = (node) => subs.find(sid => {
                    const s = document.getElementById(sid);
                    return s && s.contains(node);
                }) || null;

                panel.querySelectorAll('form').forEach(f => {
                    f.addEventListener('submit', () => rememberPanel(id, subOf(f)));
                });
                panel.querySelectorAll('a[href="/registrar"]').forEach(a => {
                    a.addEventListener('click', () => rememberPanel(id, subs[0] || null));
                });
            });

            let pendingPanel = null;
            let pendingSub = null;
            try {
                const raw = sessionStorage.getItem('reopenRegistrarPanel');
                sessionStorage.removeItem('reopenRegistrarPanel');
                if (raw) {
                    const p = JSON.parse(raw);
                    if (p && (Date.now() - p.t) < 30000) { pendingPanel = p.id; pendingSub = p.sub || null; }
                }
            } catch (e) {}

            if (!facultyManagedOpen && !studentManagedOpen && pendingPanel && PANEL_IDS.includes(pendingPanel)) {
                showSection(pendingPanel, pendingSub);
            }
            syncToggleButtons();
        });

        function secureRandInt(max) {
            const arr = new Uint32Array(1);
            window.crypto.getRandomValues(arr);
            return arr[0] % max;
        }

        function generateRandomPassword() {
            const upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
            const lower = 'abcdefghijklmnopqrstuvwxyz';
            const num = '0123456789';
            const special = '!@#$%^&*';
            const all = upper + lower + num + special;
            
            const firstChar = secureRandInt(2) === 0 
                ? upper[secureRandInt(upper.length)] 
                : lower[secureRandInt(lower.length)];
            
            let pass = [
                upper[secureRandInt(upper.length)],
                lower[secureRandInt(lower.length)],
                num[secureRandInt(num.length)],
                special[secureRandInt(special.length)]
            ];
            for (let i = 0; i < 5; i++) {
                pass.push(all[secureRandInt(all.length)]);
            }
            for (let i = pass.length - 1; i > 0; i--) {
                const j = secureRandInt(i + 1);
                [pass[i], pass[j]] = [pass[j], pass[i]];
            }
            return firstChar + pass.join('');
        }
    </script>
