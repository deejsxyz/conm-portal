<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CONM Registrar Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">
    <header class="bg-indigo-900 text-white shadow-md border-b-4 border-pink-500">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div>
                <h2 class="text-base font-bold">City University of Pasay - Registrar Portal</h2>
                <p class="text-xs text-pink-300">College of Nursing and School of Midwifery (CONM)</p>
            </div>
            <div class="flex items-center space-x-3">
                <span class="text-xs bg-indigo-800 px-3 py-1.5 rounded-full text-indigo-100 font-medium">
                    <%= currentUser.fullName || currentUser.username %>
                </span>
                <% if (currentUser.role === 'admin') { %>
                    <a href="/admin" class="text-xs bg-amber-500 hover:bg-amber-600 text-white px-3 py-1.5 rounded font-bold">Admin Panel</a>
                <% } %>
                <a href="/change-password" class="text-xs bg-slate-700 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">Change Password</a>
                <a href="/logout" class="text-xs bg-pink-600 hover:bg-pink-700 text-white px-3 py-1.5 rounded font-medium">Log Out</a>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-6xl w-full mx-auto p-4 sm:p-6 space-y-6">
        
        <% if (locals.message) { %>
            <div style="background: #d4edda; color: #155724; padding: 12px 20px; border-radius: 6px; border: 1px solid #c3e6cb; font-weight: 500; text-align: center; margin-bottom: 1rem;">
                <%= message %>
            </div>
        <% } %>

        <% if (locals.error) { %>
            <div style="background: #f8d7da; color: #721c24; padding: 12px 20px; border-radius: 6px; border: 1px solid #f5c6cb; font-weight: 500; text-align: center; margin-bottom: 1rem;">
                <%= error %>
            </div>
        <% } %>

        <!-- GLOBAL SYSTEM SETTINGS (Controls Faculty View) -->
        <div class="bg-indigo-50 border border-indigo-200 shadow-sm rounded-xl p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
                <h3 class="font-bold text-indigo-900 text-sm uppercase tracking-wider">Global System Settings</h3>
                <p class="text-xs text-indigo-700 mt-1">Set the active Academic Year and Semester. This locks the Faculty Portal so instructors can only view and edit grades for this exact period.</p>
            </div>
            <form action="/registrar/update-settings" method="POST" class="flex gap-2 items-center w-full sm:w-auto">
                <select name="current_ay" class="px-3 py-2 rounded-lg border border-indigo-300 text-xs font-bold text-indigo-900 bg-white">
                    <option value="2026-2027" <%= systemSettings.current_ay === '2026-2027' ? 'selected' : '' %>>A.Y. 2026-2027</option>
                    <option value="2027-2028" <%= systemSettings.current_ay === '2027-2028' ? 'selected' : '' %>>A.Y. 2027-2028</option>
                    <option value="2028-2029" <%= systemSettings.current_ay === '2028-2029' ? 'selected' : '' %>>A.Y. 2028-2029</option>
                    <option value="2029-2030" <%= systemSettings.current_ay === '2029-2030' ? 'selected' : '' %>>A.Y. 2029-2030</option>
                </select>
                <select name="current_semester" class="px-3 py-2 rounded-lg border border-indigo-300 text-xs font-bold text-indigo-900 bg-white">
                    <option value="1" <%= systemSettings.current_semester === 1 ? 'selected' : '' %>>1st Semester</option>
                    <option value="2" <%= systemSettings.current_semester === 2 ? 'selected' : '' %>>2nd Semester</option>
                </select>
                <button type="submit" class="px-5 py-2 bg-indigo-700 hover:bg-indigo-800 text-white rounded-lg text-xs font-bold shadow-md transition-colors">Apply System-Wide</button>
            </form>
        </div>

        <!-- TOGGLE BUTTONS FOR ACCOUNT REGISTRATION -->
        <div class="flex flex-wrap gap-4">
            <button type="button" onclick="toggleSection('studentRegSection')" class="px-6 py-3 bg-indigo-700 hover:bg-indigo-800 text-white rounded-xl text-sm font-bold shadow-md transition-colors flex items-center gap-2">
                👤 Register Single Student
            </button>
            <button type="button" onclick="toggleSection('batchUploadSection')" class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-bold shadow-md transition-colors flex items-center gap-2">
                📁 Batch Upload (Google Form CSV)
            </button>
            <button type="button" onclick="toggleSection('facultyRegSection')" class="px-6 py-3 bg-pink-600 hover:bg-pink-700 text-white rounded-xl text-sm font-bold shadow-md transition-colors flex items-center gap-2">
                👨‍🏫 Register New Faculty
            </button>
        </div>

        <!-- ACCOUNT REGISTRATION FORMS (HIDDEN BY DEFAULT) -->
        <div class="space-y-4">
            
            <!-- BATCH UPLOAD CSV FORM -->
            <div id="batchUploadSection" class="hidden bg-white rounded-xl shadow-sm border border-emerald-200 p-6">
                <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-900 mb-2">Batch Upload & Enroll Students</h3>
                <p class="text-xs text-slate-500 mb-4">Export your Google Form responses as a <strong>.csv</strong> file. The system will auto-generate secure passwords and enroll all selected subjects based on the student's Year, Semester, and Academic Year.</p>
                
                <div class="mb-5 p-4 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-700">
                    <strong class="text-emerald-900 uppercase tracking-wider">Required Form/CSV Column Headers:</strong><br>
                    <code class="block mt-1 font-mono text-pink-600 font-bold bg-white p-2 border border-slate-200 rounded">student_id, first_name, middle_name, last_name, year_level, semester, academic_year, subjects</code>
                    
                    <div class="mt-3 text-[11px] text-slate-500">
                        <strong>Formatting Rules:</strong>
                        <ul class="list-disc pl-4 mt-1 space-y-1">
                            <li><strong>academic_year:</strong> Must be formatted like <code class="bg-slate-200 px-1 rounded">2026-2027</code>.</li>
                            <li><strong>year_level:</strong> Use 1, 2, 3, or 4.</li>
                            <li><strong>semester:</strong> Use 1 (for 1st Sem) or 2 (for 2nd Sem).</li>
                        </ul>
                    </div>
                </div>

                <form action="/registrar/batch-upload" method="POST" enctype="multipart/form-data" class="flex flex-col sm:flex-row items-center gap-4">
                    <input type="file" name="file" accept=".csv" required class="w-full sm:w-auto px-4 py-2 border border-slate-300 rounded-lg text-sm bg-slate-50 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-bold file:bg-emerald-100 file:text-emerald-700 hover:file:bg-emerald-200">
                    
                    <button type="submit" class="w-full sm:w-auto px-6 py-3 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-sm font-bold shadow-md transition-colors">
                        Upload & Process CSV
                    </button>
                </form>
            </div>

            <!-- Dynamic Register & Enroll Student Form -->
            <div id="studentRegSection" class="hidden bg-white rounded-xl shadow-sm border border-slate-200 p-5 <%= selectedStudent ? 'opacity-50 pointer-events-none' : '' %>">
                <h3 class="text-sm font-bold uppercase tracking-wider text-indigo-900 mb-3">Register Account & Enroll Single Student</h3>
                <form action="/registrar/add-student" method="POST" class="space-y-4 text-sm">
                    <div class="grid grid-cols-1 sm:grid-cols-5 gap-3">
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Student Number</label>
                            <input type="text" name="student_id" <%= selectedStudent ? 'disabled' : 'required' %> placeholder="e.g. xxxx-xxxxxx" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-mono">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">First Name</label>
                            <input type="text" name="first_name" <%= selectedStudent ? 'disabled' : 'required' %> placeholder="First Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Middle Name</label>
                            <input type="text" name="middle_name" <%= selectedStudent ? 'disabled' : '' %> placeholder="Middle Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Last Name</label>
                            <input type="text" name="last_name" <%= selectedStudent ? 'disabled' : 'required' %> placeholder="Last Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Temp Password</label>
                            <input type="text" id="regStudentTempPassword" name="temp_password" <%= selectedStudent ? 'disabled' : 'required' %> class="w-full px-3 py-2 rounded-lg border border-indigo-400 bg-indigo-50 text-xs font-mono font-bold text-indigo-900">
                        </div>
                    </div>

                    <!-- Row 2: Year, Semester, and Academic Year Selection -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 border-t border-slate-100 pt-3">
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Enrollment Academic Year</label>
                            <select name="academic_year" <%= selectedStudent ? 'disabled' : '' %> class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-medium">
                                <option value="2026-2027" <%= systemSettings.current_ay === '2026-2027' ? 'selected' : '' %>>A.Y. 2026-2027</option>
                                <option value="2027-2028" <%= systemSettings.current_ay === '2027-2028' ? 'selected' : '' %>>A.Y. 2027-2028</option>
                                <option value="2028-2029" <%= systemSettings.current_ay === '2028-2029' ? 'selected' : '' %>>A.Y. 2028-2029</option>
                                <option value="2029-2030" <%= systemSettings.current_ay === '2029-2030' ? 'selected' : '' %>>A.Y. 2029-2030</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Student Year Level</label>
                            <select name="year_level" id="reg_year_select" onchange="updateSubjectChecklist()" <%= selectedStudent ? 'disabled' : '' %> class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-medium">
                                <option value="1">1st Year</option>
                                <option value="2" selected>2nd Year</option>
                                <option value="3">3rd Year</option>
                                <option value="4">4th Year</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Semester (Triggers Subjects)</label>
                            <select id="reg_sem_select" onchange="updateSubjectChecklist()" <%= selectedStudent ? 'disabled' : 'required' %> class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-bold text-indigo-800">
                                <option value="1">1st Semester</option>
                                <option value="2">2nd Semester</option>
                            </select>
                        </div>
                    </div>
                    
                    <input type="hidden" name="term" id="reg_term_hidden" value="" <%= selectedStudent ? 'disabled' : '' %>>
                    
                    <!-- Dynamic Subjects Checklist Container -->
                    <div class="pt-2">
                        <label class="block text-[11px] uppercase font-bold text-indigo-900 mb-2">Select Subjects to Enroll (Available for Irregular / Back Subjects)</label>
                        <div id="subjectChecklist" class="p-4 bg-slate-50 rounded-lg border border-slate-200">
                            <!-- Populated by JS -->
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <button type="button" onclick="toggleSection('studentRegSection')" class="w-1/4 py-3 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg font-bold text-xs shadow-md transition-colors <%= selectedStudent ? 'pointer-events-none opacity-50' : '' %>">Cancel</button>
                        <button type="submit" <%= selectedStudent ? 'disabled' : '' %> class="w-3/4 py-3 bg-indigo-700 hover:bg-indigo-800 text-white rounded-lg font-bold text-xs shadow-md transition-colors">
                            + Register Account & Enroll Student in Checked Subjects
                        </button>
                    </div>
                </form>
            </div>

            <!-- Register Faculty -->
            <div id="facultyRegSection" class="hidden bg-white rounded-xl shadow-sm border border-slate-200 p-5">
                <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-900 mb-3">Register New Faculty Account</h3>
                <form action="/registrar/add-faculty" method="POST" class="grid grid-cols-1 sm:grid-cols-6 gap-3 items-end text-sm">
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Username</label>
                        <input type="text" name="username" required placeholder="e.g. prof.dizon" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-mono">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Temp Password</label>
                        <input type="text" id="regFacultyTempPassword" name="temp_password" required class="w-full px-3 py-2 rounded-lg border border-indigo-400 bg-indigo-50 text-xs font-mono font-bold text-indigo-900">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">First Name</label>
                        <input type="text" name="first_name" required placeholder="First Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Middle Name</label>
                        <input type="text" name="middle_name" placeholder="Middle Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Last Name</label>
                        <input type="text" name="last_name" required placeholder="Last Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                    </div>
                    <div class="flex gap-2">
                        <button type="button" onclick="toggleSection('facultyRegSection')" class="flex-1 flex justify-center items-center py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg font-bold text-xs shadow transition-colors">Cancel</button>
                        <button type="submit" class="flex-[2] py-2 bg-pink-600 hover:bg-pink-700 text-white rounded-lg font-bold text-xs shadow transition-colors">
                            + Register
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- SEARCH STUDENT & TERM TOOLBAR -->
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex flex-col sm:flex-row items-center gap-4">
            <form id="searchToolbarForm" method="GET" action="/registrar" class="flex flex-col sm:flex-row items-center gap-3 w-full">
                <!-- Search ID -->
                <div class="flex-grow w-full sm:w-auto">
                    <label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Search Student by ID Number:</label>
                    <input type="text" id="studentSearchInput" name="student_id" value="<%= selectedStudent ? selectedStudent.student_id : '' %>" required placeholder="e.g. xxxx-xxxxxx" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm font-mono focus:ring-2 focus:ring-indigo-500">
                </div>

                <!-- Year and Semester Filters -->
                <div class="flex-grow w-full sm:w-auto">
                    <label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Filter by Year & Semester:</label>
                    <div class="flex gap-2">
                        <% 
                            let searchYear = '2'; 
                            let searchSem = '1';
                            if (currentTerm) {
                                searchYear = Math.ceil(parseInt(currentTerm) / 2).toString();
                                searchSem = (parseInt(currentTerm) % 2 === 0 ? 2 : 1).toString();
                            }
                        %>
                        <select id="search_year_select" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm bg-slate-50 font-medium">
                            <option value="1" <%= searchYear === '1' ? 'selected' : '' %>>1st Year</option>
                            <option value="2" <%= searchYear === '2' ? 'selected' : '' %>>2nd Year</option>
                            <option value="3" <%= searchYear === '3' ? 'selected' : '' %>>3rd Year</option>
                            <option value="4" <%= searchYear === '4' ? 'selected' : '' %>>4th Year</option>
                        </select>

                        <select id="search_sem_select" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm bg-slate-50 font-medium">
                            <option value="1" <%= searchSem === '1' ? 'selected' : '' %>>1st Semester</option>
                            <option value="2" <%= searchSem === '2' ? 'selected' : '' %>>2nd Semester</option>
                        </select>
                        
                        <input type="hidden" name="term" id="search_term_hidden" value="<%= currentTerm %>">
                        <button type="button" onclick="submitSearchFilter()" class="px-4 py-2 bg-indigo-700 hover:bg-indigo-800 text-white rounded-lg text-xs font-bold shadow">Search</button>
                    </div>
                </div>
            </form>
        </div>

        <% if (selectedStudent && currentTerm) { %>
            <!-- MANUAL ENROLL SINGLE SUBJECT -->
            <div class="bg-indigo-50 rounded-xl shadow-sm border border-indigo-200 p-5">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-indigo-900">Enroll Extra / Back Subject</h3>
                </div>
                <form action="/registrar/add-single-course" method="POST" class="flex gap-3 items-end text-sm">
                    <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                    <input type="hidden" name="term" value="<%= currentTerm %>">
                    
                    <div>
                        <label class="block text-[10px] uppercase font-bold text-indigo-800 mb-1">Academic Year</label>
                        <select name="academic_year" class="w-full px-3 py-2 rounded-lg border border-indigo-300 bg-white text-xs font-medium">
                            <option value="2026-2027" <%= systemSettings.current_ay === '2026-2027' ? 'selected' : '' %>>A.Y. 2026-2027</option>
                            <option value="2027-2028" <%= systemSettings.current_ay === '2027-2028' ? 'selected' : '' %>>A.Y. 2027-2028</option>
                            <option value="2028-2029" <%= systemSettings.current_ay === '2028-2029' ? 'selected' : '' %>>A.Y. 2028-2029</option>
                            <option value="2029-2030" <%= systemSettings.current_ay === '2029-2030' ? 'selected' : '' %>>A.Y. 2029-2030</option>
                        </select>
                    </div>

                    <div class="flex-grow">
                        <label class="block text-[10px] uppercase font-bold text-indigo-800 mb-1">Select Subject from Curriculum Catalog</label>
                        <select name="course_code" required class="w-full px-3 py-2 rounded-lg border border-indigo-300 bg-white text-xs font-medium">
                            <% if (availableCourses.length === 0) { %>
                                <option value="">No courses available</option>
                            <% } else { %>
                                <% 
                                   const tNames = {
                                      1: '1Y-1S', 2: '1Y-2S', 3: '2Y-1S', 4: '2Y-2S',
                                      5: '3Y-1S', 6: '3Y-2S', 7: '4Y-1S', 8: '4Y-2S'
                                   };
                                %>
                                <% availableCourses.forEach(c => { %>
                                    <option value="<%= c.course_code %>">[<%= tNames[c.term_id] %>] [<%= c.course_code %>] <%= c.descriptive_title %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <div class="flex gap-2">
                        <a href="/registrar" class="flex items-center justify-center px-4 py-2 bg-indigo-200 hover:bg-indigo-300 text-indigo-800 rounded-lg font-bold text-xs shadow transition-colors">Cancel</a>
                        <button type="submit" class="py-2 px-6 bg-indigo-700 hover:bg-indigo-800 text-white rounded-lg font-bold text-xs shadow transition-colors">
                            + Enroll Single Subject
                        </button>
                    </div>
                </form>
            </div>
        <% } %>

        <!-- FULL GRADE MANAGEMENT & EDITING SECTION -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
            <div class="border-b border-slate-100 pb-3 mb-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <h3 class="text-sm font-bold uppercase tracking-wider text-indigo-900">
                    Managing Grades & Enrollments For: 
                    <span class="text-pink-600">
                        <%= selectedStudent ? (selectedStudent.last_name + ', ' + selectedStudent.first_name + ' (' + selectedStudent.student_id + ')') : 'No Student Selected' %>
                    </span>
                </h3>
                
                <% if (selectedStudent) { %>
                    <form action="/registrar/reset-student-password" method="POST" onsubmit="return confirmPasswordReset(this, '<%= selectedStudent.student_id %>')" class="inline-block">
                        <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                        <input type="hidden" name="new_password" class="reset-pass-field">
                        <button type="submit" class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white rounded-lg text-xs font-bold shadow-md transition-colors">
                            🔑 Reset Student Password
                        </button>
                    </form>
                <% } %>
            </div>

            <% if (!selectedStudent || !currentTerm) { %>
                <div class="text-center py-12 text-slate-400">
                    <p class="text-sm">Please search a student and select Year & Semester above to manage grades.</p>
                </div>
            <% } else { %>
                <form action="/registrar/update-grades-batch" method="POST" class="space-y-4">
                    <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                    <input type="hidden" name="term" value="<%= currentTerm %>">

                    <% if (grades.length === 0) { %>
                        <div class="text-center py-8 text-slate-400 text-xs">
                            No subjects enrolled for this student in this term yet. Use the option above to enroll a back subject.
                        </div>
                    <% } else { %>
                        <% grades.forEach((g, index) => { %>
                            <div class="grid grid-cols-1 sm:grid-cols-6 gap-3 items-center bg-slate-50 p-3 rounded-lg border border-slate-200 text-sm">
                                <input type="hidden" name="course_codes" value="<%= g.course_code %>">

                                <div>
                                    <span class="text-[10px] uppercase text-slate-400 block font-bold">Code (<%= g.academic_year %>)</span>
                                    <span class="font-mono font-bold text-indigo-900"><%= g.course_code %></span>
                                </div>
                                <div class="sm:col-span-2">
                                    <span class="text-[10px] uppercase text-slate-400 block font-bold">Title</span>
                                    <span class="text-slate-700 text-xs"><%= g.descriptive_title %></span>
                                </div>
                                <div>
                                    <span class="text-[10px] uppercase text-slate-400 block font-bold">Final Grade</span>
                                    <select name="final_grades" onchange="autoMatchRemark(this, this.getAttribute('data-index'))" data-index="<%= index %>" class="w-full px-2 py-1.5 rounded border border-slate-300 font-bold text-indigo-700 bg-white text-xs">
                                        <option value="" <%= !g.final_grade ? 'selected' : '' %>>-- Select --</option>
                                        <option value="1.00" <%= g.final_grade === '1.00' ? 'selected' : '' %>>1.00</option>
                                        <option value="1.25" <%= g.final_grade === '1.25' ? 'selected' : '' %>>1.25</option>
                                        <option value="1.50" <%= g.final_grade === '1.50' ? 'selected' : '' %>>1.50</option>
                                        <option value="1.75" <%= g.final_grade === '1.75' ? 'selected' : '' %>>1.75</option>
                                        <option value="2.00" <%= g.final_grade === '2.00' ? 'selected' : '' %>>2.00</option>
                                        <option value="2.25" <%= g.final_grade === '2.25' ? 'selected' : '' %>>2.25</option>
                                        <option value="2.50" <%= g.final_grade === '2.50' ? 'selected' : '' %>>2.50</option>
                                        <option value="2.75" <%= g.final_grade === '2.75' ? 'selected' : '' %>>2.75</option>
                                        <option value="3.00" <%= g.final_grade === '3.00' ? 'selected' : '' %>>3.00</option>
                                        <option value="4.00" <%= g.final_grade === '4.00' ? 'selected' : '' %>>4.00</option>
                                        <option value="5.00" <%= g.final_grade === '5.00' ? 'selected' : '' %>>5.00</option>
                                        <option value="X" <%= g.final_grade === 'X' ? 'selected' : '' %>>X</option>
                                        <option value="INC" <%= g.final_grade === 'INC' ? 'selected' : '' %>>INC</option>
                                        <option value="W" <%= g.final_grade === 'W' ? 'selected' : '' %>>W</option>
                                        <option value="NG" <%= g.final_grade === 'NG' ? 'selected' : '' %>>NG</option>
                                    </select>
                                </div>
                                <div>
                                    <span class="text-[10px] uppercase text-slate-400 block font-bold">Instructor</span>
                                    <input type="text" name="instructors" value="<%= g.instructor || '' %>" placeholder="e.g. Prof. Dizon" class="w-full px-2 py-1.5 rounded border border-slate-300 text-xs bg-white">
                                </div>
                                <div class="flex items-end gap-2">
                                    <div class="flex-grow">
                                        <span class="text-[10px] uppercase text-slate-400 block font-bold">Remarks</span>
                                        <select name="remarks_list" id="remark_<%= index %>" class="w-full px-2 py-1.5 rounded border border-slate-300 text-xs bg-white font-medium">
                                            <option value="" <%= !g.remarks ? 'selected' : '' %>>-- Select --</option>
                                            <option value="PASSED" <%= g.remarks === 'PASSED' ? 'selected' : '' %>>PASSED</option>
                                            <option value="FAILED" <%= g.remarks === 'FAILED' ? 'selected' : '' %>>FAILED</option>
                                            <option value="INCOMPLETE" <%= g.remarks === 'INCOMPLETE' ? 'selected' : '' %>>INCOMPLETE</option>
                                            <option value="CONDITIONAL" <%= g.remarks === 'CONDITIONAL' ? 'selected' : '' %>>CONDITIONAL</option>
                                            <option value="DROPPED" <%= g.remarks === 'DROPPED' ? 'selected' : '' %>>DROPPED</option>
                                            <option value="ABSENT FROM EXAMINATION" <%= g.remarks === 'ABSENT FROM EXAMINATION' ? 'selected' : '' %>>ABSENT FROM EXAMINATION</option>
                                            <option value="NO GRADE" <%= g.remarks === 'NO GRADE' ? 'selected' : '' %>>NO GRADE</option>
                                        </select>
                                    </div>
                                    
                                    <!-- Delete / Unenroll Subject Button -->
                                    <button type="submit" form="delete-<%= g.course_code %>" class="px-3 py-2 bg-red-600 hover:bg-red-700 text-white rounded text-xs font-bold shadow" title="Remove Subject">Delete</button>
                                </div>
                            </div>
                        <% }) %>

                        <!-- SAVE & CANCEL BUTTONS -->
                        <div class="pt-4 flex justify-end gap-3">
                            <a href="/registrar" class="px-6 py-3 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-xl text-sm font-bold shadow-md transition-colors flex items-center justify-center">
                                Cancel
                            </a>
                            <button type="submit" class="px-6 py-3 bg-indigo-700 hover:bg-indigo-800 text-white rounded-xl text-sm font-bold shadow-md transition-colors">
                                💾 Save All Changes
                            </button>
                        </div>
                    <% } %>
                </form>

                <!-- Hidden Delete Forms for Each Row -->
                <% grades.forEach(g => { %>
                    <form action="/registrar/delete-grade" method="POST" id="delete-<%= g.course_code %>" onsubmit="return confirm('Remove <%= g.course_code %> from student record?');">
                        <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                        <input type="hidden" name="course_code" value="<%= g.course_code %>">
                        <input type="hidden" name="term" value="<%= currentTerm %>">
                    </form>
                <% }) %>
            <% } %>
        </div>
    </main>

    <!-- SCRIPT LOGIC -->
    <script id="courses-data" type="application/json">
        <%- JSON.stringify(locals.allCoursesRaw || []) %>
    </script>
    <script>
        const allCoursesData = JSON.parse(document.getElementById('courses-data').textContent);
        
        function toggleSection(sectionId) {
            const sections = ['studentRegSection', 'facultyRegSection', 'batchUploadSection'];
            sections.forEach(id => {
                const section = document.getElementById(id);
                if (id === sectionId) {
                    section.classList.toggle('hidden');
                } else {
                    section.classList.add('hidden');
                }
            });
        }
        
        function submitSearchFilter() {
            const y = parseInt(document.getElementById('search_year_select').value);
            const s = parseInt(document.getElementById('search_sem_select').value);
            document.getElementById('search_term_hidden').value = (y - 1) * 2 + s;
            document.getElementById('searchToolbarForm').submit();
        }

        function updateSubjectChecklist() {
            const yearSelect = document.getElementById('reg_year_select');
            const semSelect = document.getElementById('reg_sem_select');
            const container = document.getElementById('subjectChecklist');
            const hiddenTerm = document.getElementById('reg_term_hidden');
            
            if (!yearSelect || !semSelect || !yearSelect.value || !semSelect.value) return;

            const year = parseInt(yearSelect.value);
            const sem = parseInt(semSelect.value);
            const selectedTerm = (year - 1) * 2 + sem;
            
            if (hiddenTerm) hiddenTerm.value = selectedTerm;

            const termNames = {
                "1": "1st Year - 1st Sem", "2": "1st Year - 2nd Sem", "3": "2nd Year - 1st Sem",
                "4": "2nd Year - 2nd Sem", "5": "3rd Year - 1st Sem", "6": "3rd Year - 2nd Sem",
                "7": "4th Year - 1st Sem", "8": "4th Year - 2nd Sem"
            };

            let html = '<div class="max-h-[350px] overflow-y-auto pr-2 space-y-4">';
            for (let i = 1; i <= 8; i++) {
                const termCourses = allCoursesData.filter(c => String(c.term_id) === String(i));
                if (termCourses.length === 0) continue;

                const isCurrentTermGroup = String(i) === String(selectedTerm);
                html += `<div class="bg-white p-3 rounded-lg border ${isCurrentTermGroup ? 'border-indigo-400 bg-indigo-50/40' : 'border-slate-200'} shadow-sm">`;
                html += `<h4 class="text-[11px] font-bold uppercase tracking-wider ${isCurrentTermGroup ? 'text-indigo-800' : 'text-slate-500'} mb-2 border-b ${isCurrentTermGroup ? 'border-indigo-200' : 'border-slate-100'} pb-1">${termNames[i]} ${isCurrentTermGroup ? '(Standard Set)' : ''}</h4>`;
                html += `<div class="grid grid-cols-1 md:grid-cols-2 gap-2">`;
                
                termCourses.forEach(c => {
                    const isAutoChecked = isCurrentTermGroup ? 'checked' : '';
                    html += `
                        <label class="flex items-center space-x-2 p-1.5 rounded cursor-pointer hover:bg-slate-100 transition-colors">
                            <input type="checkbox" name="course_codes" value="${c.course_code}" ${isAutoChecked} class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
                            <span class="text-[11px] font-semibold text-slate-700">[${c.course_code}] <span class="font-normal truncate block w-full">${c.descriptive_title}</span></span>
                        </label>
                    `;
                });
                html += `</div></div>`;
            }
            html += '</div>';
            container.innerHTML = html;
        }

        function autoMatchRemark(selectElement, index) {
            const grade = selectElement.value;
            const remarkSelect = document.getElementById('remark_' + index);
            if (!remarkSelect) return;

            const passedGrades = ['1.00', '1.25', '1.50', '1.75', '2.00', '2.25', '2.50', '2.75', '3.00'];

            if (passedGrades.includes(grade)) {
                remarkSelect.value = 'PASSED';
            } else if (grade === '4.00') {
                remarkSelect.value = 'CONDITIONAL';
            } else if (grade === '5.00') {
                remarkSelect.value = 'FAILED';
            } else if (grade === 'X') {
                remarkSelect.value = 'DROPPED';
            } else if (grade === 'INC') {
                remarkSelect.value = 'INCOMPLETE';
            } else if (grade === 'W') {
                remarkSelect.value = 'ABSENT FROM EXAMINATION';
            } else if (grade === 'NG') {
                remarkSelect.value = 'NO GRADE';
            } else {
                remarkSelect.value = '';
            }
        }

        document.getElementById('studentSearchInput').addEventListener('click', function() {
            this.value = '';
        });

        function generateRandomPassword() {
            const upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
            const lower = 'abcdefghijklmnopqrstuvwxyz';
            const num = '0123456789';
            const special = '!@#$%^&*';
            const all = upper + lower + num + special;
            
            let pass = [
                upper[Math.floor(Math.random() * upper.length)],
                lower[Math.floor(Math.random() * lower.length)],
                num[Math.floor(Math.random() * num.length)],
                special[Math.floor(Math.random() * special.length)]
            ];
            
            for (let i = 0; i < 4; i++) {
                pass.push(all[Math.floor(Math.random() * all.length)]);
            }
            return pass.sort(() => Math.random() - 0.5).join('');
        }
        
        function confirmPasswordReset(form, studentId) {
            const newPass = generateRandomPassword();
            form.querySelector('.reset-pass-field').value = newPass;
            
            const msg = `You are about to reset the password for Student ID: ${studentId}.\n\n` +
                        `The NEW temporary password is:\n\n${newPass}\n\n` + 
                        `Please COPY or WRITE DOWN this password before clicking OK, as it will be securely hashed in the database.`;
            return confirm(msg);
        }

        document.addEventListener('DOMContentLoaded', () => {
            const facPass = document.getElementById('regFacultyTempPassword');
            const stuPass = document.getElementById('regStudentTempPassword');
            if (facPass && !facPass.value) facPass.value = generateRandomPassword();
            if (stuPass && !stuPass.disabled && !stuPass.value) stuPass.value = generateRandomPassword();
            updateSubjectChecklist();
        });
    </script>
</body>
</html>