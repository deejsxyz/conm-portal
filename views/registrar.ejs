<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CONM Registrar Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">
    <header class="bg-emerald-900 text-white shadow-md border-b-4 border-pink-500">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div>
                <h2 class="text-base font-bold">College of Nursing and School of Midwifery</h2>
                <p class="text-xs text-pink-300">Registrar Portal</p>
            </div>
            <div class="flex items-center space-x-3">
                <span class="text-xs bg-indigo-800 px-3 py-1.5 rounded-full text-indigo-100 font-medium">
                    <%= currentUser.fullName || currentUser.username %>
                </span>
                <% if (currentUser.role === 'admin') { %>
                    <a href="/admin" class="text-xs bg-amber-500 hover:bg-amber-600 text-white px-3 py-1.5 rounded font-bold">Admin Panel</a>
                    <a href="/faculty/edit-grades" class="text-xs bg-emerald-700 hover:bg-emerald-600 text-white px-3 py-1.5 rounded font-medium">Open Grade Editor</a>
                <% } %>
                <a href="/change-password" class="text-xs bg-slate-700 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">Change Password</a>
                <form action="/logout" method="POST" class="inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="text-xs bg-pink-600 hover:bg-pink-700 text-white px-3 py-1.5 rounded font-medium">Log Out</button>
                </form>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-6xl w-full mx-auto p-4 sm:p-6 space-y-6">
        
        <% 
            let termNames = {
                "1": "BSN1 - 1st Semester", "2": "BSN1 - 2nd Semester", 
                "3": "BSN2 - 1st Semester", "4": "BSN2 - 2nd Semester", 
                "5": "BSN3 - 1st Semester", "6": "BSN3 - 2nd Semester",
                "7": "BSN4 - 1st Semester", "8": "BSN4 - 2nd Semester"
            };
            let currentTermLabel = termNames[currentTerm] || "Unknown Term";
        %>

        <% if (locals.message) { %>
            <div class="p-4 bg-emerald-100 border border-emerald-400 text-emerald-800 text-xs font-bold rounded-xl shadow-sm text-center">
                ✅ <%= message %>
            </div>
        <% } %>

        <% if (locals.error) { %>
            <div class="p-4 bg-red-100 border border-red-400 text-red-700 text-xs font-bold rounded-xl shadow-sm text-center">
                ⚠️ <%= error %>
            </div>
        <% } %>

        <!-- GLOBAL SYSTEM SETTINGS & FACULTY PORTAL LOCK -->
        <div class="bg-indigo-50 border border-indigo-200 shadow-sm rounded-xl p-5 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
            <div>
                <div class="flex items-center gap-2.5">
                    <h3 class="font-bold text-indigo-900 text-sm uppercase tracking-wider">Global System Settings</h3>
                    <% if (systemSettings.faculty_portal_locked) { %>
                        <span class="px-2.5 py-0.5 bg-red-100 text-red-800 border border-red-300 rounded-full text-[10px] font-bold uppercase tracking-wider">
                            🔒 Faculty Portal Locked
                        </span>
                    <% } else { %>
                        <span class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 border border-emerald-300 rounded-full text-[10px] font-bold uppercase tracking-wider">
                            🔓 Faculty Portal Open
                        </span>
                    <% } %>
                </div>
                <p class="text-xs text-indigo-700 mt-1">Set the active Academic Year, Semester, and control whether clinical instructors are allowed to access the Faculty Portal to encode grades.</p>
            </div>
            
            <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
                <form action="/registrar/update-settings" method="POST" class="flex gap-2 items-center">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <select name="current_ay" class="px-3 py-2 rounded-lg border border-indigo-300 text-xs font-bold text-indigo-900 bg-white">
                        <option value="2025-2026" <%= systemSettings.current_ay === '2025-2026' ? 'selected' : '' %>>A.Y. 2025-2026</option>
                        <option value="2026-2027" <%= systemSettings.current_ay === '2026-2027' ? 'selected' : '' %>>A.Y. 2026-2027</option>
                        <option value="2027-2028" <%= systemSettings.current_ay === '2027-2028' ? 'selected' : '' %>>A.Y. 2027-2028</option>
                        <option value="2028-2029" <%= systemSettings.current_ay === '2028-2029' ? 'selected' : '' %>>A.Y. 2028-2029</option>
                        <option value="2029-2030" <%= systemSettings.current_ay === '2029-2030' ? 'selected' : '' %>>A.Y. 2029-2030</option>
                    </select>
                    <select name="current_semester" class="px-3 py-2 rounded-lg border border-indigo-300 text-xs font-bold text-indigo-900 bg-white">
                        <option value="1" <%= systemSettings.current_semester === 1 ? 'selected' : '' %>>1st Semester</option>
                        <option value="2" <%= systemSettings.current_semester === 2 ? 'selected' : '' %>>2nd Semester</option>
                    </select>
                    <button type="submit" class="px-4 py-2 bg-indigo-700 hover:bg-indigo-800 text-white rounded-lg text-xs font-bold shadow-md transition-colors whitespace-nowrap">
                        Apply System-Wide
                    </button>
                </form>

                <form action="/registrar/toggle-faculty-lock" method="POST" class="inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <% if (systemSettings.faculty_portal_locked) { %>
                        <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold shadow-md transition-colors whitespace-nowrap flex items-center gap-1.5">
                            🔓 Unlock Faculty Portal
                        </button>
                    <% } else { %>
                        <button type="submit" onclick="return confirm('Lock the Faculty Portal? Instructors will be prevented from logging in or encoding grades until you unlock it.');" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-bold shadow-md transition-colors whitespace-nowrap flex items-center gap-1.5">
                            🔒 Lock Faculty Portal
                        </button>
                    <% } %>
                </form>
            </div>
        </div>

        <!-- TOGGLE BUTTONS FOR REGISTRATION & MANAGEMENT (DATA-SECTION DRIVEN) -->
        <div class="flex flex-row flex-nowrap gap-3 overflow-x-auto pb-2">
            <button type="button" data-target-section="studentRegSection" class="nav-toggle-btn flex-1 px-4 py-3 bg-indigo-700 hover:bg-indigo-800 text-white rounded-xl text-xs font-bold shadow-md transition-colors flex items-center justify-center gap-1.5 whitespace-nowrap">
                👤 Register Student
            </button>
            <button type="button" data-target-section="batchUploadSection" class="nav-toggle-btn flex-1 px-4 py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow-md transition-colors flex items-center justify-center gap-1.5 whitespace-nowrap">
                📁 Batch Upload
            </button>
            <button type="button" data-target-section="facultyRegSection" class="nav-toggle-btn flex-1 px-4 py-3 bg-pink-600 hover:bg-pink-700 text-white rounded-xl text-xs font-bold shadow-md transition-colors flex items-center justify-center gap-1.5 whitespace-nowrap">
                👨‍🏫 Register Faculty
            </button>
            <button type="button" data-target-section="facultyManageSection" class="nav-toggle-btn flex-1 px-4 py-3 bg-teal-600 hover:bg-teal-700 text-white rounded-xl text-xs font-bold shadow-md transition-colors flex items-center justify-center gap-1.5 whitespace-nowrap">
                👥 Manage Faculty
            </button>
            <button type="button" data-target-section="studentManageSection" class="nav-toggle-btn flex-1 px-4 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold shadow-md transition-colors flex items-center justify-center gap-1.5 whitespace-nowrap">
                ✏️ Manage Student
            </button>
        </div>

        <!-- SECTIONS -->
        <div class="space-y-4">
            
            <!-- BATCH UPLOAD CSV FORM -->
            <div id="batchUploadSection" class="hidden bg-white rounded-xl shadow-sm border border-emerald-200 p-6 space-y-4">
                <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-900 mb-1">Batch Upload & Enroll Students</h3>
                <p class="text-xs text-slate-500 mb-2">Export your Google Form responses as a <strong>.csv</strong> file (max 300 rows per upload). Include <code class="text-pink-600 font-bold">section</code> (A, B, or C) and an optional <code class="text-pink-600 font-bold">instructor</code> column.</p>
                
                <div class="p-4 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-700">
                    <strong class="text-emerald-900 uppercase tracking-wider">Required Form/CSV Column Headers:</strong><br>
                    <code class="block mt-1 font-mono text-pink-600 font-bold bg-white p-2 border border-slate-200 rounded">student_id, first_name, middle_name, last_name, year_level, section, semester, academic_year, subjects, instructor</code>
                </div>

                <form action="/registrar/batch-upload?_csrf=<%= encodeURIComponent(csrfToken) %>" method="POST" enctype="multipart/form-data" class="flex flex-col sm:flex-row items-center gap-4">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="file" name="file" accept=".csv" required class="w-full sm:w-auto px-4 py-2 border border-slate-300 rounded-lg text-sm bg-slate-50 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-bold file:bg-emerald-100 file:text-emerald-700 hover:file:bg-emerald-200">
                    
                    <button type="submit" class="w-full sm:w-auto px-6 py-3 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-bold shadow-md transition-colors">
                        Upload & Process CSV
                    </button>
                </form>

                <% if (locals.hasBatchCredentials) { %>
                    <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-lg flex flex-col sm:flex-row items-center justify-between gap-3">
                        <span class="text-xs font-bold text-emerald-900">✅ New student passwords generated! (One-time download for security)</span>
                        <a href="/registrar/export-batch-credentials" class="px-5 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-bold shadow transition-colors whitespace-nowrap">
                            📥 Download Passwords CSV
                        </a>
                    </div>
                <% } %>
            </div>

            <!-- Single Student Form -->
            <div id="studentRegSection" class="hidden bg-white rounded-xl shadow-sm border border-slate-200 p-5 <%= selectedStudent ? 'opacity-50 pointer-events-none' : '' %>">
                <h3 class="text-sm font-bold uppercase tracking-wider text-indigo-900 mb-3">Register Account & Enroll Single Student</h3>
                <form action="/registrar/add-student" method="POST" class="space-y-4 text-sm">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="grid grid-cols-1 sm:grid-cols-5 gap-3">
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Student Number</label>
                            <input type="text" name="student_id" <%= selectedStudent ? 'disabled' : 'required' %> placeholder="e.g. xxxx-xxxxxx" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-mono">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">First Name</label>
                            <input type="text" name="first_name" <%= selectedStudent ? 'disabled' : 'required' %> placeholder="First Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Middle Name</label>
                            <input type="text" name="middle_name" <%= selectedStudent ? 'disabled' : '' %> placeholder="Middle Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Last Name</label>
                            <input type="text" name="last_name" <%= selectedStudent ? 'disabled' : 'required' %> placeholder="Last Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Temp Password</label>
                            <input type="text" id="regStudentTempPassword" name="temp_password" <%= selectedStudent ? 'disabled' : 'required' %> class="w-full px-3 py-2 rounded-lg border border-indigo-400 bg-indigo-50 text-xs font-mono font-bold text-indigo-900">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 border-t border-slate-100 pt-3">
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Enrollment Academic Year</label>
                            <select name="academic_year" <%= selectedStudent ? 'disabled' : '' %> class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-medium">
                                <option value="2026-2027" <%= systemSettings.current_ay === '2026-2027' ? 'selected' : '' %>>A.Y. 2026-2027</option>
                                <option value="2027-2028" <%= systemSettings.current_ay === '2027-2028' ? 'selected' : '' %>>A.Y. 2027-2028</option>
                                <option value="2028-2029" <%= systemSettings.current_ay === '2028-2029' ? 'selected' : '' %>>A.Y. 2028-2029</option>
                                <option value="2029-2030" <%= systemSettings.current_ay === '2029-2030' ? 'selected' : '' %>>A.Y. 2029-2030</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Student Year Level</label>
                            <select name="year_level" id="reg_year_select" <%= selectedStudent ? 'disabled' : '' %> class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-bold text-indigo-900">
                                <option value="1">BSN1</option>
                                <option value="2" selected>BSN2</option>
                                <option value="3">BSN3</option>
                                <option value="4">BSN4</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Section</label>
                            <select name="section" <%= selectedStudent ? 'disabled' : 'required' %> class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-bold text-indigo-900">
                                <option value="A" selected>A</option>
                                <option value="B">B</option>
                                <option value="C">C</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Semester (Triggers Subjects)</label>
                            <select id="reg_sem_select" <%= selectedStudent ? 'disabled' : 'required' %> class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-bold text-indigo-800">
                                <option value="1">1st Semester</option>
                                <option value="2">2nd Semester</option>
                            </select>
                        </div>
                    </div>
                    
                    <input type="hidden" name="term" id="reg_term_hidden" value="" <%= selectedStudent ? 'disabled' : '' %>>
                    
                    <div class="pt-2">
                        <label class="block text-[11px] uppercase font-bold text-indigo-900 mb-2">Select Subjects & Assign Instructors (Optional)</label>
                        <div id="subjectChecklist" class="p-4 bg-slate-50 rounded-lg border border-slate-200"></div>
                    </div>

                    <div class="flex gap-3">
                        <button type="button" data-target-section="studentRegSection" class="cancel-toggle-btn w-1/4 py-3 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg font-bold text-xs shadow-md transition-colors <%= selectedStudent ? 'pointer-events-none opacity-50' : '' %>">Cancel</button>
                        <button type="submit" <%= selectedStudent ? 'disabled' : '' %> class="w-3/4 py-3 bg-indigo-700 hover:bg-indigo-800 text-white rounded-lg font-bold text-xs shadow-md transition-colors">
                            + Register Account & Enroll Student in Checked Subjects
                        </button>
                    </div>
                </form>
            </div>

            <!-- REGISTER FACULTY -->
            <div id="facultyRegSection" class="hidden bg-white rounded-xl shadow-sm border border-slate-200 p-5 space-y-4">
                <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-900 mb-1">Register New Faculty Account & Assign Subjects</h3>
                <form action="/registrar/add-faculty" method="POST" class="space-y-4 text-sm">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="grid grid-cols-1 sm:grid-cols-5 gap-3">
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Username</label>
                            <input type="text" name="username" required placeholder="e.g. prof.dizon" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-mono">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Temp Password</label>
                            <input type="text" id="regFacultyTempPassword" name="temp_password" required class="w-full px-3 py-2 rounded-lg border border-indigo-400 bg-indigo-50 text-xs font-mono font-bold text-indigo-900">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">First Name</label>
                            <input type="text" name="first_name" required placeholder="First Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Middle Name</label>
                            <input type="text" name="middle_name" placeholder="Middle Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Last Name</label>
                            <input type="text" name="last_name" required placeholder="Last Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                        </div>
                    </div>

                    <div class="pt-2 border-t border-slate-100">
                        <label class="block text-[11px] uppercase font-bold text-indigo-900 mb-2">Assign Subjects Taught (Up to 5 Default + Add More)</label>
                        <div id="facultySubjectDropdownsContainer" class="space-y-2"></div>
                        <button type="button" id="addFacultySlotBtn" class="mt-3 px-4 py-2 bg-pink-100 hover:bg-pink-200 text-pink-700 rounded-lg text-xs font-bold transition-colors">
                            Add Subject Slot
                        </button>
                    </div>

                    <div class="flex gap-3 pt-3 border-t border-slate-100">
                        <button type="button" data-target-section="facultyRegSection" class="cancel-toggle-btn w-1/4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg font-bold text-xs shadow transition-colors">Cancel</button>
                        <button type="submit" class="w-3/4 py-2 bg-pink-600 hover:bg-pink-700 text-white rounded-lg font-bold text-xs shadow transition-colors">
                            + Register Faculty & Save Assigned Subjects
                        </button>
                    </div>
                </form>
            </div>

            <!-- MANAGE FACULTY SECTION -->
            <div id="facultyManageSection" class="<%= locals.selectedFaculty ? '' : 'hidden' %> bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-5">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
                    <div>
                        <h4 class="font-bold text-indigo-900 text-sm uppercase tracking-wider">Manage Registered Faculty Members (<%= facultyList.length %>)</h4>
                        <p class="text-xs text-slate-500">Select a faculty member to edit their profile, reset their password, archive their account, or update their assigned subjects.</p>
                    </div>

                    <form method="GET" action="/registrar" class="w-full sm:w-80">
                        <select name="faculty_user" id="facultySelectDropdown" class="w-full px-3 py-2.5 rounded-lg border border-slate-300 bg-slate-50 text-xs font-semibold text-slate-700 focus:ring-2 focus:ring-indigo-500">
                            <option value="">-- Select Faculty Member --</option>
                            <% facultyList.forEach(fac => { 
                                const formalName = [fac.last_name, [fac.first_name, fac.middle_name].filter(Boolean).join(' ')].filter(Boolean).join(', ');
                            %>
                                <option value="<%= fac.username %>" <%= (locals.selectedFaculty && selectedFaculty.username === fac.username) ? 'selected' : '' %>>
                                    <%= formalName %> (<%= fac.username %>)
                                </option>
                            <% }) %>
                        </select>
                    </form>
                </div>

                <% if (locals.selectedFaculty) { %>
                    <% 
                        const editingFormalName = [selectedFaculty.last_name, [selectedFaculty.first_name, selectedFaculty.middle_name].filter(Boolean).join(' ')].filter(Boolean).join(', ');
                    %>
                    <div class="bg-indigo-50/70 rounded-xl border border-indigo-200 p-5 space-y-4">
                        <div class="flex flex-wrap justify-between items-center gap-2">
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-bold uppercase text-indigo-900">Editing Faculty:</span>
                                <span class="font-bold text-xs bg-indigo-900 text-white px-2.5 py-0.5 rounded"><%= editingFormalName %></span>
                            </div>

                            <form action="/registrar/delete-faculty" method="POST" class="inline" data-confirm="Archive faculty account <%= editingFormalName %>?" onsubmit="return confirm(this.dataset.confirm);">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="username" value="<%= selectedFaculty.username %>">
                                <button type="submit" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-bold shadow-sm">
                                    Archive Faculty
                                </button>
                            </form>
                        </div>

                        <form action="/registrar/edit-faculty" method="POST" class="space-y-4 pt-2 border-t border-indigo-200/60">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="original_username" value="<%= selectedFaculty.username %>">
                            
                            <div class="grid grid-cols-1 sm:grid-cols-5 gap-3">
                                <div>
                                    <label class="block text-[10px] uppercase font-bold text-indigo-900 mb-1">Username / ID</label>
                                    <input type="text" name="username" required value="<%= selectedFaculty.username %>" class="w-full px-2.5 py-1.5 rounded border border-indigo-300 bg-white text-xs font-mono font-bold text-indigo-950">
                                </div>
                                <div>
                                    <label class="block text-[10px] uppercase font-bold text-indigo-900 mb-1">First Name</label>
                                    <input type="text" name="first_name" required value="<%= selectedFaculty.first_name || '' %>" class="w-full px-2.5 py-1.5 rounded border border-indigo-300 bg-white text-xs">
                                </div>
                                <div>
                                    <label class="block text-[10px] uppercase font-bold text-indigo-900 mb-1">Middle Name</label>
                                    <input type="text" name="middle_name" value="<%= selectedFaculty.middle_name || '' %>" class="w-full px-2.5 py-1.5 rounded border border-indigo-300 bg-white text-xs">
                                </div>
                                <div>
                                    <label class="block text-[10px] uppercase font-bold text-indigo-900 mb-1">Last Name</label>
                                    <input type="text" name="last_name" required value="<%= selectedFaculty.last_name || '' %>" class="w-full px-2.5 py-1.5 rounded border border-indigo-300 bg-white text-xs">
                                </div>
                                <div>
                                    <label class="block text-[10px] uppercase font-bold text-amber-600 mb-1">Reset Password?</label>
                                    <input type="text" name="temp_password" placeholder="Leave blank" class="w-full px-2.5 py-1.5 rounded border border-amber-300 bg-amber-50 text-[11px] font-mono">
                                </div>
                            </div>

                            <div class="pt-2">
                                <label class="block text-[11px] uppercase font-bold text-indigo-900 mb-2">Assigned Subjects Taught</label>
                                <div id="editFacultyDropdownsContainer" class="space-y-2"></div>
                                <button type="button" id="addEditFacultySlotBtn" class="mt-3 px-4 py-2 bg-indigo-200 hover:bg-indigo-300 text-indigo-800 rounded-lg text-xs font-bold transition-colors">
                                    Add Subject Slot
                                </button>
                            </div>

                            <div class="flex justify-end gap-2 pt-2 border-t border-indigo-200/60">
                                <a href="/registrar" class="px-5 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded font-bold text-xs shadow-sm flex items-center">Cancel</a>
                                <button type="submit" class="px-6 py-2 bg-indigo-700 hover:bg-indigo-800 text-white rounded font-bold text-xs shadow-sm">
                                    💾 Save Faculty Profile
                                </button>
                            </div>
                        </form>
                    </div>
                <% } %>
            </div>

            <!-- MANAGE STUDENT SECTION (SEARCH STUDENT BY ID) -->
            <div id="studentManageSection" class="<%= selectedStudent ? '' : 'hidden' %> bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                <form method="GET" action="/registrar" class="flex flex-col sm:flex-row items-end gap-3 w-full">
                    <div class="flex-grow w-full">
                        <label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Search Student by ID Number:</label>
                        <input type="text" id="studentSearchInput" name="student_id" value="<%= selectedStudent ? selectedStudent.student_id : '' %>" required placeholder="xxxx-xxxxxx" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm font-mono focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <button type="submit" class="w-full sm:w-auto px-8 py-2 h-10 whitespace-nowrap bg-indigo-700 hover:bg-indigo-800 text-white rounded-lg text-sm font-bold shadow transition-colors">Search Student</button>
                </form>
            </div>
        </div>

        <% if (selectedStudent) { %>
            <!-- TERM & ACADEMIC YEAR SWITCHER -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold uppercase text-slate-500">Viewing Term Record:</span>
                    <span class="px-3 py-1 bg-indigo-100 text-indigo-900 rounded-lg text-xs font-bold"><%= currentTermLabel %> (<%= currentViewAy %>)</span>
                </div>
                <form method="GET" action="/registrar" class="flex flex-wrap items-center gap-2">
                    <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                    <select name="view_ay" class="px-2.5 py-1.5 rounded border border-slate-300 text-xs font-bold bg-slate-50">
                        <option value="2025-2026" <%= currentViewAy === '2025-2026' ? 'selected' : '' %>>A.Y. 2025-2026</option>
                        <option value="2026-2027" <%= currentViewAy === '2026-2027' ? 'selected' : '' %>>A.Y. 2026-2027</option>
                        <option value="2027-2028" <%= currentViewAy === '2027-2028' ? 'selected' : '' %>>A.Y. 2027-2028</option>
                        <option value="2028-2029" <%= currentViewAy === '2028-2029' ? 'selected' : '' %>>A.Y. 2028-2029</option>
                        <option value="2029-2030" <%= currentViewAy === '2029-2030' ? 'selected' : '' %>>A.Y. 2029-2030</option>
                    </select>
                    <select name="view_term" class="px-2.5 py-1.5 rounded border border-slate-300 text-xs font-bold bg-slate-50">
                        <% Object.keys(termNames).forEach(tKey => { %>
                            <option value="<%= tKey %>" <%= String(currentTerm) === String(tKey) ? 'selected' : '' %>><%= termNames[tKey] %></option>
                        <% }) %>
                    </select>
                    <button type="submit" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-800 text-white rounded text-xs font-bold">Switch Term</button>
                </form>
            </div>

            <!-- EDIT SUBJECT ENROLLED SECTION -->
            <div class="bg-indigo-50 rounded-xl shadow-sm border border-indigo-200 p-5 space-y-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-indigo-200 pb-3">
                    <div>
                        <h3 class="text-sm font-bold uppercase tracking-wider text-indigo-900">
                            Edit Subject Enrolled 
                            <span class="text-[10px] font-bold bg-indigo-200 text-indigo-800 px-2 py-1 rounded ml-2">A.Y. <%= currentViewAy %> — <%= currentTermLabel %></span>
                        </h3>
                    </div>
                    
                    <div class="flex flex-wrap items-center gap-2">
                        <form action="/registrar/update-student-year-section" method="POST" class="flex items-center gap-1.5 bg-white px-2.5 py-1 rounded-lg border border-indigo-300 shadow-sm">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                            <span class="text-[10px] font-bold uppercase text-slate-500">Class:</span>
                            <select name="year_level" class="text-xs font-bold text-indigo-900 bg-transparent focus:outline-none">
                                <option value="1" <%= Number(selectedStudent.year_level) === 1 ? 'selected' : '' %>>BSN1</option>
                                <option value="2" <%= Number(selectedStudent.year_level) === 2 ? 'selected' : '' %>>BSN2</option>
                                <option value="3" <%= Number(selectedStudent.year_level) === 3 ? 'selected' : '' %>>BSN3</option>
                                <option value="4" <%= Number(selectedStudent.year_level) === 4 ? 'selected' : '' %>>BSN4</option>
                            </select>
                            <span class="text-xs font-bold text-slate-400">-</span>
                            <select name="section" class="text-xs font-bold text-indigo-900 bg-transparent focus:outline-none">
                                <option value="A" <%= (selectedStudent.section || 'A') === 'A' ? 'selected' : '' %>>A</option>
                                <option value="B" <%= selectedStudent.section === 'B' ? 'selected' : '' %>>B</option>
                                <option value="C" <%= selectedStudent.section === 'C' ? 'selected' : '' %>>C</option>
                            </select>
                            <button type="submit" class="px-2 py-0.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded text-[10px] font-bold">Update</button>
                        </form>

                        <span class="text-xs font-bold bg-white border border-indigo-300 text-indigo-700 px-3 py-1.5 rounded-lg shadow-sm">
                            Auto-Matched: <%= currentTermLabel %>
                        </span>
                        
                        <% if (grades.length > 0) { %>
                            <form action="/registrar/unenroll-term" method="POST" onsubmit="return confirm('WARNING: Are you sure you want to unenroll this student from ALL subjects in <%= currentTermLabel %> (<%= currentViewAy %>)?');">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                                <input type="hidden" name="term" value="<%= currentTerm %>">
                                <input type="hidden" name="academic_year" value="<%= currentViewAy %>">
                                <button type="submit" class="px-3.5 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded-lg font-bold text-xs shadow transition-colors flex items-center gap-1">
                                    ⚠️ Unenroll Student from Term
                                </button>
                            </form>
                        <% } %>
                    </div>
                </div>

                <!-- LIST OF CURRENTLY ENROLLED SUBJECTS -->
                <div class="space-y-2">
                    <label class="block text-[10px] uppercase font-bold text-indigo-800">Currently Enrolled Subjects in Selected Term:</label>
                    <% if (grades.length === 0) { %>
                        <p class="text-xs text-slate-500 italic">No subjects enrolled in this term.</p>
                    <% } else { %>
                        <div class="space-y-2">
                            <% grades.forEach(g => { %>
                                <div class="flex flex-col sm:flex-row items-center justify-between bg-white p-3 rounded-lg border border-indigo-200 text-xs gap-3">
                                    <div>
                                        <span class="font-mono font-bold text-indigo-950">[<%= g.course_code %>]</span> 
                                        <span class="font-normal text-slate-700"><%= g.descriptive_title %></span>
                                        <span class="block text-[10px] text-emerald-700 font-semibold mt-0.5">Instructor: <%= g.instructor || 'Not Assigned' %></span>
                                    </div>
                                    <form action="/registrar/delete-grade" method="POST" onsubmit="return confirm('Remove <%= g.course_code %> from student record?');" class="inline">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                                        <input type="hidden" name="course_code" value="<%= g.course_code %>">
                                        <input type="hidden" name="term" value="<%= currentTerm %>">
                                        <input type="hidden" name="academic_year" value="<%= currentViewAy %>">
                                        <button type="submit" class="px-2.5 py-1 bg-red-600 hover:bg-red-700 text-white rounded font-bold text-[10px] shadow">Delete</button>
                                    </form>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <!-- ENROLL ANOTHER SUBJECT WITH OPTIONAL INSTRUCTOR DROPDOWN -->
                <div class="pt-3 border-t border-indigo-200">
                    <label class="block text-[10px] uppercase font-bold text-indigo-800 mb-1">Add / Enroll Another Subject to this Term</label>
                    <form action="/registrar/add-single-course" method="POST" class="flex flex-col sm:flex-row gap-3 items-end">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                        <input type="hidden" name="term" value="<%= currentTerm %>">
                        <input type="hidden" name="academic_year" value="<%= currentViewAy %>">
                        
                        <div class="flex-grow w-full">
                            <select id="extraCourseSelect" name="course_code" required class="w-full px-3 py-2 rounded-lg border border-indigo-300 bg-white text-xs font-medium">
                                <option value="" style="font-style: italic;">--Select Subject--</option>
                                <% if (availableCourses.length > 0) { %>
                                    <% availableCourses.forEach(c => { %>
                                        <option value="<%= c.course_code %>">[<%= c.course_code %>] <%= c.descriptive_title %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <div class="w-full sm:w-64">
                            <select name="instructor" class="w-full px-3 py-2 rounded-lg border border-indigo-300 bg-white text-xs font-medium text-slate-700">
                                <option value="" style="font-style: italic;">-- Select Clinical Instructor (Optional) --</option>
                                <% facultyList.forEach(fac => { 
                                    const facName = [fac.last_name, [fac.first_name, fac.middle_name].filter(Boolean).join(' ')].filter(Boolean).join(', ');
                                %>
                                    <option value="<%= fac.username %>"><%= facName %></option>
                                <% }) %>
                            </select>
                        </div>
                        
                        <div class="flex gap-2 w-full sm:w-auto">
                            <a href="/registrar" class="flex-1 sm:flex-initial flex items-center justify-center px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg font-bold text-xs shadow transition-colors">Cancel</a>
                            <button type="submit" class="flex-1 sm:flex-initial py-2 px-6 bg-indigo-700 hover:bg-indigo-800 text-white rounded-lg font-bold text-xs shadow transition-colors whitespace-nowrap">
                                + Enroll Subject
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- FULL GRADE MANAGEMENT & EDITING SECTION -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 space-y-4">
                <div class="border-b border-slate-100 pb-3 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-indigo-900 flex items-center flex-wrap gap-2">
                        <span>Managing Grades For:</span>
                        <span class="text-pink-600">
                            <%= selectedStudent.last_name + ', ' + selectedStudent.first_name + ' (' + selectedStudent.student_id + ')' %>
                        </span>
                        <span class="text-[10px] font-bold bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded">
                            BSN<%= selectedStudent.year_level %> - <%= selectedStudent.section || 'A' %>
                        </span>
                        <span class="text-[10px] font-bold bg-indigo-100 text-indigo-800 px-2 py-0.5 rounded">A.Y. <%= currentViewAy %> — <%= currentTermLabel %></span>
                    </h3>
                    
                    <form action="/registrar/reset-student-password" method="POST" onsubmit="return confirmPasswordReset(this, '<%= selectedStudent.student_id %>')" class="inline-block">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                        <input type="hidden" name="new_password" class="reset-pass-field">
                        <button type="submit" class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white rounded-lg text-xs font-bold shadow-md transition-colors">
                            🔑 Reset Student Password
                        </button>
                    </form>
                </div>

                <form action="/registrar/update-grades-batch" method="POST" class="space-y-4">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                    <input type="hidden" name="enrolled_term" value="<%= currentTerm %>">
                    <input type="hidden" name="academic_year" value="<%= currentViewAy %>">

                    <% if (grades.length === 0) { %>
                        <div class="text-center py-8 text-slate-400 text-xs">
                            No subjects recorded for this student in this term.
                        </div>
                    <% } else { %>
                        <% grades.forEach((g, index) => { %>
                            <div class="grid grid-cols-1 sm:grid-cols-6 gap-3 items-center bg-slate-50 p-3 rounded-lg border border-slate-200 text-sm">
                                <input type="hidden" name="course_codes" value="<%= g.course_code %>">

                                <div>
                                    <span class="text-[10px] uppercase text-slate-400 block font-bold">Code (<%= g.academic_year %>)</span>
                                    <span class="font-mono font-bold text-indigo-900"><%= g.course_code %></span>
                                </div>
                                <div class="sm:col-span-2">
                                    <span class="text-[10px] uppercase text-slate-400 block font-bold">Title</span>
                                    <span class="text-slate-700 text-xs"><%= g.descriptive_title %></span>
                                </div>
                                <div>
                                    <span class="text-[10px] uppercase text-slate-400 block font-bold">Final Grade</span>
                                    <select name="final_grades" data-index="<%= index %>" class="grade-select-box w-full px-2 py-1.5 rounded border border-slate-300 font-bold text-indigo-700 bg-white text-xs">
                                        <option value="" <%= !g.final_grade ? 'selected' : '' %>>-- Select --</option>
                                        <option value="1.00" <%= g.final_grade === '1.00' ? 'selected' : '' %>>1.00</option>
                                        <option value="1.25" <%= g.final_grade === '1.25' ? 'selected' : '' %>>1.25</option>
                                        <option value="1.50" <%= g.final_grade === '1.50' ? 'selected' : '' %>>1.50</option>
                                        <option value="1.75" <%= g.final_grade === '1.75' ? 'selected' : '' %>>1.75</option>
                                        <option value="2.00" <%= g.final_grade === '2.00' ? 'selected' : '' %>>2.00</option>
                                        <option value="2.25" <%= g.final_grade === '2.25' ? 'selected' : '' %>>2.25</option>
                                        <option value="2.50" <%= g.final_grade === '2.50' ? 'selected' : '' %>>2.50</option>
                                        <option value="2.75" <%= g.final_grade === '2.75' ? 'selected' : '' %>>2.75</option>
                                        <option value="3.00" <%= g.final_grade === '3.00' ? 'selected' : '' %>>3.00</option>
                                        <option value="4.00" <%= g.final_grade === '4.00' ? 'selected' : '' %>>4.00</option>
                                        <option value="5.00" <%= g.final_grade === '5.00' ? 'selected' : '' %>>5.00</option>
                                        <option value="X" <%= g.final_grade === 'X' ? 'selected' : '' %>>X</option>
                                        <option value="INC" <%= g.final_grade === 'INC' ? 'selected' : '' %>>INC</option>
                                        <option value="W" <%= g.final_grade === 'W' ? 'selected' : '' %>>W</option>
                                        <option value="NG" <%= g.final_grade === 'NG' ? 'selected' : '' %>>NG</option>
                                    </select>
                                </div>
                                <div>
                                    <span class="text-[10px] uppercase text-slate-400 block font-bold">Instructor</span>
                                    <select name="instructors" class="w-full px-2 py-1.5 rounded border border-slate-300 text-xs bg-white font-medium text-slate-700">
                                        <option value="" style="font-style: italic;">-- Select Clinical Instructor (Optional) --</option>
                                        <% facultyList.forEach(fac => { 
                                            const facName = [fac.last_name, [fac.first_name, fac.middle_name].filter(Boolean).join(' ')].filter(Boolean).join(', ');
                                            const isSelected = (g.instructor_username && g.instructor_username === fac.username) || (g.instructor === facName);
                                        %>
                                            <option value="<%= fac.username %>" <%= isSelected ? 'selected' : '' %>><%= facName %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="flex items-end gap-2">
                                    <div class="flex-grow">
                                        <span class="text-[10px] uppercase text-slate-400 block font-bold">Remarks (Server Verified)</span>
                                        <input type="text" id="remark_<%= index %>" value="<%= g.remarks || '' %>" readonly class="w-full px-2 py-1.5 rounded border border-slate-200 text-xs bg-slate-100 font-bold text-slate-700">
                                    </div>
                                </div>
                            </div>
                        <% }) %>

                        <!-- SAVE & CANCEL BUTTONS -->
                        <div class="pt-4 flex justify-end gap-3">
                            <a href="/registrar" class="px-6 py-3 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-xl text-sm font-bold shadow-md transition-colors flex items-center justify-center">
                                Cancel
                            </a>
                            <button type="submit" class="px-6 py-3 bg-indigo-700 hover:bg-indigo-800 text-white rounded-xl text-sm font-bold shadow-md transition-colors">
                                💾 Save All Changes
                            </button>
                        </div>
                    <% } %>
                </form>
            </div>
        <% } %>

    </main>

    <!-- XSS-SAFE JSON SCRIPT BLOCKS -->
    <script id="courses-data" type="application/json">
        <%- JSON.stringify(locals.allCoursesRaw || []).replace(/</g, '\\u003c') %>
    </script>
    <script id="faculty-list-data" type="application/json">
        <%- JSON.stringify(locals.facultyList || []).replace(/</g, '\\u003c') %>
    </script>
    <script id="faculty-assigned-data" type="application/json">
        <%- JSON.stringify(locals.facultyAssignedCourses || []).replace(/</g, '\\u003c') %>
    </script>
    <script>
        const allCoursesData = JSON.parse(document.getElementById('courses-data').textContent);
        const facultyListData = JSON.parse(document.getElementById('faculty-list-data').textContent);
        const facultyAssignedData = JSON.parse(document.getElementById('faculty-assigned-data').textContent);
        
        function escapeHtml(str) {
            return String(str ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function toggleSection(sectionId) {
            const sections = ['studentRegSection', 'facultyRegSection', 'batchUploadSection', 'facultyManageSection', 'studentManageSection'];
            sections.forEach(id => {
                const section = document.getElementById(id);
                if (id === sectionId) {
                    section.classList.remove('hidden');
                } else {
                    section.classList.add('hidden');
                }
            });
            sessionStorage.setItem('activeRegistrarSection', sectionId);
        }

        function updateSubjectChecklist() {
            const yearSelect = document.getElementById('reg_year_select');
            const semSelect = document.getElementById('reg_sem_select');
            const container = document.getElementById('subjectChecklist');
            const hiddenTerm = document.getElementById('reg_term_hidden');
            
            if (!yearSelect || !semSelect || !yearSelect.value || !semSelect.value) return;

            const year = parseInt(yearSelect.value);
            const sem = parseInt(semSelect.value);
            const selectedTerm = (year - 1) * 2 + sem;
            
            if (hiddenTerm) hiddenTerm.value = selectedTerm;

            const termNames = {
                "1": "BSN1 - 1st Sem", "2": "BSN1 - 2nd Sem", 
                "3": "BSN2 - 1st Sem", "4": "BSN2 - 2nd Sem", 
                "5": "BSN3 - 1st Sem", "6": "BSN3 - 2nd Sem",
                "7": "BSN4 - 1st Sem", "8": "BSN4 - 2nd Sem"
            };

            let facultyOptionsHtml = '<option value="" style="font-style: italic;">-- Select Clinical Instructor (Optional) --</option>';
            facultyListData.forEach(fac => {
                const facName = [fac.last_name, [fac.first_name, fac.middle_name].filter(Boolean).join(' ')].filter(Boolean).join(', ');
                facultyOptionsHtml += `<option value="${escapeHtml(fac.username)}">${escapeHtml(facName)}</option>`;
            });

            let html = '<div class="max-h-[400px] overflow-y-auto pr-2 space-y-4">';
            for (let i = 1; i <= 8; i++) {
                const termCourses = allCoursesData.filter(c => String(c.term_id) === String(i));
                if (termCourses.length === 0) continue;

                const isCurrentTermGroup = String(i) === String(selectedTerm);
                html += `<div class="bg-white p-3 rounded-lg border ${isCurrentTermGroup ? 'border-indigo-400 bg-indigo-50/40' : 'border-slate-200'} shadow-sm">`;
                html += `<h4 class="text-[11px] font-bold uppercase tracking-wider ${isCurrentTermGroup ? 'text-indigo-800' : 'text-slate-500'} mb-2 border-b ${isCurrentTermGroup ? 'border-indigo-200' : 'border-slate-100'} pb-1">${escapeHtml(termNames[i])} ${isCurrentTermGroup ? '(Standard Set)' : ''}</h4>`;
                html += `<div class="space-y-2">`;
                
                termCourses.forEach(c => {
                    const isAutoChecked = isCurrentTermGroup ? 'checked' : '';
                    html += `
                        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-2 rounded hover:bg-slate-100 gap-2 border border-slate-100">
                            <label class="flex items-center space-x-2 cursor-pointer flex-grow">
                                <input type="checkbox" name="course_codes" value="${escapeHtml(c.course_code)}" ${isAutoChecked} class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
                                <span class="text-[11px] font-semibold text-slate-700">[${escapeHtml(c.course_code)}] ${escapeHtml(c.descriptive_title)}</span>
                            </label>
                            <div class="w-full sm:w-64">
                                <select name="instructors" class="w-full px-2 py-1 rounded border border-slate-300 bg-white text-[11px] font-medium text-slate-700">
                                    ${facultyOptionsHtml}
                                </select>
                            </div>
                        </div>
                    `;
                });
                html += `</div></div>`;
            }
            html += '</div>';
            container.innerHTML = html;
        }

        function addFacultySubjectDropdown(containerId, selectedValue = '') {
            const container = document.getElementById(containerId);
            if (!container) return;

            const div = document.createElement('div');
            div.className = 'flex items-center gap-2';

            let optionsHtml = '<option value="" style="font-style: italic;">--Select Subject--</option>';
            allCoursesData.forEach(c => {
                const selected = c.course_code === selectedValue ? 'selected' : '';
                optionsHtml += `<option value="${escapeHtml(c.course_code)}" ${selected}>[${escapeHtml(c.course_code)}] ${escapeHtml(c.descriptive_title)}</option>`;
            });

            div.innerHTML = `
                <select name="course_codes" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-white text-xs font-medium focus:ring-2 focus:ring-indigo-500">
                    ${optionsHtml}
                </select>
                <button type="button" class="remove-slot-btn px-3 py-2 bg-red-100 hover:bg-red-200 text-red-700 rounded-lg text-xs font-bold transition-colors">X</button>
            `;
            container.appendChild(div);
        }

        function initFacultySubjectDropdowns() {
            const regContainer = document.getElementById('facultySubjectDropdownsContainer');
            if (regContainer) {
                regContainer.innerHTML = '';
                for (let i = 0; i < 5; i++) {
                    addFacultySubjectDropdown('facultySubjectDropdownsContainer');
                }
            }

            const editContainer = document.getElementById('editFacultyDropdownsContainer');
            if (editContainer && facultyAssignedData) {
                editContainer.innerHTML = '';
                if (facultyAssignedData.length > 0) {
                    facultyAssignedData.forEach(code => {
                        addFacultySubjectDropdown('editFacultyDropdownsContainer', code);
                    });
                } else {
                    for (let i = 0; i < 5; i++) {
                        addFacultySubjectDropdown('editFacultyDropdownsContainer');
                    }
                }
            }
        }

        function autoMatchRemark(selectElement, index) {
            const grade = selectElement.value;
            const remarkInput = document.getElementById('remark_' + index);
            if (!remarkInput) return;

            const passedGrades = ['1.00', '1.25', '1.50', '1.75', '2.00', '2.25', '2.50', '2.75', '3.00'];

            if (passedGrades.includes(grade)) remarkInput.value = 'PASSED';
            else if (grade === '4.00') remarkInput.value = 'CONDITIONAL';
            else if (grade === '5.00') remarkInput.value = 'FAILED';
            else if (grade === 'X') remarkInput.value = 'DROPPED';
            else if (grade === 'INC') remarkInput.value = 'INCOMPLETE';
            else if (grade === 'W') remarkInput.value = 'ABSENT FROM EXAMINATION';
            else if (grade === 'NG') remarkInput.value = 'NO GRADE';
            else remarkInput.value = '';
        }

        // CSP-Compliant Event Listeners replacing inline on* attributes
        document.addEventListener('DOMContentLoaded', () => {
            // Nav Toggle buttons
            document.querySelectorAll('.nav-toggle-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    toggleSection(btn.getAttribute('data-target-section'));
                });
            });

            // Cancel buttons inside forms
            document.querySelectorAll('.cancel-toggle-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    toggleSection(btn.getAttribute('data-target-section'));
                });
            });

            // Dynamic slot add buttons
            const addFacBtn = document.getElementById('addFacultySlotBtn');
            if (addFacBtn) {
                addFacBtn.addEventListener('click', () => addFacultySubjectDropdown('facultySubjectDropdownsContainer'));
            }
            const addEditFacBtn = document.getElementById('addEditFacultySlotBtn');
            if (addEditFacBtn) {
                addEditFacBtn.addEventListener('click', () => addFacultySubjectDropdown('editFacultyDropdownsContainer'));
            }

            // Delegated remove listener for dynamic subject slots
            document.addEventListener('click', (e) => {
                if (e.target && e.target.classList.contains('remove-slot-btn')) {
                    e.target.parentElement.remove();
                }
            });

            // Grade select changes for auto-remarks
            document.querySelectorAll('.grade-select-box').forEach(sel => {
                sel.addEventListener('change', () => {
                    autoMatchRemark(sel, sel.getAttribute('data-index'));
                });
            });

            // Year and Semester dropdown changes
            const regYear = document.getElementById('reg_year_select');
            const regSem = document.getElementById('reg_sem_select');
            if (regYear) regYear.addEventListener('change', updateSubjectChecklist);
            if (regSem) regSem.addEventListener('change', updateSubjectChecklist);

            // Faculty dropdown change autosubmit
            const facDropdown = document.getElementById('facultySelectDropdown');
            if (facDropdown) {
                facDropdown.addEventListener('change', (e) => {
                    e.target.form.submit();
                });
            }

            const facPass = document.getElementById('regFacultyTempPassword');
            const stuPass = document.getElementById('regStudentTempPassword');
            if (facPass && !facPass.value) facPass.value = generateRandomPassword();
            if (stuPass && !stuPass.disabled && !stuPass.value) stuPass.value = generateRandomPassword();
            
            updateSubjectChecklist();
            initFacultySubjectDropdowns();
            
            const facultyManagedOpen = "<%= locals.selectedFaculty ? 'true' : 'false' %>" === "true";
            const studentManagedOpen = "<%= locals.selectedStudent ? 'true' : 'false' %>" === "true";
            
            if (facultyManagedOpen) {
                sessionStorage.setItem('activeRegistrarSection', 'facultyManageSection');
            } else if (studentManagedOpen) {
                sessionStorage.setItem('activeRegistrarSection', 'studentManageSection');
            } else {
                const savedSection = sessionStorage.getItem('activeRegistrarSection');
                if (savedSection) {
                    toggleSection(savedSection);
                }
            }
        });

        function secureRandInt(max) {
            const arr = new Uint32Array(1);
            window.crypto.getRandomValues(arr);
            return arr[0] % max;
        }

        function generateRandomPassword() {
            const upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
            const lower = 'abcdefghijklmnopqrstuvwxyz';
            const num = '0123456789';
            const special = '!@#$%^&*';
            const all = upper + lower + num + special;
            
            let pass = [
                upper[secureRandInt(upper.length)],
                lower[secureRandInt(lower.length)],
                num[secureRandInt(num.length)],
                special[secureRandInt(special.length)]
            ];
            for (let i = 0; i < 6; i++) {
                pass.push(all[secureRandInt(all.length)]);
            }
            for (let i = pass.length - 1; i > 0; i--) {
                const j = secureRandInt(i + 1);
                [pass[i], pass[j]] = [pass[j], pass[i]];
            }
            return pass.join('');
        }
        
        function confirmPasswordReset(form, studentId) {
            const newPass = generateRandomPassword();
            form.querySelector('.reset-pass-field').value = newPass;
            
            const msg = `You are about to reset the password for Student ID: ${studentId}.\n\n` +
                        `The NEW temporary password is:\n\n${newPass}\n\n` + 
                        `Please COPY or WRITE DOWN this password before clicking OK, as it will be securely hashed in the database.`;
            return confirm(msg);
        }
    </script>
</body>
</html>