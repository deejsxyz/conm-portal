<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CONM Registrar Portal</title>
    <script src="https://cdn.tailwindcss.com" nonce="<%= cspNonce %>"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">
    <header class="bg-emerald-900 text-white shadow-md border-b-4 border-pink-500 relative z-40">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div>
                <h2 class="text-base font-bold">College of Nursing and School of Midwifery</h2>
                <p class="text-xs text-pink-300">Registrar Portal</p>
            </div>
            <div class="flex items-center space-x-3">
                <span class="text-xs bg-indigo-800 px-3 py-1.5 rounded-full text-indigo-100 font-medium">
                    <%= currentUser.fullName || currentUser.username %>
                </span>
                <% if (currentUser.role === 'admin') { %>
                    <a href="/admin" class="text-xs bg-amber-500 hover:bg-amber-600 text-white px-3 py-1.5 rounded font-bold">Admin Panel</a>
                    <a href="/faculty/edit-grades" class="text-xs bg-emerald-700 hover:bg-emerald-600 text-white px-3 py-1.5 rounded font-medium">Open Grade Editor</a>
                <% } %>
                <a href="/change-password" class="text-xs bg-slate-700 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">Change Password</a>
                <form action="/logout" method="POST" class="inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="text-xs bg-pink-600 hover:bg-pink-700 text-white px-3 py-1.5 rounded font-medium cursor-pointer">Log Out</button>
                </form>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-6xl w-full mx-auto p-4 sm:p-6 space-y-6">
        
        <% 
            let termNames = {
                "1": "BSN1 - 1st Semester", "2": "BSN1 - 2nd Semester", 
                "3": "BSN2 - 1st Semester", "4": "BSN2 - 2nd Semester", 
                "5": "BSN3 - 1st Semester", "6": "BSN3 - 2nd Semester",
                "7": "BSN4 - 1st Semester", "8": "BSN4 - 2nd Semester"
            };
            let currentTermLabel = termNames[currentTerm] || "Unknown Term";
        %>

        <% if (locals.message) { %>
            <div class="flash-alert p-4 bg-emerald-100 border border-emerald-400 text-emerald-800 text-xs font-bold rounded-xl shadow-sm text-center">
                ✅ <%= message %>
            </div>
        <% } %>

        <% if (locals.error) { %>
            <div class="flash-alert p-4 bg-red-100 border border-red-400 text-red-700 text-xs font-bold rounded-xl shadow-sm text-center">
                ⚠️ <%= error %>
            </div>
        <% } %>

        <% const lockedList = locals.lockedAccounts || []; %>
        <% const studentPanelOpen = !!selectedStudent; %>
        <% const facultyPanelOpen = !!locals.selectedFaculty && !studentPanelOpen; %>

        <div id="settingsPanel" class="bg-indigo-50 border border-indigo-200 shadow-sm rounded-xl p-5 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
            <div>
                <div class="flex items-center gap-2.5">
                    <h3 class="font-bold text-indigo-900 text-sm uppercase tracking-wider">Global System Settings</h3>
                    <% if (systemSettings.faculty_portal_locked) { %>
                        <span class="px-2.5 py-0.5 bg-red-100 text-red-800 border border-red-300 rounded-full text-[10px] font-bold uppercase tracking-wider">
                            🔒 Faculty Portal Locked
                        </span>
                    <% } else { %>
                        <span class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 border border-emerald-300 rounded-full text-[10px] font-bold uppercase tracking-wider">
                            🔓 Faculty Portal Open
                        </span>
                    <% } %>
                </div>
                <p class="text-xs text-indigo-700 mt-1">Set the active Academic Year, Semester, and control whether clinical instructors are allowed to access the Faculty Portal to encode grades.</p>
            </div>
            
            <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto relative z-30">
                <form action="/registrar/update-settings" method="POST" class="flex gap-2 items-center">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <select name="current_ay" class="px-3 py-2 rounded-lg border border-indigo-300 text-xs font-bold text-indigo-900 bg-white cursor-pointer">
                        <option value="2025-2026" <%= systemSettings.current_ay === '2025-2026' ? 'selected' : '' %>>A.Y. 2025-2026</option>
                        <option value="2026-2027" <%= systemSettings.current_ay === '2026-2027' ? 'selected' : '' %>>A.Y. 2026-2027</option>
                        <option value="2027-2028" <%= systemSettings.current_ay === '2027-2028' ? 'selected' : '' %>>A.Y. 2027-2028</option>
                        <option value="2028-2029" <%= systemSettings.current_ay === '2028-2029' ? 'selected' : '' %>>A.Y. 2028-2029</option>
                        <option value="2029-2030" <%= systemSettings.current_ay === '2029-2030' ? 'selected' : '' %>>A.Y. 2029-2030</option>
                    </select>
                    <select name="current_semester" class="px-3 py-2 rounded-lg border border-indigo-300 text-xs font-bold text-indigo-900 bg-white cursor-pointer">
                        <option value="1" <%= systemSettings.current_semester === 1 ? 'selected' : '' %>>1st Semester</option>
                        <option value="2" <%= systemSettings.current_semester === 2 ? 'selected' : '' %>>2nd Semester</option>
                    </select>
                    <button type="submit" class="px-4 py-2 bg-indigo-700 hover:bg-indigo-800 text-white rounded-lg text-xs font-bold shadow-md transition-colors whitespace-nowrap cursor-pointer">
                        Apply System-Wide
                    </button>
                </form>

                <% const lockConfirmText = systemSettings.faculty_portal_locked ? '' : 'Lock the Faculty Portal? Instructors will be prevented from logging in or encoding grades until you unlock it.'; %>
                <form action="/registrar/toggle-faculty-lock" method="POST" class="inline confirm-form" data-confirm-msg="<%= lockConfirmText %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="px-4 py-2 <%= systemSettings.faculty_portal_locked ? 'bg-emerald-600 hover:bg-emerald-700' : 'bg-red-600 hover:bg-red-700' %> text-white rounded-lg text-xs font-bold shadow-md transition-colors whitespace-nowrap flex items-center gap-1.5 cursor-pointer">
                        <%= systemSettings.faculty_portal_locked ? '🔓 Unlock Faculty Portal' : '🔒 Lock Faculty Portal' %>
                    </button>
                </form>

                <div class="relative inline-block text-left">
                    <button type="button" id="logsDropdownBtn" class="px-4 py-2 bg-slate-700 hover:bg-slate-800 text-white rounded-lg text-xs font-bold shadow-md transition-colors whitespace-nowrap flex items-center gap-1.5 cursor-pointer">
                        📂 System Logs ▼
                    </button>
                    <div id="logsDropdownMenu" class="hidden absolute right-0 mt-2 w-48 bg-white border border-slate-200 rounded-lg shadow-xl overflow-hidden">
                        <a href="/registrar/grade-logs" class="block px-4 py-3 text-xs font-bold text-slate-700 hover:bg-amber-50 hover:text-amber-700 border-b border-slate-100 transition-colors">📊 Grade Logs</a>
                        <a href="/registrar/security-log" class="block px-4 py-3 text-xs font-bold text-slate-700 hover:bg-red-50 hover:text-red-700 border-b border-slate-100 transition-colors">🛡️ Security Logs</a>
                        <a href="/registrar/immunization-log" class="block px-4 py-3 text-xs font-bold text-slate-700 hover:bg-teal-50 hover:text-teal-700 transition-colors">💉 Immunization Logs</a>
                    </div>
                </div>

            </div>
        </div>

        <nav class="flex flex-wrap items-center justify-start gap-3 relative z-20" aria-label="Registrar sections">
            <button type="button" data-target-section="studentPanel" aria-expanded="<%= studentPanelOpen ? 'true' : 'false' %>" aria-controls="studentPanel" class="nav-toggle-btn px-4 py-2 bg-indigo-700 hover:bg-indigo-800 text-white rounded-lg text-xs font-bold shadow-md transition-colors inline-flex items-center gap-1.5 cursor-pointer">
                <span>👤 STUDENT</span>
                <span class="toggle-arrow text-[10px]"><%= studentPanelOpen ? '▲' : '▼' %></span>
            </button>
            <button type="button" data-target-section="facultyPanel" aria-expanded="<%= facultyPanelOpen ? 'true' : 'false' %>" aria-controls="facultyPanel" class="nav-toggle-btn px-4 py-2 bg-pink-600 hover:bg-pink-700 text-white rounded-lg text-xs font-bold shadow-md transition-colors inline-flex items-center gap-1.5 cursor-pointer">
                <span>👨‍🏫 FACULTY</span>
                <span class="toggle-arrow text-[10px]"><%= facultyPanelOpen ? '▲' : '▼' %></span>
            </button>
            <button type="button" data-target-section="batchUploadSection" aria-expanded="false" aria-controls="batchUploadSection" class="nav-toggle-btn px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold shadow-md transition-colors inline-flex items-center gap-1.5 cursor-pointer">
                <span>📁 BATCH UPLOAD</span>
                <% if (locals.hasBatchCredentials) { %><span class="px-2 py-0.5 bg-amber-300 text-amber-900 rounded-full text-[10px]">⬇ Credentials ready</span><% } %>
                <span class="toggle-arrow text-[10px]">▼</span>
            </button>
            <button type="button" id="lockedAccountsToggleBtn" data-target-section="lockedAccountsPanel" aria-expanded="false" aria-controls="lockedAccountsPanel" class="nav-toggle-btn px-4 py-2 <%= lockedList.length > 0 ? 'bg-red-600 hover:bg-red-700' : 'bg-slate-500 hover:bg-slate-600' %> text-white rounded-lg text-xs font-bold shadow-md transition-colors inline-flex items-center gap-1.5 cursor-pointer">
                <span>🔒 LOCKED ACCOUNTS</span>
                <span class="px-2 py-0.5 bg-white/25 rounded-full text-[10px]"><%= lockedList.length %></span>
                <span class="toggle-arrow text-[10px]">▼</span>
            </button>
        </nav>

        <div class="space-y-4">

            <div id="studentPanel" class="<%= studentPanelOpen ? '' : 'hidden' %> space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div role="tablist" aria-label="Student tools" class="inline-flex p-1 bg-slate-200 rounded-xl gap-1">
                        <button type="button" role="tab" data-tab-parent="studentPanel" data-tab-target="studentManageSection" aria-selected="true" aria-controls="studentManageSection" class="sub-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-colors cursor-pointer bg-white text-indigo-900 shadow">✏️ Manage/Enroll Student</button>
                        <button type="button" role="tab" data-tab-parent="studentPanel" data-tab-target="studentRegSection" aria-selected="false" aria-controls="studentRegSection" class="sub-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-colors cursor-pointer text-slate-600 hover:text-slate-900">➕ Pre-Register</button>
                    </div>
                    <% if (selectedStudent) { %>
                        <a href="/registrar" class="text-xs font-bold text-slate-600 hover:text-slate-900 underline">Close student record</a>
                    <% } %>
                </div>

                <div id="studentManageSection" class="space-y-4">
                    <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                        <form method="GET" action="/registrar" class="flex flex-col sm:flex-row items-end gap-3 w-full">
                            <div class="flex-grow w-full">
                                <label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Search Student by ID Number:</label>
                                <input type="text" id="studentSearchInput" name="student_id" value="<%= selectedStudent ? selectedStudent.student_id : '' %>" required placeholder="xxxx-xxxxxx" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm font-mono focus:ring-2 focus:ring-indigo-500">
                            </div>
                            <button type="submit" class="w-full sm:w-auto px-8 py-2 h-10 whitespace-nowrap bg-indigo-700 hover:bg-indigo-800 text-white rounded-lg text-sm font-bold shadow transition-colors cursor-pointer">Search Student</button>
                        </form>
                    </div>

                <% if (selectedStudent) { %>
                    <!-- IMMUNIZATION STATUS PANEL -->
                    <% if (locals.immunizationReport) { %>
                        <div id="immunizationPanel" class="bg-white rounded-xl shadow-sm border border-emerald-200 p-5 space-y-4">
                            <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                                <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-900 flex items-center gap-2">
                                    <span>🛡️ Student Health &amp; Immunization Status</span>
                                    <span class="text-[10px] bg-amber-100 text-amber-800 px-2 py-0.5 rounded font-normal">Data Privacy Act (RA 10173) Protected</span>
                                </h3>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <% immunizationReport.forEach(v => { %>
                                    <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-3 flex flex-col justify-between">
                                        <div class="space-y-1">
                                            <div class="flex justify-between items-start">
                                                <h4 class="font-bold text-xs text-slate-900"><%= v.name %></h4>
                                                <span class="px-2 py-0.5 border rounded-full text-[10px] font-bold uppercase tracking-wider <%= v.status_cls %>"><%= v.status %></span>
                                            </div>
                                            <p class="text-[11px] text-slate-600">
                                                Progress: <strong>Dose <%= v.dose_number %> of <%= v.doses_required %></strong>
                                            </p>
                                            <p class="text-[11px] text-slate-500">
                                                Last Dose: <%= v.last_dose_date ? new Date(v.last_dose_date).toLocaleDateString() : 'None' %>
                                                <% if (v.next_due_date) { %>
                                                    <br>Next Due / Expiry: <%= new Date(v.next_due_date).toLocaleDateString() %>
                                                <% } %>
                                            </p>
                                        </div>

                                        <form action="/registrar/record-vaccine" method="POST" class="pt-3 border-t border-slate-200 space-y-2">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                                            <input type="hidden" name="vaccine_id" value="<%= v.vaccine_id %>">
                                            <div class="flex gap-1.5">
                                                <input type="date" name="date_given" required class="px-2 py-1 bg-white border border-slate-300 rounded text-[11px] flex-grow">
                                                <button type="submit" class="px-3 py-1 bg-emerald-700 hover:bg-emerald-800 text-white rounded text-[11px] font-bold whitespace-nowrap cursor-pointer">+ Dose</button>
                                            </div>
                                        </form>

                                        <% if (v.last_dose_id) { %>
                                            <form action="/registrar/void-vaccine" method="POST" class="confirm-form" data-confirm-msg="Remove the most recent <%= v.name %> dose (dose <%= v.dose_number %>)? Use this only to correct a mistake. The removal is logged.">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                                                <input type="hidden" name="dose_id" value="<%= v.last_dose_id %>">
                                                <button type="submit" class="text-[10px] font-bold text-red-600 hover:text-red-800 underline cursor-pointer">Remove last dose (correction)</button>
                                            </form>
                                        <% } %>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>

                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold uppercase text-slate-500">Viewing Term Record:</span>
                            <span class="px-3 py-1 bg-indigo-100 text-indigo-900 rounded-lg text-xs font-bold"><%= currentTermLabel %> (<%= currentViewAy %>)</span>
                        </div>
                        <form method="GET" action="/registrar" class="flex flex-wrap items-center gap-2">
                            <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                            <select name="view_ay" class="px-2.5 py-1.5 rounded border border-slate-300 text-xs font-bold bg-slate-50 cursor-pointer">
                                <option value="2025-2026" <%= currentViewAy === '2025-2026' ? 'selected' : '' %>>A.Y. 2025-2026</option>
                                <option value="2026-2027" <%= currentViewAy === '2026-2027' ? 'selected' : '' %>>A.Y. 2026-2027</option>
                                <option value="2027-2028" <%= currentViewAy === '2027-2028' ? 'selected' : '' %>>A.Y. 2027-2028</option>
                                <option value="2028-2029" <%= currentViewAy === '2028-2029' ? 'selected' : '' %>>A.Y. 2028-2029</option>
                                <option value="2029-2030" <%= currentViewAy === '2029-2030' ? 'selected' : '' %>>A.Y. 2029-2030</option>
                            </select>
                            <select name="view_term" class="px-2.5 py-1.5 rounded border border-slate-300 text-xs font-bold bg-slate-50 cursor-pointer">
                                <% Object.keys(termNames).forEach(tKey => { %>
                                    <option value="<%= tKey %>" <%= String(currentTerm) === String(tKey) ? 'selected' : '' %>><%= termNames[tKey] %></option>
                                <% }) %>
                            </select>
                            <button type="submit" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-800 text-white rounded text-xs font-bold cursor-pointer">Switch Term</button>
                        </form>
                    </div>

                    <details open class="group">
                        <summary class="cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden flex items-center justify-between px-4 py-2.5 mb-3 bg-slate-800 hover:bg-slate-900 text-white rounded-xl text-xs font-bold uppercase tracking-wider">
                            <span>Term Enrollment & Grade Management</span>
                            <span class="text-[10px] font-semibold normal-case text-slate-300">click to collapse / expand</span>
                        </summary>
                    
                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 space-y-4">
                        <div class="border-b border-slate-100 pb-3 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                            <h3 class="text-sm font-bold uppercase tracking-wider text-indigo-900 flex items-center flex-wrap gap-2">
                                <span>Record For:</span>
                                <span class="text-pink-600">
                                    <%= selectedStudent.last_name + ', ' + selectedStudent.first_name + ' (' + selectedStudent.student_id + ')' %>
                                </span>
                                <span class="text-[10px] font-bold bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded">
                                    BSN<%= selectedStudent.year_level %> - <%= selectedStudent.section || 'A' %>
                                </span>
                                <span class="text-[10px] font-bold bg-indigo-100 text-indigo-800 px-2 py-0.5 rounded">A.Y. <%= currentViewAy %> — <%= currentTermLabel %></span>
                            </h3>
                    
                            <form action="/registrar/reset-student-password" method="POST" class="inline-block confirm-form" data-confirm-msg="Reset the password for Student ID <%= selectedStudent.student_id %>? A new temporary password will be generated and shown once.">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                                <button type="submit" class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white rounded-lg text-xs font-bold shadow-md transition-colors cursor-pointer">
                                    🔑 Reset Student Password
                                </button>
                            </form>
                        </div>

                        <% if (grades.length === 0) { %>
                            <!-- CHECKLIST ENROLLMENT VIEW FOR NEW TERM -->
                            <form action="/registrar/update-grades-batch" method="POST" class="space-y-4">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                                <input type="hidden" name="enrolled_term" value="<%= currentTerm %>">
                                <input type="hidden" name="academic_year" value="<%= currentViewAy %>">
                                
                                <div class="p-4 bg-indigo-50 border border-indigo-200 rounded-xl mb-4">
                                    <p class="text-sm font-bold text-indigo-900 mb-1">Student is not officially enrolled in <%= currentTermLabel %></p>
                                    <p class="text-xs text-indigo-700">Select subjects below to officially enroll them for this term.</p>
                                </div>

                                <div class="space-y-2">
                                    <% 
                                    const termCourses = allCoursesRaw.filter(c => String(c.term_id) === String(currentTerm));
                                    if (termCourses.length > 0) {
                                        termCourses.forEach(c => { 
                                    %>
                                        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-3 rounded-lg bg-white border border-slate-200 gap-3">
                                            <label class="flex items-center space-x-3 cursor-pointer flex-grow">
                                                <input type="checkbox" name="course_codes" value="<%= c.course_code %>" checked class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
                                                <div>
                                                    <span class="text-xs font-bold text-slate-800">[<%= c.course_code %>]</span>
                                                    <span class="text-xs text-slate-600 ml-1"><%= c.descriptive_title %></span>
                                                </div>
                                            </label>
                                            <div class="w-full sm:w-64">
                                                <select name="instructor__<%= c.course_code %>" class="w-full px-2 py-1.5 rounded border border-slate-300 bg-slate-50 text-xs font-medium text-slate-700 cursor-pointer">
                                                    <option value="" style="font-style: italic;">-- Select Instructor (Optional) --</option>
                                                    <% facultyList.forEach(fac => { 
                                                        const facName = [fac.last_name, [fac.first_name, fac.middle_name].filter(Boolean).join(' ')].filter(Boolean).join(', ');
                                                    %>
                                                        <option value="<%= fac.username %>"><%= facName %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                        </div>
                                    <% 
                                        });
                                    } else {
                                    %>
                                        <p class="text-xs text-slate-500 italic">No standard subjects found for this term.</p>
                                    <% } %>
                                </div>

                                <!-- Extra Subject Button inside the Checklist -->
                                <div class="pt-3 mt-3 border-t border-indigo-100">
                                    <div id="extraEnrollmentSubjectsContainer" class="space-y-2 mb-2"></div>
                                    <button type="button" id="addExtraSubjectBtn" class="text-xs font-bold bg-indigo-100 text-indigo-700 px-4 py-2 rounded-lg hover:bg-indigo-200 transition-colors cursor-pointer">
                                        + Add Another Subject
                                    </button>
                                </div>

                                <div class="pt-4 flex justify-end gap-3 border-t border-slate-200 mt-4">
                                    <button type="submit" class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-bold shadow-md transition-colors cursor-pointer">
                                        ✅ Enroll Student in Checked Subjects
                                    </button>
                                </div>
                            </form>
                        <% } else { %>
                            <!-- GRADE EDITING VIEW FOR ALREADY ENROLLED TERM -->
                            <div class="flex items-center gap-2 mb-4 bg-emerald-50 border border-emerald-200 p-3 rounded-lg">
                                <span class="text-[10px] font-bold uppercase text-emerald-700">Status:</span>
                                <span class="text-xs font-bold text-emerald-900">Officially Enrolled in this Term</span>
                            </div>

                            <form action="/registrar/update-grades-batch" method="POST" class="space-y-4">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                                <input type="hidden" name="enrolled_term" value="<%= currentTerm %>">
                                <input type="hidden" name="academic_year" value="<%= currentViewAy %>">

                                <div class="space-y-2">
                                    <% grades.forEach((g, index) => { %>
                                        <div class="grid grid-cols-1 sm:grid-cols-6 gap-3 items-center bg-slate-50 p-3 rounded-lg border border-slate-200 text-sm">
                                            <input type="hidden" name="course_codes" value="<%= g.course_code %>">

                                            <div>
                                                <span class="text-[10px] uppercase text-slate-400 block font-bold">Code (<%= g.academic_year %>)</span>
                                                <span class="font-mono font-bold text-indigo-900"><%= g.course_code %></span>
                                            </div>
                                            <div class="sm:col-span-2">
                                                <span class="text-[10px] uppercase text-slate-400 block font-bold">Title</span>
                                                <span class="text-slate-700 text-xs"><%= g.descriptive_title %></span>
                                            </div>
                                            <div>
                                                <span class="text-[10px] uppercase text-slate-400 block font-bold">Final Grade</span>
                                                <select name="final_grades" data-index="<%= index %>" class="grade-select-box w-full px-2 py-1.5 rounded border border-slate-300 font-bold text-indigo-700 bg-white text-xs cursor-pointer">
                                                    <option value="" <%= !g.final_grade ? 'selected' : '' %>>-- Select --</option>
                                                    <option value="1.00" <%= g.final_grade === '1.00' ? 'selected' : '' %>>1.00</option>
                                                    <option value="1.25" <%= g.final_grade === '1.25' ? 'selected' : '' %>>1.25</option>
                                                    <option value="1.50" <%= g.final_grade === '1.50' ? 'selected' : '' %>>1.50</option>
                                                    <option value="1.75" <%= g.final_grade === '1.75' ? 'selected' : '' %>>1.75</option>
                                                    <option value="2.00" <%= g.final_grade === '2.00' ? 'selected' : '' %>>2.00</option>
                                                    <option value="2.25" <%= g.final_grade === '2.25' ? 'selected' : '' %>>2.25</option>
                                                    <option value="2.50" <%= g.final_grade === '2.50' ? 'selected' : '' %>>2.50</option>
                                                    <option value="2.75" <%= g.final_grade === '2.75' ? 'selected' : '' %>>2.75</option>
                                                    <option value="3.00" <%= g.final_grade === '3.00' ? 'selected' : '' %>>3.00</option>
                                                    <option value="4.00" <%= g.final_grade === '4.00' ? 'selected' : '' %>>4.00</option>
                                                    <option value="5.00" <%= g.final_grade === '5.00' ? 'selected' : '' %>>5.00</option>
                                                    <option value="X" <%= g.final_grade === 'X' ? 'selected' : '' %>>X</option>
                                                    <option value="INC" <%= g.final_grade === 'INC' ? 'selected' : '' %>>INC</option>
                                                    <option value="W" <%= g.final_grade === 'W' ? 'selected' : '' %>>W</option>
                                                    <option value="NG" <%= g.final_grade === 'NG' ? 'selected' : '' %>>NG</option>
                                                </select>
                                            </div>
                                            <div>
                                                <span class="text-[10px] uppercase text-slate-400 block font-bold">Instructor</span>
                                                <select name="instructor__<%= g.course_code %>" class="w-full px-2 py-1.5 rounded border border-slate-300 text-xs bg-white font-medium text-slate-700 cursor-pointer">
                                                    <option value="" style="font-style: italic;">-- Select Instructor --</option>
                                                    <% facultyList.forEach(fac => { 
                                                        const facName = [fac.last_name, [fac.first_name, fac.middle_name].filter(Boolean).join(' ')].filter(Boolean).join(', ');
                                                        const isSelected = (g.instructor_username && g.instructor_username === fac.username) || (g.instructor === facName);
                                                    %>
                                                        <option value="<%= fac.username %>" <%= isSelected ? 'selected' : '' %>><%= facName %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                            <div class="flex items-center justify-between gap-2">
                                                <div class="flex-grow">
                                                    <span class="text-[10px] uppercase text-slate-400 block font-bold">Remarks</span>
                                                    <input type="text" id="remark_<%= index %>" value="<%= g.remarks || '' %>" readonly class="w-full px-2 py-1.5 rounded border border-slate-200 text-xs bg-slate-100 font-bold text-slate-700">
                                                </div>
                                                <button type="button" data-delete-form="delete_grade_form_<%= index %>" data-confirm-msg="Remove <%= g.course_code %> from student record?" class="delete-grade-btn mt-4 px-2.5 py-1 bg-red-600 hover:bg-red-700 text-white rounded font-bold text-[10px] shadow cursor-pointer">Delete</button>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>

                                <div class="pt-4 flex justify-end gap-3">
                                    <a href="/registrar?student_id=<%= selectedStudent.student_id %>" class="px-6 py-3 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-xl text-sm font-bold shadow-md transition-colors flex items-center justify-center">
                                        Cancel
                                    </a>
                                    <button type="submit" class="px-6 py-3 bg-indigo-700 hover:bg-indigo-800 text-white rounded-xl text-sm font-bold shadow-md transition-colors cursor-pointer">
                                        💾 Save Grades
                                    </button>
                                </div>
                            </form>

                            <!-- Hidden forms for deleting individual grades safely using row indices -->
                            <% grades.forEach((g, index) => { %>
                                <form id="delete_grade_form_<%= index %>" action="/registrar/delete-grade" method="POST" class="hidden">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                                    <input type="hidden" name="course_code" value="<%= g.course_code %>">
                                    <input type="hidden" name="term" value="<%= currentTerm %>">
                                    <input type="hidden" name="academic_year" value="<%= currentViewAy %>">
                                </form>
                            <% }) %>

                            <!-- ADD ADDITIONAL SUBJECT AFTER ENROLLMENT -->
                            <div class="pt-4 border-t border-slate-200 mt-4">
                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-2">Add Another Subject to this Term</label>
                                <form action="/registrar/add-single-course" method="POST" class="flex flex-col sm:flex-row gap-3 items-end">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                                    <input type="hidden" name="term" value="<%= currentTerm %>">
                                    <input type="hidden" name="academic_year" value="<%= currentViewAy %>">
                            
                                    <div class="flex-grow w-full">
                                        <select name="course_code" required class="w-full px-3 py-2.5 rounded-lg border border-slate-300 bg-white text-xs font-medium cursor-pointer">
                                            <option value="" style="font-style: italic;">--Select Subject to Add--</option>
                                            <% if (availableCourses.length > 0) { %>
                                                <% availableCourses.forEach(c => { %>
                                                    <option value="<%= c.course_code %>">[<%= c.course_code %>] <%= c.descriptive_title %></option>
                                                <% }) %>
                                            <% } %>
                                        </select>
                                    </div>
                                    <div class="w-full sm:w-64">
                                        <select name="instructor" class="w-full px-3 py-2.5 rounded-lg border border-slate-300 bg-white text-xs font-medium text-slate-700 cursor-pointer">
                                            <option value="" style="font-style: italic;">-- Select Instructor (Optional) --</option>
                                            <% facultyList.forEach(fac => { 
                                                const facName = [fac.last_name, [fac.first_name, fac.middle_name].filter(Boolean).join(' ')].filter(Boolean).join(', ');
                                            %>
                                                <option value="<%= fac.username %>"><%= facName %></option>
                                            <% }) %>
                                        </select>
                                    </div>
                            
                                    <div class="flex gap-2 w-full sm:w-auto">
                                        <button type="submit" class="flex-1 sm:flex-initial py-2.5 px-6 bg-slate-700 hover:bg-slate-800 text-white rounded-lg font-bold text-xs shadow transition-colors whitespace-nowrap cursor-pointer">
                                            + Add Subject
                                        </button>
                                    </div>
                                </form>
                            </div>
                        <% } %>
                    </div>
                    </details>
                <% } %>
                </div>

                <!-- Pre-Register Student Form -->
                <div id="studentRegSection" class="hidden bg-white rounded-xl shadow-sm border border-slate-200 p-5">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-indigo-900 mb-3">Pre-Register Student Account</h3>
                    
                    <div id="lookupMessageContainer" class="hidden mb-3 p-3 text-xs font-bold rounded-lg text-center"></div>

                    <div id="registerImmunizationContainer" class="hidden mb-4 bg-emerald-50 border border-emerald-200 rounded-xl p-4 space-y-3">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-900">🛡️ Existing Student Immunization Status</h4>
                        <div id="registerImmunizationGrid" class="grid grid-cols-1 md:grid-cols-3 gap-3"></div>
                    </div>

                    <form action="/registrar/add-student" method="POST" class="space-y-4 text-sm">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="grid grid-cols-1 sm:grid-cols-5 gap-3">
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Student Number</label>
                                <div class="flex">
                                    <input type="text" id="regStudentIdInput" name="student_id" placeholder="e.g. xxxx-xxxxxx" class="w-full px-3 py-2 rounded-l-lg border border-slate-300 bg-slate-50 text-xs font-mono">
                                    <button type="button" id="lookupStudentApiBtn" class="px-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-r-lg text-xs font-bold flex items-center justify-center cursor-pointer" title="Search Student">
                                        🔍
                                    </button>
                                </div>
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">First Name</label>
                                <input type="text" id="regFirstNameInput" name="first_name" required placeholder="First Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Middle Name</label>
                                <input type="text" id="regMiddleNameInput" name="middle_name" placeholder="Middle Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Last Name</label>
                                <input type="text" id="regLastNameInput" name="last_name" required placeholder="Last Name" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Temp Password</label>
                                <input type="text" id="regStudentTempPassword" name="temp_password" required class="w-full px-3 py-2 rounded-lg border border-indigo-400 bg-indigo-50 text-xs font-mono font-bold text-indigo-900">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 border-t border-slate-100 pt-3">
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Enrollment Academic Year</label>
                                <input type="hidden" name="academic_year" value="<%= systemSettings.current_ay %>">
                                <div class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-100 text-xs font-bold text-slate-700 cursor-not-allowed flex items-center justify-between" title="Set automatically from the Global System Settings">
                                    <span>A.Y. <%= systemSettings.current_ay %></span>
                                    <span class="text-[10px] font-semibold text-slate-500">🔒 Auto</span>
                                </div>
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Student Year Level</label>
                                <select name="year_level" id="reg_year_select" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-bold text-indigo-900 cursor-pointer">
                                    <option value="1">BSN1</option>
                                    <option value="2" selected>BSN2</option>
                                    <option value="3">BSN3</option>
                                    <option value="4">BSN4</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Section</label>
                                <select name="section" id="reg_section_select" required class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-bold text-indigo-900 cursor-pointer">
                                    <option value="A" selected>A</option>
                                    <option value="B">B</option>
                                    <option value="C">C</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Semester (Triggers Subjects)</label>
                                <select id="reg_sem_select" disabled aria-disabled="true" title="Set automatically from the Global System Settings" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-100 text-xs font-bold text-slate-700 cursor-not-allowed">
                                    <option value="1" <%= parseInt(systemSettings.current_semester, 10) === 1 ? 'selected' : '' %>>1st Semester</option>
                                    <option value="2" <%= parseInt(systemSettings.current_semester, 10) === 2 ? 'selected' : '' %>>2nd Semester</option>
                                </select>
                                <p class="mt-1 text-[10px] font-semibold text-slate-500">🔒 Set from Global System Settings</p>
                            </div>
                        </div>
                    
                        <input type="hidden" name="term" id="reg_term_hidden" value="">
                    
                        <div class="pt-2">
                            <label class="block text-[11px] uppercase font-bold text-indigo-900 mb-2">Select Standard Curriculum Subjects & Assign Instructors</label>
                            <div id="subjectChecklist" class="p-4 bg-slate-50 rounded-lg border border-slate-200"></div>
                        </div>

                        <div class="flex gap-3">
                            <button type="button" data-close-panel="studentPanel" class="cancel-toggle-btn w-1/4 py-3 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg font-bold text-xs shadow-md transition-colors cursor-pointer">Cancel</button>
                            <button type="submit" class="w-3/4 py-3 bg-indigo-700 hover:bg-indigo-800 text-white rounded-lg font-bold text-xs shadow-md transition-colors cursor-pointer">
                                + Register Account & Pre-Register Student in Checked Subjects
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- FACULTY (Manage + Register) -->
            <div id="facultyPanel" class="<%= facultyPanelOpen ? '' : 'hidden' %> space-y-4">
