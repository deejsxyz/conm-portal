<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CONM Faculty Grade Management Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">
    <header class="bg-emerald-900 text-white shadow-md border-b-4 border-pink-500">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div>
                <h2 class="text-base font-bold">City University of Pasay - Faculty Portal</h2>
                <p class="text-xs text-pink-300">College of Nursing and School of Midwifery (CONM)</p>
            </div>
            <div class="flex items-center space-x-3">
                <span class="text-xs bg-emerald-800 px-3 py-1.5 rounded-full text-emerald-100 font-medium">
                    <%= currentUser.fullName || currentUser.username %> (<%= currentUser.role.toUpperCase() %>)
                </span>
                <% if (currentUser.role === 'admin') { %>
                    <a href="/admin" class="text-xs bg-amber-500 hover:bg-amber-600 text-white px-3 py-1.5 rounded font-bold">Admin Panel</a>
                <% } %>
                <a href="/change-password" class="text-xs bg-slate-700 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">Change Password</a>
                <a href="/logout" class="text-xs bg-pink-600 hover:bg-pink-700 text-white px-3 py-1.5 rounded font-medium">Log Out</a>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-6xl w-full mx-auto p-4 sm:p-6 space-y-6">
        
        <!-- SUCCESS / ERROR ALERT NOTIFICATIONS -->
        <% if (locals.message) { %>
            <div style="background: #d4edda; color: #155724; padding: 12px 20px; border-radius: 6px; border: 1px solid #c3e6cb; font-weight: 500; text-align: center;">
                <%= message %>
            </div>
        <% } %>

        <% if (locals.error) { %>
            <div style="background: #f8d7da; color: #721c24; padding: 12px 20px; border-radius: 6px; border: 1px solid #f5c6cb; font-weight: 500; text-align: center;">
                <%= error %>
            </div>
        <% } %>

        <!-- SEARCH STUDENT BY ID & TERM TOOLBAR -->
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
            <form method="GET" action="/faculty/edit-grades" class="flex items-center gap-2">
                <div class="flex-grow">
                    <label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Search Student by ID Number:</label>
                    <div class="flex gap-2">
                        <input type="text" id="studentSearchInput" name="student_id" value="<%= selectedStudent ? selectedStudent.student_id : '' %>" required placeholder="e.g. 2024-7021" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm font-mono focus:ring-2 focus:ring-emerald-500">
                        <input type="hidden" name="term" value="<%= currentTerm %>">
                        <button type="submit" class="px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-bold shadow">Search</button>
                    </div>
                </div>
            </form>

            <form method="GET" action="/faculty/edit-grades" class="flex items-center gap-2">
                <div class="flex-grow">
                    <label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Semester Term:</label>
                    <div class="flex gap-2">
                        <select name="term" onchange="this.form.submit()" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm bg-slate-50 font-medium">
                            <option value="1" <%= currentTerm === '1' ? 'selected' : '' %>>1st Year - 1st Sem</option>
                            <option value="2" <%= currentTerm === '2' ? 'selected' : '' %>>1st Year - 2nd Sem</option>
                            <option value="3" <%= currentTerm === '3' ? 'selected' : '' %>>2nd Year - 1st Sem</option>
                            <option value="4" <%= currentTerm === '4' ? 'selected' : '' %>>2nd Year - 2nd Sem</option>
                            <option value="5" <%= currentTerm === '5' ? 'selected' : '' %>>3rd Year - 1st Sem</option>
                            <option value="6" <%= currentTerm === '6' ? 'selected' : '' %>>3rd Year - 2nd Sem</option>
                            <option value="7" <%= currentTerm === '7' ? 'selected' : '' %>>4th Year - 1st Sem</option>
                            <option value="8" <%= currentTerm === '8' ? 'selected' : '' %>>4th Year - 2nd Sem</option>
                        </select>
                        <input type="hidden" name="student_id" value="<%= selectedStudent ? selectedStudent.student_id : '' %>">
                    </div>
                </div>
            </form>
        </div>

        <!-- REGISTER / ADD NEW STUDENT ACCOUNT -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
            <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-900 mb-3">Register / Add New Student Account</h3>
            <form action="/faculty/add-student" method="POST" class="grid grid-cols-1 sm:grid-cols-6 gap-3 items-end text-sm">
                <div>
                    <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Student Number</label>
                    <input type="text" name="student_id" required placeholder="e.g. 2024-00150" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-mono">
                </div>
                <div>
                    <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">First Name</label>
                    <input type="text" name="first_name" required placeholder="e.g. Juan" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                </div>
                <div>
                    <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Middle Name</label>
                    <input type="text" name="middle_name" placeholder="e.g. Reyes" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                </div>
                <div>
                    <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Last Name</label>
                    <input type="text" name="last_name" required placeholder="e.g. Dela Cruz" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs">
                </div>
                <div>
                    <label class="block text-[10px] uppercase font-bold text-slate-500 mb-1">Year Level</label>
                    <select name="year_level" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-xs font-medium">
                        <option value="1">1st Year</option>
                        <option value="2" selected>2nd Year</option>
                        <option value="3">3rd Year</option>
                        <option value="4">4th Year</option>
                    </select>
                </div>
                <div>
                    <button type="submit" class="w-full py-2 bg-pink-600 hover:bg-pink-700 text-white rounded-lg font-bold text-xs shadow transition-colors">
                        + Add Student Information
                    </button>
                </div>
            </form>
        </div>

        <!-- DYNAMIC CONTENT CONTAINER THAT CLEARS ON CLICK/FOCUS -->
        <div id="studentWorkflowContainer" class="space-y-6">
            <% if (selectedStudent) { %>
                <!-- QUICK ASSIGN SUBJECT DROPDOWN CARD -->
                <div class="bg-emerald-50 rounded-xl shadow-sm border border-emerald-200 p-5">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-900">Add Subject from Curriculum Catalog</h3>
                        <form action="/faculty/init-courses" method="POST">
                            <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                            <input type="hidden" name="term" value="<%= currentTerm %>">
                            <button type="submit" class="text-xs bg-emerald-700 hover:bg-emerald-800 text-white px-3 py-1.5 rounded font-bold shadow-sm">
                                ⚡ Auto-Load All Subjects for this Term
                            </button>
                        </form>
                    </div>
                    <form action="/faculty/add-single-grade" method="POST" class="grid grid-cols-1 sm:grid-cols-5 gap-3 items-end text-sm">
                        <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                        <input type="hidden" name="term" value="<%= currentTerm %>">
                        
                        <div class="sm:col-span-2">
                            <label class="block text-[10px] uppercase font-bold text-emerald-800 mb-1">Select Subject / Course</label>
                            <select name="course_code" required class="w-full px-3 py-2 rounded-lg border border-emerald-300 bg-white text-xs font-medium">
                                <% if (availableCourses.length === 0) { %>
                                    <option value="">No courses registered for this term in DB</option>
                                <% } else { %>
                                    <% availableCourses.forEach(c => { %>
                                        <option value="<%= c.course_code %>">[<%= c.course_code %>] <%= c.descriptive_title %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-emerald-800 mb-1">Final Grade</label>
                            <input type="text" name="final_grade" placeholder="e.g. 1.50" class="w-full px-2 py-1.5 rounded border border-emerald-300 bg-white text-xs font-bold text-emerald-900">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase font-bold text-emerald-800 mb-1">Instructor</label>
                            <input type="text" name="instructor" placeholder="e.g. Prof. R. Dizon" class="w-full px-2 py-1.5 rounded border border-emerald-300 bg-white text-xs">
                        </div>
                        <div>
                            <button type="submit" class="w-full py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg font-bold text-xs shadow transition-colors">
                                + Assign Grade
                            </button>
                        </div>
                    </form>
                </div>
            <% } %>

            <!-- EDITING GRADES SECTION WITH A SINGLE SAVE ALL BUTTON -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
                <div class="border-b border-slate-100 pb-3 mb-4 flex justify-between items-center">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-900">
                        Editing Grades For: 
                        <span class="text-pink-600">
                            <%= selectedStudent ? (selectedStudent.last_name + ', ' + selectedStudent.first_name + (selectedStudent.middle_name ? ' ' + selectedStudent.middle_name : '') + ' (' + selectedStudent.student_id + ')') : 'No Student Found' %>
                        </span>
                    </h3>
                </div>

                <% if (!selectedStudent) { %>
                    <div class="text-center py-12 text-slate-400">
                        <p class="text-sm">Please search a valid student ID number above to view and edit grades.</p>
                    </div>
                <% } else { %>
                    <form action="/faculty/update-grades-batch" method="POST" class="space-y-4">
                        <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                        <input type="hidden" name="term" value="<%= currentTerm %>">

                        <% if (grades.length === 0) { %>
                            <div class="text-center py-8 text-slate-400 text-xs">
                                No grades recorded for this student in this term yet. Use the dropdown above or click "Auto-Load All Subjects" to get started.
                            </div>
                        <% } else { %>
                            <% grades.forEach(g => { %>
                                <div class="grid grid-cols-1 sm:grid-cols-6 gap-3 items-center bg-slate-50 p-3 rounded-lg border border-slate-200 text-sm">
                                    <input type="hidden" name="course_codes" value="<%= g.course_code %>">

                                    <div>
                                        <span class="text-[10px] uppercase text-slate-400 block font-bold">Code</span>
                                        <span class="font-mono font-bold text-emerald-900"><%= g.course_code %></span>
                                    </div>
                                    <div class="sm:col-span-2">
                                        <span class="text-[10px] uppercase text-slate-400 block font-bold">Title</span>
                                        <span class="text-slate-700 text-xs"><%= g.descriptive_title %></span>
                                    </div>
                                    <div>
                                        <span class="text-[10px] uppercase text-slate-400 block font-bold">Final Grade</span>
                                        <input type="text" name="final_grades" value="<%= g.final_grade || '' %>" placeholder="e.g. 1.50" class="w-full px-2 py-1.5 rounded border border-slate-300 font-bold text-emerald-700 bg-white">
                                    </div>
                                    <div>
                                        <span class="text-[10px] uppercase text-slate-400 block font-bold">Instructor</span>
                                        <input type="text" name="instructors" value="<%= g.instructor || '' %>" placeholder="e.g. Prof. Dizon" class="w-full px-2 py-1.5 rounded border border-slate-300 text-xs bg-white">
                                    </div>
                                    <div class="flex items-end gap-2">
                                        <div class="flex-grow">
                                            <span class="text-[10px] uppercase text-slate-400 block font-bold">Remarks</span>
                                            <select name="remarks_list" class="w-full px-2 py-1.5 rounded border border-slate-300 text-xs bg-white font-medium">
                                                <option value="" <%= !g.remarks ? 'selected' : '' %>>-- Select Remark --</option>
                                                <option value="PASSED" <%= g.remarks === 'PASSED' ? 'selected' : '' %>>PASSED</option>
                                                <option value="FAILED" <%= g.remarks === 'FAILED' ? 'selected' : '' %>>FAILED</option>
                                                <option value="INCOMPLETE" <%= g.remarks === 'INCOMPLETE' ? 'selected' : '' %>>INCOMPLETE</option>
                                                <option value="CONDITIONAL" <%= g.remarks === 'CONDITIONAL' ? 'selected' : '' %>>CONDITIONAL</option>
                                                <option value="DROPPED" <%= g.remarks === 'DROPPED' ? 'selected' : '' %>>DROPPED</option>
                                                <option value="ABSENT FROM EXAMINATION" <%= g.remarks === 'ABSENT FROM EXAMINATION' ? 'selected' : '' %>>ABSENT FROM EXAMINATION</option>
                                            </select>
                                        </div>
                                        
                                        <!-- Delete Button Form Reference -->
                                        <button type="submit" form="delete-<%= g.course_code %>" class="px-3 py-2 bg-red-600 hover:bg-red-700 text-white rounded text-xs font-bold shadow" title="Delete Subject">Delete</button>
                                    </div>
                                </div>
                            <% }) %>

                            <!-- SINGLE SAVE ALL BUTTON AT THE BOTTOM -->
                            <div class="pt-4 flex justify-end">
                                <button type="submit" class="px-6 py-3 bg-emerald-700 hover:bg-emerald-800 text-white rounded-xl text-sm font-bold shadow-md transition-colors">
                                    💾 Save All Changes
                                </button>
                            </div>
                        <% } %>
                    </form>

                    <!-- Hidden Delete Forms for Each Row -->
                    <% grades.forEach(g => { %>
                        <form action="/faculty/delete-grade" method="POST" id="delete-<%= g.course_code %>" onsubmit="return confirm('Remove <%= g.course_code %> from this student record?');">
                            <input type="hidden" name="student_id" value="<%= selectedStudent.student_id %>">
                            <input type="hidden" name="course_code" value="<%= g.course_code %>">
                            <input type="hidden" name="term" value="<%= currentTerm %>">
                        </form>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </main>

    <!-- SCRIPT TO CLEAR WORKFLOW CONTAINER ON SEARCH INPUT CLICK -->
    <script>
        document.getElementById('studentSearchInput').addEventListener('click', function() {
            const container = document.getElementById('studentWorkflowContainer');
            if (container) {
                container.innerHTML = `
                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-12 text-center text-slate-400">
                        <p class="text-sm">Search box activated. Enter a Student ID and click Search to load records.</p>
                    </div>
                `;
            }
        });
    </script>
</body>
</html>