<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CONM Faculty Grade Management Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">
    <header class="bg-emerald-900 text-white shadow-md border-b-4 border-pink-500">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div>
                <h2 class="text-base font-bold">College of Nursing and School of Midwifery</h2>
                <p class="text-xs text-pink-300">Faculty Portal</p>
            </div>
            <div class="flex items-center space-x-3">
                <span class="text-xs bg-emerald-800 px-3 py-1.5 rounded-full text-emerald-100 font-medium">
                    <%= currentUser.fullName || currentUser.username %>
                </span>
                <% if (currentUser.role === 'admin') { %>
                    <a href="/admin" class="text-xs bg-amber-500 hover:bg-amber-600 text-white px-3 py-1.5 rounded font-bold">Admin Panel</a>
                <% } %>
                <a href="/registrar" class="text-xs bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1.5 rounded font-medium">Registrar Portal</a>
                <a href="/change-password" class="text-xs bg-slate-700 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">Change Password</a>
                <a href="/logout" class="text-xs bg-pink-600 hover:bg-pink-700 text-white px-3 py-1.5 rounded font-medium">Log Out</a>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-6xl w-full mx-auto p-4 sm:p-6 space-y-6">
        
        <% if (locals.message) { %>
            <div style="background: #d4edda; color: #155724; padding: 12px 20px; border-radius: 6px; border: 1px solid #c3e6cb; font-weight: 500; text-align: center;">
                <%= message %>
            </div>
        <% } %>

        <% if (locals.error) { %>
            <div style="background: #f8d7da; color: #721c24; padding: 12px 20px; border-radius: 6px; border: 1px solid #f5c6cb; font-weight: 500; text-align: center;">
                <%= error %>
            </div>
        <% } %>

        <!-- ACTIVE SYSTEM PERIOD BANNER -->
        <div class="p-4 bg-emerald-100 border border-emerald-300 rounded-xl flex items-center justify-between gap-2 text-emerald-900 shadow-sm">
            <div class="flex items-center gap-2">
                <span class="font-bold text-sm uppercase tracking-wider">Active Grading Period:</span>
                <span class="px-3 py-1 bg-emerald-800 text-emerald-100 rounded-lg text-xs font-bold shadow-sm">
                    <%= systemSettings.current_semester === 1 ? '1st Semester' : '2nd Semester' %> | A.Y. <%= systemSettings.current_ay %>
                </span>
            </div>
            <span class="text-xs text-emerald-800 font-medium">Secure Course-Locked Faculty Portal</span>
        </div>

        <!-- STEP 1 & 2: SELECT SUBJECT & SEARCH STUDENT BY NAME -->
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
            <form method="GET" action="/faculty/edit-grades" class="space-y-4">
                <div>
                    <label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">1. Select Subject Handled / Taught:</label>
                    <select name="course_code" required onchange="this.form.submit()" class="w-full px-3 py-2.5 rounded-lg border border-slate-300 text-sm font-semibold text-emerald-950 bg-slate-50 focus:ring-2 focus:ring-emerald-500">
                        <option value="">-- Select Subject from Your Assigned Teaching Load --</option>
                        <% assignedCourses.forEach(c => { %>
                            <option value="<%= c.course_code %>" <%= selectedCourse === c.course_code ? 'selected' : '' %>>
                                [<%= c.course_code %>] <%= c.descriptive_title %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <% if (selectedCourse) { %>
                    <div class="pt-3 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-3 gap-3 items-end">
                        <div>
                            <label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">2. Student Last Name (Required):</label>
                            <input type="text" name="last_name" value="<%= searchLastName || '' %>" required placeholder="e.g. Santiago" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs bg-slate-50">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">First Name (Optional):</label>
                            <input type="text" name="first_name" value="<%= searchFirstName || '' %>" placeholder="e.g. Darius" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs bg-slate-50">
                        </div>
                        <div class="flex gap-2">
                            <input type="hidden" name="course_code" value="<%= selectedCourse %>">
                            <button type="submit" class="flex-grow py-2 px-4 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-bold shadow transition-colors">
                                Search Student
                            </button>
                            <a href="/faculty/edit-grades" class="px-3 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg text-xs font-bold flex items-center justify-center">
                                Clear
                            </a>
                        </div>
                    </div>
                <% } %>
            </form>
        </div>

        <!-- GRADE ENCODING SECTION -->
        <% if (selectedCourse) { %>
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 space-y-4">
                <div class="border-b border-slate-100 pb-3 flex justify-between items-center">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-900">
                        Encoding Grade For: 
                        <span class="text-pink-600 font-mono">
                            <%= selectedCourse %>
                        </span>
                    </h3>
                </div>

                <% if (!matchingStudent) { %>
                    <% if (searchLastName) { %>
                        <div class="text-center py-8 text-slate-400 text-xs">
                            No student found matching last name "<%= searchLastName %>".
                        </div>
                    <% } else { %>
                        <div class="text-center py-8 text-slate-400 text-xs italic">
                            Please enter the student's name above to search and encode their grade for this subject.
                        </div>
                    <% } %>
                <% } else if (!gradeRecord) { %>
                    <div class="text-center py-8 text-amber-700 text-xs font-medium bg-amber-50 rounded-lg border border-amber-200">
                        Student <strong><%= matchingStudent.last_name %>, <%= matchingStudent.first_name %> (<%= matchingStudent.student_id %>)</strong> is found, but they are <strong>not officially enrolled</strong> in <strong><%= selectedCourse %></strong> for the active Academic Year (<%= systemSettings.current_ay %>).
                    </div>
                <% } else { %>
                    <form action="/faculty/update-grade" method="POST" class="space-y-4">
                        <input type="hidden" name="student_id" value="<%= matchingStudent.student_id %>">
                        <input type="hidden" name="course_code" value="<%= selectedCourse %>">
                        <input type="hidden" name="academic_year" value="<%= systemSettings.current_ay %>">

                        <div class="bg-slate-50 p-4 rounded-lg border border-slate-200 space-y-3 text-sm">
                            <div class="flex justify-between items-center border-b border-slate-200 pb-2">
                                <div>
                                    <span class="text-[10px] uppercase text-slate-400 block font-bold">Student Name & ID</span>
                                    <span class="font-bold text-emerald-950"><%= matchingStudent.last_name %>, <%= matchingStudent.first_name %> <%= matchingStudent.middle_name || '' %> (<%= matchingStudent.student_id %>)</span>
                                </div>
                                <div>
                                    <span class="text-[10px] uppercase text-slate-400 block font-bold">Subject Title</span>
                                    <span class="text-slate-700 text-xs"><%= gradeRecord.descriptive_title %></span>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 items-end pt-1">
                                <div>
                                    <label class="block text-[10px] uppercase text-slate-400 font-bold mb-1">Final Grade</label>
                                    <select name="final_grade" id="gradeSelect" onchange="autoMatchRemark(this)" class="w-full px-3 py-2 rounded border border-slate-300 font-bold text-emerald-700 bg-white text-xs">
                                        <option value="" <%= !gradeRecord.final_grade ? 'selected' : '' %>>-- Select --</option>
                                        <option value="1.00" <%= gradeRecord.final_grade === '1.00' ? 'selected' : '' %>>1.00</option>
                                        <option value="1.25" <%= gradeRecord.final_grade === '1.25' ? 'selected' : '' %>>1.25</option>
                                        <option value="1.50" <%= gradeRecord.final_grade === '1.50' ? 'selected' : '' %>>1.50</option>
                                        <option value="1.75" <%= gradeRecord.final_grade === '1.75' ? 'selected' : '' %>>1.75</option>
                                        <option value="2.00" <%= gradeRecord.final_grade === '2.00' ? 'selected' : '' %>>2.00</option>
                                        <option value="2.25" <%= gradeRecord.final_grade === '2.25' ? 'selected' : '' %>>2.25</option>
                                        <option value="2.50" <%= gradeRecord.final_grade === '2.50' ? 'selected' : '' %>>2.50</option>
                                        <option value="2.75" <%= gradeRecord.final_grade === '2.75' ? 'selected' : '' %>>2.75</option>
                                        <option value="3.00" <%= gradeRecord.final_grade === '3.00' ? 'selected' : '' %>>3.00</option>
                                        <option value="4.00" <%= gradeRecord.final_grade === '4.00' ? 'selected' : '' %>>4.00</option>
                                        <option value="5.00" <%= gradeRecord.final_grade === '5.00' ? 'selected' : '' %>>5.00</option>
                                        <option value="X" <%= gradeRecord.final_grade === 'X' ? 'selected' : '' %>>X</option>
                                        <option value="INC" <%= gradeRecord.final_grade === 'INC' ? 'selected' : '' %>>INC</option>
                                        <option value="W" <%= gradeRecord.final_grade === 'W' ? 'selected' : '' %>>W</option>
                                        <option value="NG" <%= gradeRecord.final_grade === 'NG' ? 'selected' : '' %>>NG</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-[10px] uppercase text-slate-400 font-bold mb-1">Instructor</label>
                                    <input type="text" name="instructor" value="<%= gradeRecord.instructor || currentUser.fullName || currentUser.username %>" class="w-full px-3 py-2 rounded border border-slate-300 text-xs bg-white">
                                </div>
                                <div>
                                    <label class="block text-[10px] uppercase text-slate-400 font-bold mb-1">Remarks</label>
                                    <select name="remarks" id="remarkSelect" class="w-full px-3 py-2 rounded border border-slate-300 text-xs bg-white font-medium">
                                        <option value="" <%= !gradeRecord.remarks ? 'selected' : '' %>>-- Select --</option>
                                        <option value="PASSED" <%= gradeRecord.remarks === 'PASSED' ? 'selected' : '' %>>PASSED</option>
                                        <option value="FAILED" <%= gradeRecord.remarks === 'FAILED' ? 'selected' : '' %>>FAILED</option>
                                        <option value="INCOMPLETE" <%= gradeRecord.remarks === 'INCOMPLETE' ? 'selected' : '' %>>INCOMPLETE</option>
                                        <option value="CONDITIONAL" <%= gradeRecord.remarks === 'CONDITIONAL' ? 'selected' : '' %>>CONDITIONAL</option>
                                        <option value="DROPPED" <%= gradeRecord.remarks === 'DROPPED' ? 'selected' : '' %>>DROPPED</option>
                                        <option value="ABSENT FROM EXAMINATION" <%= gradeRecord.remarks === 'ABSENT FROM EXAMINATION' ? 'selected' : '' %>>ABSENT FROM EXAMINATION</option>
                                        <option value="NO GRADE" <%= gradeRecord.remarks === 'NO GRADE' ? 'selected' : '' %>>NO GRADE</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="pt-2 flex justify-end gap-3">
                            <button type="submit" class="px-6 py-3 bg-emerald-700 hover:bg-emerald-800 text-white rounded-xl text-sm font-bold shadow-md transition-colors">
                                💾 Save Grade
                            </button>
                        </div>
                    </form>
                <% } %>
            </div>
        <% } %>
    </main>

    <script>
        function autoMatchRemark(selectElement) {
            const grade = selectElement.value;
            const remarkSelect = document.getElementById('remarkSelect');
            if (!remarkSelect) return;

            const passedGrades = ['1.00', '1.25', '1.50', '1.75', '2.00', '2.25', '2.50', '2.75', '3.00'];

            if (passedGrades.includes(grade)) {
                remarkSelect.value = 'PASSED';
            } else if (grade === '4.00') {
                remarkSelect.value = 'CONDITIONAL';
            } else if (grade === '5.00') {
                remarkSelect.value = 'FAILED';
            } else if (grade === 'X') {
                remarkSelect.value = 'DROPPED';
            } else if (grade === 'INC') {
                remarkSelect.value = 'INCOMPLETE';
            } else if (grade === 'W') {
                remarkSelect.value = 'ABSENT FROM EXAMINATION';
            } else if (grade === 'NG') {
                remarkSelect.value = 'NO GRADE';
            } else {
                remarkSelect.value = '';
            }
        }
    </script>
</body>
</html>