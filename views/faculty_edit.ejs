<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CONM Faculty Grade Management Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">
    <header class="bg-emerald-900 text-white shadow-md border-b-4 border-pink-500">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div>
                <h2 class="text-base font-bold">College of Nursing and School of Midwifery</h2>
                <p class="text-xs text-pink-300">Faculty Grade Sheet Portal</p>
            </div>
            <div class="flex items-center space-x-3">
                <span class="text-xs bg-emerald-800 px-3 py-1.5 rounded-full text-emerald-100 font-medium">
                    <%= currentUser.fullName || currentUser.username %>
                </span>
                <% if (currentUser.role === 'admin') { %>
                    <a href="/admin" class="text-xs bg-amber-500 hover:bg-amber-600 text-white px-3 py-1.5 rounded font-bold">Admin Panel</a>
                    <a href="/registrar" class="text-xs bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1.5 rounded font-medium">Registrar Portal</a>
                <% } %>
                <a href="/change-password" class="text-xs bg-slate-700 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">Change Password</a>
                <form action="/logout" method="POST" class="inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="text-xs bg-pink-600 hover:bg-pink-700 text-white px-3 py-1.5 rounded font-medium cursor-pointer">Log Out</button>
                </form>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-6xl w-full mx-auto p-4 sm:p-6 space-y-6">
        
        <% if (locals.message) { %>
            <div class="p-4 bg-emerald-100 border border-emerald-400 text-emerald-800 text-xs font-bold rounded-xl shadow-sm text-center">
                ✅ <%= message %>
            </div>
        <% } %>

        <% if (locals.error) { %>
            <div class="p-4 bg-red-100 border border-red-400 text-red-700 text-xs font-bold rounded-xl shadow-sm text-center">
                ⚠️ <%= error %>
            </div>
        <% } %>

        <!-- ACTIVE SYSTEM PERIOD BANNER -->
        <div class="p-4 bg-emerald-100 border border-emerald-300 rounded-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-emerald-900 shadow-sm">
            <div class="flex items-center gap-2">
                <span class="font-bold text-sm uppercase tracking-wider">Active Grading Period:</span>
                <span class="px-3 py-1 bg-emerald-800 text-emerald-100 rounded-lg text-xs font-bold shadow-sm">
                    <%= systemSettings.current_semester === 1 ? '1st Semester' : '2nd Semester' %> | A.Y. <%= systemSettings.current_ay %>
                </span>
            </div>
            <span class="text-xs text-emerald-800 font-medium">Class Roster Spreadsheet Mode</span>
        </div>

        <!-- FILTER BAR: SUBJECT, YEAR LEVEL (BSN1-BSN4), AND SECTION (A, B, C) -->
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
            <form method="GET" action="/faculty/edit-grades" class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-end">
                <div class="sm:col-span-6">
                    <label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">1. Select Subject Handled</label>
                    <select name="course_code" id="courseSelect" required class="w-full px-3 py-2.5 rounded-lg border border-slate-300 text-xs sm:text-sm font-semibold text-emerald-950 bg-slate-50 focus:ring-2 focus:ring-emerald-500 cursor-pointer">
                        <option value="" style="font-style: italic;">-- Select Assigned Subject --</option>
                        <% assignedCourses.forEach(c => { 
                            const courseYear = Math.ceil(Number(c.term_id || 1) / 2);
                        %>
                            <option value="<%= c.course_code %>" data-year="<%= courseYear %>" <%= selectedCourse === c.course_code ? 'selected' : '' %>>
                                [<%= c.course_code %>] <%= c.descriptive_title %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="sm:col-span-2">
                    <label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">2. Year Level</label>
                    <select name="year_level" id="yearLevelSelect" required class="w-full px-3 py-2.5 rounded-lg border border-slate-300 text-xs sm:text-sm font-bold text-emerald-900 bg-slate-50 focus:ring-2 focus:ring-emerald-500 cursor-pointer">
                        <option value="">-- Year --</option>
                        <option value="1" <%= selectedYearLevel === '1' ? 'selected' : '' %>>BSN1</option>
                        <option value="2" <%= selectedYearLevel === '2' ? 'selected' : '' %>>BSN2</option>
                        <option value="3" <%= selectedYearLevel === '3' ? 'selected' : '' %>>BSN3</option>
                        <option value="4" <%= selectedYearLevel === '4' ? 'selected' : '' %>>BSN4</option>
                    </select>
                </div>

                <div class="sm:col-span-2">
                    <label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">3. Section</label>
                    <select name="section" required class="w-full px-3 py-2.5 rounded-lg border border-slate-300 text-xs sm:text-sm font-bold text-emerald-900 bg-slate-50 focus:ring-2 focus:ring-emerald-500 cursor-pointer">
                        <option value="">-- Section --</option>
                        <option value="A" <%= selectedSection === 'A' ? 'selected' : '' %>>A</option>
                        <option value="B" <%= selectedSection === 'B' ? 'selected' : '' %>>B</option>
                        <option value="C" <%= selectedSection === 'C' ? 'selected' : '' %>>C</option>
                    </select>
                </div>

                <div class="sm:col-span-2 flex gap-2">
                    <button type="submit" class="w-full py-2.5 px-4 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-bold shadow transition-colors whitespace-nowrap cursor-pointer">
                        📋 Load Sheet
                    </button>
                </div>
            </form>
        </div>

        <!-- EXCEL-STYLE GRADE SHEET SECTION -->
        <% if (selectedCourse && selectedYearLevel && selectedSection) { %>
            <div class="bg-white rounded-xl shadow-sm border border-slate-300 overflow-hidden">
                <div class="bg-emerald-950 text-white px-5 py-3.5 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-emerald-800">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="px-2.5 py-0.5 bg-pink-600 text-white font-mono font-bold text-xs rounded"><%= selectedCourse %></span>
                            <span class="px-2.5 py-0.5 bg-emerald-800 text-emerald-100 font-bold text-xs rounded">BSN<%= selectedYearLevel %> - <%= selectedSection %></span>
                        </div>
                        <p class="text-xs text-emerald-200 mt-1 font-medium">
                            <%= selectedCourseDetails ? selectedCourseDetails.descriptive_title : '' %>
                        </p>
                    </div>
                    <div class="text-right">
                        <span class="text-xs bg-emerald-900 border border-emerald-700 px-3 py-1.5 rounded-lg font-bold text-emerald-100">
                            Total Students Enrolled: <%= enrolledStudents.length %>
                        </span>
                    </div>
                </div>

                <% if (enrolledStudents.length === 0) { %>
                    <div class="text-center py-12 px-4 text-slate-500 space-y-1">
                        <p class="text-sm font-bold text-slate-600">No students found in this class roster.</p>
                        <p class="text-xs text-slate-400">
                            No students in <strong>BSN<%= selectedYearLevel %> - <%= selectedSection %></strong> are currently enrolled in <strong><%= selectedCourse %></strong> for the active grading period (<%= systemSettings.current_semester === 1 ? '1st Semester' : '2nd Semester' %>, A.Y. <%= systemSettings.current_ay %>).
                        </p>
                    </div>
                <% } else { %>
                    <form action="/faculty/update-grades-sheet" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="course_code" value="<%= selectedCourse %>">
                        <input type="hidden" name="year_level" value="<%= selectedYearLevel %>">
                        <input type="hidden" name="section" value="<%= selectedSection %>">

                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse text-xs">
                                <thead>
                                    <tr class="bg-slate-200 text-slate-700 border-b-2 border-slate-400 uppercase text-[10px] font-bold tracking-wider">
                                        <th class="py-2.5 px-3 border-r border-slate-300 text-center w-10">#</th>
                                        <th class="py-2.5 px-3 border-r border-slate-300 w-32">Student ID</th>
                                        <th class="py-2.5 px-3 border-r border-slate-300">Student Name (Last, First Middle)</th>
                                        <th class="py-2.5 px-3 border-r border-slate-300 text-center w-24">Class</th>
                                        <th class="py-2.5 px-2 border-r border-slate-300 w-36 text-center bg-emerald-100/70 text-emerald-950">Final Grade</th>
                                        <th class="py-2.5 px-2 border-r border-slate-300 w-52 text-center">Remarks (Auto)</th>
                                        <th class="py-2.5 px-2 w-56">Clinical Instructor</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-300">
                                    <% enrolledStudents.forEach((stu, idx) => { %>
                                        <tr class="hover:bg-emerald-50/40 transition-colors odd:bg-white even:bg-slate-50/60">
                                            <td class="py-2 px-3 border-r border-slate-300 text-center font-mono text-slate-400 font-bold">
                                                <%= idx + 1 %>
                                                <input type="hidden" name="student_ids" value="<%= stu.student_id %>">
                                            </td>
                                            <td class="py-2 px-3 border-r border-slate-300 font-mono font-bold text-emerald-950 whitespace-nowrap">
                                                <%= stu.student_id %>
                                            </td>
                                            <td class="py-2 px-3 border-r border-slate-300 font-bold text-slate-800 uppercase">
                                                <%= stu.last_name %>, <%= stu.first_name %> <%= stu.middle_name || '' %>
                                            </td>
                                            <td class="py-2 px-3 border-r border-slate-300 text-center font-bold text-indigo-800 whitespace-nowrap">
                                                BSN<%= stu.year_level %> - <%= stu.section %>
                                            </td>
                                            <td class="p-1.5 border-r border-slate-300 bg-emerald-50/30">
                                                <select name="final_grades" data-index="<%= idx %>" class="faculty-grade-select w-full px-2 py-1.5 rounded border border-slate-300 font-bold text-emerald-800 bg-white text-xs focus:ring-2 focus:ring-emerald-500 cursor-pointer">
                                                    <option value="" <%= !stu.final_grade ? 'selected' : '' %>>-- Grade --</option>
                                                    <option value="1.00" <%= stu.final_grade === '1.00' ? 'selected' : '' %>>1.00</option>
                                                    <option value="1.25" <%= stu.final_grade === '1.25' ? 'selected' : '' %>>1.25</option>
                                                    <option value="1.50" <%= stu.final_grade === '1.50' ? 'selected' : '' %>>1.50</option>
                                                    <option value="1.75" <%= stu.final_grade === '1.75' ? 'selected' : '' %>>1.75</option>
                                                    <option value="2.00" <%= stu.final_grade === '2.00' ? 'selected' : '' %>>2.00</option>
                                                    <option value="2.25" <%= stu.final_grade === '2.25' ? 'selected' : '' %>>2.25</option>
                                                    <option value="2.50" <%= stu.final_grade === '2.50' ? 'selected' : '' %>>2.50</option>
                                                    <option value="2.75" <%= stu.final_grade === '2.75' ? 'selected' : '' %>>2.75</option>
                                                    <option value="3.00" <%= stu.final_grade === '3.00' ? 'selected' : '' %>>3.00</option>
                                                    <option value="4.00" <%= stu.final_grade === '4.00' ? 'selected' : '' %>>4.00</option>
                                                    <option value="5.00" <%= stu.final_grade === '5.00' ? 'selected' : '' %>>5.00</option>
                                                    <option value="X" <%= stu.final_grade === 'X' ? 'selected' : '' %>>X</option>
                                                    <option value="INC" <%= stu.final_grade === 'INC' ? 'selected' : '' %>>INC</option>
                                                    <option value="W" <%= stu.final_grade === 'W' ? 'selected' : '' %>>W</option>
                                                    <option value="NG" <%= stu.final_grade === 'NG' ? 'selected' : '' %>>NG</option>
                                                </select>
                                            </td>
                                            <td class="p-1.5 border-r border-slate-300">
                                                <input type="text" id="remark_row_<%= idx %>" value="<%= stu.remarks || '' %>" readonly class="w-full px-2 py-1.5 rounded border border-slate-200 text-xs bg-slate-100 font-bold text-center text-slate-700">
                                            </td>
                                            <td class="p-1.5">
                                                <input type="text" value="<%= stu.instructor || facultyFullName %>" readonly class="w-full px-2.5 py-1.5 rounded border border-slate-200 text-xs bg-slate-100 font-medium text-slate-600">
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <div class="bg-slate-100 px-5 py-4 border-t border-slate-300 flex flex-col sm:flex-row justify-between items-center gap-3">
                            <span class="text-xs text-slate-500">
                                💡 <strong>Note:</strong> Remarks are automatically computed and verified by the server based on the selected Final Grade.
                            </span>
                            <button type="submit" class="w-full sm:w-auto px-8 py-3 bg-emerald-700 hover:bg-emerald-800 text-white rounded-xl text-xs sm:text-sm font-bold shadow-md transition-colors cursor-pointer">
                                💾 Save All Grades for BSN<%= selectedYearLevel %> - <%= selectedSection %>
                            </button>
                        </div>
                    </form>
                <% } %>
            </div>
        <% } else { %>
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-10 text-center text-slate-400 text-xs italic">
                Select your <strong>Subject Handled</strong>, <strong>Year Level (BSN1–BSN4)</strong>, and <strong>Section (A, B, or C)</strong> above, then click <strong>"📋 Load Sheet"</strong> to open the class grade sheet.
            </div>
        <% } %>
    </main>

    <script nonce="<%= cspNonce %>">
        document.addEventListener('DOMContentLoaded', () => {
            const courseSelect = document.getElementById('courseSelect');
            const yearSelect = document.getElementById('yearLevelSelect');
            if (courseSelect && yearSelect) {
                courseSelect.addEventListener('change', () => {
                    const selectedOpt = courseSelect.options[courseSelect.selectedIndex];
                    const suggestedYear = selectedOpt ? selectedOpt.getAttribute('data-year') : '';
                    if (suggestedYear) {
                        yearSelect.value = suggestedYear;
                    }
                });
            }

            document.querySelectorAll('.faculty-grade-select').forEach(sel => {
                sel.addEventListener('change', () => {
                    autoMatchRowRemark(sel, sel.getAttribute('data-index'));
                });
            });
        });

        function autoMatchRowRemark(selectElement, rowIndex) {
            const grade = selectElement.value;
            const remarkInput = document.getElementById('remark_row_' + rowIndex);
            if (!remarkInput) return;

            const passedGrades = ['1.00', '1.25', '1.50', '1.75', '2.00', '2.25', '2.50', '2.75', '3.00'];

            if (passedGrades.includes(grade)) remarkInput.value = 'PASSED';
            else if (grade === '4.00') remarkInput.value = 'CONDITIONAL';
            else if (grade === '5.00') remarkInput.value = 'FAILED';
            else if (grade === 'X') remarkInput.value = 'DROPPED';
            else if (grade === 'INC') remarkInput.value = 'INCOMPLETE';
            else if (grade === 'W') remarkInput.value = 'WITHDRAWN';
            else if (grade === 'NG') remarkInput.value = 'NO GRADE';
            else remarkInput.value = '';
        }
    </script>
</body>
</html>